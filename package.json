{
  "name": "digvation-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "qa": "npm run lint && npm run check && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:pages": "npx wrangler@latest pages dev ./dist",
    "deploy:pages": "npm run build && npx wrangler@latest pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "eslint": "9.34.0",
    "eslint-plugin-astro": "1.3.1",
    "prettier": "3.9.0",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4",
    "@eslint/js": "9.34.0"
  }
}
