---
type Kind = 'customer' | 'operations' | 'data';
type Props = { kind: Kind; locale: 'id' | 'en' };

const { kind, locale } = Astro.props;

const copy =
  locale === 'id'
    ? {
        label: 'Contoh kondisi bisnis',
        customer: {
          aria: 'Contoh calon customer yang meninggalkan website karena nilai bisnis belum jelas',
          brand: 'Bisnis Anda',
          nav: ['Layanan', 'Tentang', 'Kontak'],
          headline: 'Solusi lengkap untuk kebutuhan Anda.',
          body: 'Kami menyediakan layanan terbaik dengan tim yang berpengalaman.',
          cta: 'Hubungi kami',
          thought: 'Apa bedanya dengan yang lain?',
          trail: ['Datang', 'Membaca', 'Masih ragu', 'Pergi'],
        },
        operations: {
          aria: 'Contoh order, spreadsheet, dan approval yang tersebar di beberapa tempat',
          chatTitle: '# order-baru',
          messages: [
            'Order R-184 sudah dicek?',
            'File terakhir yang mana?',
            'Approval-nya sudah masuk?',
          ],
          sheetTitle: 'ORDER_TRACKING_FINAL_4.xlsx',
          sheetHead: ['Order', 'Status', 'PIC'],
          sheetRows: [
            ['R-184', 'Menunggu', '?'],
            ['R-185', 'Diproses', 'Dina'],
            ['R-186', 'Cek ulang', 'Raka'],
          ],
          approval: 'Approval request',
          revision: 'Revisi 04',
          waiting: 'Menunggu keputusan',
          question: 'Status terakhir ada di mana?',
        },
        data: {
          aria: 'Contoh data penjualan, stok, dan operasional yang masih menunggu rekap manual',
          sources: ['Penjualan', 'Stok', 'Operasional'],
          sheet: 'REKAP_MINGGUAN.xlsx',
          columns: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum'],
          report: 'Ringkasan manajemen',
          progress: 'Menggabungkan 3 sumber data',
          updated: 'Update terakhir 2 jam lalu',
          blocker: 'Keputusan masih menunggu rekap',
        },
      }
    : {
        label: 'Example business situation',
        customer: {
          aria: 'Example of a potential customer leaving because the business value is unclear',
          brand: 'Your Business',
          nav: ['Services', 'About', 'Contact'],
          headline: 'Complete solutions for your needs.',
          body: 'We provide the best services with an experienced team.',
          cta: 'Contact us',
          thought: 'How is this different from the rest?',
          trail: ['Arrives', 'Reads', 'Still unsure', 'Leaves'],
        },
        operations: {
          aria: 'Example of orders, spreadsheets, and approvals scattered across several places',
          chatTitle: '# new-orders',
          messages: [
            'Has order R-184 been checked?',
            'Which file is the latest?',
            'Has the approval arrived?',
          ],
          sheetTitle: 'ORDER_TRACKING_FINAL_4.xlsx',
          sheetHead: ['Order', 'Status', 'Owner'],
          sheetRows: [
            ['R-184', 'Waiting', '?'],
            ['R-185', 'Processing', 'Dina'],
            ['R-186', 'Recheck', 'Raka'],
          ],
          approval: 'Approval request',
          revision: 'Revision 04',
          waiting: 'Waiting for decision',
          question: 'Where is the latest status?',
        },
        data: {
          aria: 'Example of sales, stock, and operations data waiting for a manual recap',
          sources: ['Sales', 'Stock', 'Operations'],
          sheet: 'WEEKLY_RECAP.xlsx',
          columns: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
          report: 'Management summary',
          progress: 'Combining 3 data sources',
          updated: 'Last updated 2 hours ago',
          blocker: 'The decision is still waiting for the recap',
        },
      };

const scene = copy[kind];
---

<figure
  class:list={['problem-scene', `problem-scene--${kind}`]}
  role="img"
  aria-label={scene.aria}
  data-reveal="scale"
>
  <figcaption class="problem-scene__caption">
    <span>{copy.label}</span>
  </figcaption>

  {
    kind === 'customer' && (
      <div class="customer-stage">
        <div class="browser-card">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true">
              <>
                <i />
                <i />
                <i />
              </>
            </span>
            <span class="window-address">business.example</span>
          </div>
          <div class="website-nav">
            <strong>{copy.customer.brand}</strong>
            <span>{copy.customer.nav.join('   ')}</span>
          </div>
          <div class="website-body">
            <small>WELCOME</small>
            <h4>{copy.customer.headline}</h4>
            <p>{copy.customer.body}</p>
            <button type="button" tabindex="-1">
              {copy.customer.cta}
            </button>
            <div class="website-placeholder" aria-hidden="true">
              <>
                <span />
                <span />
                <span />
              </>
            </div>
          </div>
        </div>

        <div class="customer-pointer" aria-hidden="true">
          ↖
        </div>
        <div class="customer-thought">
          <span>?</span>
          <p>{copy.customer.thought}</p>
        </div>

        <ol class="visitor-trail">
          {copy.customer.trail.map((step, index) => (
            <li class:list={[index === copy.customer.trail.length - 1 && 'is-exit']}>
              <i>{index + 1}</i>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    )
  }

  {
    kind === 'operations' && (
      <div class="operations-stage">
        <section class="chat-window">
          <header>
            <>
              <span>#</span>
              <strong>{copy.operations.chatTitle}</strong>
              <i>•••</i>
            </>
          </header>
          <div class="chat-list">
            {copy.operations.messages.map((message, index) => (
              <div>
                <span class={`avatar avatar--${index + 1}`}>{['D', 'R', 'A'][index]}</span>
                <p>
                  <b>{['Dina', 'Raka', 'Ari'][index]}</b>
                  {message}
                </p>
              </div>
            ))}
          </div>
        </section>

        <section class="sheet-window">
          <header>
            <>
              <span>▦</span>
              <strong>{copy.operations.sheetTitle}</strong>
            </>
          </header>
          <div class="sheet-grid">
            {copy.operations.sheetHead.map((cell) => (
              <b>{cell}</b>
            ))}
            {copy.operations.sheetRows.flatMap((row) => row.map((cell) => <span>{cell}</span>))}
          </div>
          <div class="sheet-tabs">
            <>
              <b>Order</b>
              <span>Archive</span>
              <i>+</i>
            </>
          </div>
        </section>

        <section class="approval-window">
          <div>
            <>
              <span>DV</span>
              <i>•••</i>
            </>
          </div>
          <small>{copy.operations.approval}</small>
          <strong>R-184 / Rp 12.850.000</strong>
          <p>{copy.operations.revision}</p>
          <em>{copy.operations.waiting}</em>
        </section>

        <p class="operations-question">
          <span>?</span>
          {copy.operations.question}
        </p>
        <svg class="operations-lines" viewBox="0 0 640 350" aria-hidden="true">
          <path d="M190 78 C275 35 320 70 390 130" />
          <path d="M290 260 C370 238 405 235 475 220" />
          <path d="M185 126 C235 175 220 220 285 248" />
        </svg>
      </div>
    )
  }

  {
    kind === 'data' && (
      <div class="data-stage">
        <div class="data-sources">
          {copy.data.sources.map((source, index) => (
            <span>
              <i>{['↗', '▦', '◎'][index]}</i>
              {source}
            </span>
          ))}
        </div>

        <section class="data-sheet">
          <header>
            <>
              <span>▦</span>
              <strong>{copy.data.sheet}</strong>
              <i>•••</i>
            </>
          </header>
          <div class="data-sheet__grid">
            {copy.data.columns.map((column) => (
              <b>{column}</b>
            ))}
            {Array.from({ length: 20 }, (_, index) => (
              <span class:list={[index > 13 && 'is-empty']} />
            ))}
          </div>
        </section>

        <section class="report-window">
          <header>
            <>
              <span>REPORT</span>
              <i>{copy.data.updated}</i>
            </>
          </header>
          <h4>{copy.data.report}</h4>
          <div class="report-progress">
            <i />
          </div>
          <p>
            <span class="spinner" aria-hidden="true" />
            {copy.data.progress}
          </p>
          <div class="report-lines">
            <>
              <span />
              <span />
              <span />
            </>
          </div>
        </section>

        <div class="decision-blocker">
          <span>!</span>
          <p>{copy.data.blocker}</p>
        </div>

        <svg class="data-lines" viewBox="0 0 640 350" aria-hidden="true">
          <path d="M82 72 C150 92 160 145 230 160" />
          <path d="M180 42 C250 70 245 112 300 138" />
          <path d="M286 68 C340 88 355 100 388 142" />
        </svg>
      </div>
    )
  }
</figure>

<style>
  .problem-scene {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    min-height: 34rem;
    margin: 0;
    overflow: hidden;
    background: #e9ecf3;
    color: #11151c;
  }
  .problem-scene__caption {
    display: flex;
    min-height: 2.85rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(18, 26, 47, 0.12);
    background: rgba(255, 255, 255, 0.86);
    color: rgba(18, 26, 47, 0.48);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .customer-stage,
  .operations-stage,
  .data-stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }
  .customer-stage {
    background:
      radial-gradient(circle at 80% 18%, rgba(147, 166, 255, 0.3), transparent 30%),
      linear-gradient(145deg, #dfe4f2, #f4f5f8 58%, #d9deee);
  }
  .browser-card {
    position: absolute;
    top: 8%;
    right: 11%;
    bottom: 22%;
    left: 8%;
    overflow: hidden;
    border: 1px solid rgba(18, 26, 47, 0.2);
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 24px 60px rgba(18, 26, 47, 0.16);
    transform: rotate(-1.1deg);
  }
  .window-bar {
    display: flex;
    height: 2.1rem;
    align-items: center;
    gap: 1rem;
    padding: 0 0.75rem;
    border-bottom: 1px solid #e5e7eb;
    background: #f7f8fa;
  }
  .window-dots {
    display: flex;
    gap: 0.3rem;
  }
  .window-dots i {
    width: 0.43rem;
    height: 0.43rem;
    border-radius: 50%;
    background: #c8ccd3;
  }
  .window-address {
    min-width: 8rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid #e1e4e8;
    border-radius: 0.25rem;
    background: #fff;
    color: #969ca5;
    font-size: 0.48rem;
    text-align: center;
  }
  .website-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem 0;
  }
  .website-nav strong {
    font-family: var(--font-display);
    font-size: 0.72rem;
  }
  .website-nav span {
    color: #777e88;
    font-size: 0.48rem;
    word-spacing: 0.65rem;
  }
  .website-body {
    width: 70%;
    padding: 2.4rem 1.2rem 1rem;
  }
  .website-body small {
    color: #5367ee;
    font-size: 0.45rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }
  .website-body h4 {
    max-width: 12ch;
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 2.1rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .website-body p {
    max-width: 27rem;
    margin: 0.8rem 0 0;
    color: #828892;
    font-size: 0.57rem;
    line-height: 1.6;
  }
  .website-body button {
    margin-top: 1rem;
    border: 0;
    border-radius: 0.22rem;
    padding: 0.55rem 0.85rem;
    background: #121a2f;
    color: #fff;
    font-size: 0.52rem;
    font-weight: 750;
  }
  .website-placeholder {
    display: flex;
    gap: 0.35rem;
    margin-top: 1.2rem;
  }
  .website-placeholder span {
    width: 2.7rem;
    height: 1.5rem;
    background: #eceef1;
  }
  .customer-pointer {
    position: absolute;
    right: 31%;
    bottom: 31%;
    color: #121a2f;
    font-size: 1.6rem;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.18));
    transform: rotate(-18deg);
  }
  .customer-thought {
    position: absolute;
    top: 19%;
    right: 2.5%;
    width: min(36%, 12rem);
    padding: 0.85rem;
    border: 1px solid #121a2f;
    background: #fff;
    box-shadow: 5px 6px 0 rgba(18, 26, 47, 0.16);
    transform: rotate(2deg);
  }
  .customer-thought > span {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border-radius: 50%;
    background: #121a2f;
    color: white;
    font-size: 0.68rem;
    font-weight: 850;
  }
  .customer-thought p {
    margin: 0.7rem 0 0;
    font-family: var(--font-hand);
    font-size: clamp(0.9rem, 1.45vw, 1.18rem);
    line-height: 1.05;
  }
  .visitor-trail {
    position: absolute;
    right: 4%;
    bottom: 4%;
    left: 4%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .visitor-trail::before {
    position: absolute;
    top: 0.65rem;
    right: 9%;
    left: 9%;
    border-top: 1px dashed rgba(18, 26, 47, 0.35);
    content: '';
  }
  .visitor-trail li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    color: rgba(18, 26, 47, 0.58);
    font-size: 0.5rem;
    font-weight: 750;
  }
  .visitor-trail i {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border: 1px solid #8992a2;
    border-radius: 50%;
    background: #f7f8fa;
    font-style: normal;
  }
  .visitor-trail .is-exit i {
    border-color: #b65b5b;
    background: #fff1f1;
    color: #a14141;
  }
  .operations-stage {
    background-color: #e6e8ed;
    background-image:
      linear-gradient(rgba(18, 26, 47, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(18, 26, 47, 0.055) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .chat-window,
  .sheet-window,
  .approval-window {
    position: absolute;
    z-index: 2;
    overflow: hidden;
    border: 1px solid rgba(18, 26, 47, 0.2);
    border-radius: 0.45rem;
    background: #fff;
    box-shadow: 0 18px 45px rgba(18, 26, 47, 0.14);
  }
  .chat-window {
    top: 8%;
    left: 5%;
    width: 47%;
    transform: rotate(-2deg);
  }
  .chat-window header,
  .sheet-window header {
    display: flex;
    min-height: 2.35rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid #e4e7eb;
    background: #f8f9fb;
    font-size: 0.55rem;
  }
  .chat-window header > span {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border-radius: 0.25rem;
    background: #5367ee;
    color: white;
  }
  .chat-window header i,
  .sheet-window header i {
    margin-left: auto;
    color: #9ca1aa;
    font-style: normal;
  }
  .chat-list {
    display: grid;
    gap: 0.7rem;
    padding: 0.8rem;
  }
  .chat-list > div {
    display: flex;
    gap: 0.55rem;
  }
  .avatar {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: #e3e7ff;
    color: #4458d0;
    font-size: 0.48rem;
    font-weight: 850;
  }
  .avatar--2 {
    background: #e4eee8;
    color: #34704e;
  }
  .avatar--3 {
    background: #f2e7df;
    color: #8c5838;
  }
  .chat-list p {
    margin: 0;
    color: #626974;
    font-size: 0.52rem;
    line-height: 1.45;
  }
  .chat-list b {
    display: block;
    margin-bottom: 0.1rem;
    color: #171b22;
    font-size: 0.5rem;
  }
  .sheet-window {
    right: 4%;
    bottom: 7%;
    width: 55%;
    transform: rotate(1.2deg);
  }
  .sheet-window header > span {
    color: #2c8b56;
    font-size: 0.85rem;
  }
  .sheet-grid {
    display: grid;
    grid-template-columns: 0.7fr 1.15fr 0.8fr;
    font-size: 0.49rem;
  }
  .sheet-grid > * {
    min-width: 0;
    padding: 0.58rem 0.65rem;
    border-right: 1px solid #e5e8eb;
    border-bottom: 1px solid #e5e8eb;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sheet-grid b {
    background: #edf4ef;
    color: #45624e;
  }
  .sheet-grid span:nth-of-type(1),
  .sheet-grid span:nth-of-type(2),
  .sheet-grid span:nth-of-type(3) {
    background: #fff5dc;
  }
  .sheet-tabs {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    background: #f6f8f7;
    color: #858b92;
    font-size: 0.47rem;
  }
  .sheet-tabs b {
    color: #2f7b4d;
  }
  .approval-window {
    top: 14%;
    right: 3%;
    width: 34%;
    padding: 0.9rem;
    transform: rotate(2.5deg);
  }
  .approval-window > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .approval-window > div span {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border-radius: 0.3rem;
    background: #121a2f;
    color: white;
    font-size: 0.48rem;
    font-weight: 850;
  }
  .approval-window > div i {
    color: #9da2a9;
    font-style: normal;
  }
  .approval-window small {
    display: block;
    margin-top: 0.85rem;
    color: #8d939b;
    font-size: 0.48rem;
  }
  .approval-window strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.65rem;
  }
  .approval-window p {
    margin: 0.6rem 0;
    color: #757b84;
    font-size: 0.48rem;
  }
  .approval-window em {
    display: inline-flex;
    padding: 0.35rem 0.5rem;
    border-radius: 999px;
    background: #fff3d9;
    color: #93651e;
    font-size: 0.46rem;
    font-style: normal;
    font-weight: 750;
  }
  .operations-question {
    position: absolute;
    bottom: 5%;
    left: 5%;
    z-index: 3;
    display: flex;
    max-width: 12rem;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(0.95rem, 1.5vw, 1.2rem);
    line-height: 1;
    transform: rotate(-2deg);
  }
  .operations-question span {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: #121a2f;
    color: white;
    font-family: var(--font-sans);
    font-size: 0.68rem;
  }
  .operations-lines,
  .data-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .operations-lines path,
  .data-lines path {
    fill: none;
    stroke: rgba(83, 103, 238, 0.48);
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
  }
  .data-stage {
    background:
      radial-gradient(circle at 22% 10%, rgba(147, 166, 255, 0.22), transparent 28%), #e7eaf0;
  }
  .data-sources {
    position: absolute;
    top: 5%;
    right: 5%;
    left: 5%;
    z-index: 3;
    display: flex;
    gap: 0.5rem;
  }
  .data-sources span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid rgba(18, 26, 47, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    color: #606773;
    font-size: 0.48rem;
    font-weight: 750;
    box-shadow: 0 8px 20px rgba(18, 26, 47, 0.08);
  }
  .data-sources i {
    color: #5367ee;
    font-style: normal;
  }
  .data-sheet {
    position: absolute;
    top: 18%;
    left: 4%;
    width: 63%;
    overflow: hidden;
    border: 1px solid rgba(18, 26, 47, 0.17);
    border-radius: 0.45rem;
    background: #fff;
    box-shadow: 0 20px 50px rgba(18, 26, 47, 0.13);
    transform: rotate(-1.5deg);
  }
  .data-sheet header {
    display: flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid #e3e6e9;
    background: #f7f9f8;
    font-size: 0.52rem;
  }
  .data-sheet header > span {
    color: #2c8b56;
    font-size: 0.8rem;
  }
  .data-sheet header i {
    margin-left: auto;
    color: #a0a5ac;
    font-style: normal;
  }
  .data-sheet__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .data-sheet__grid > * {
    min-height: 1.65rem;
    border-right: 1px solid #e5e8eb;
    border-bottom: 1px solid #e5e8eb;
  }
