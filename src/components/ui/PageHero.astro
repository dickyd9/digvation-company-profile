---
import HandwrittenNote from '@/components/ui/HandwrittenNote.astro';

type Props = {
  eyebrow: string;
  title: string;
  body?: string;
  note?: string;
  ctaLabel?: string;
  ctaHref?: string;
  tone?: 'dark' | 'light';
};
const { eyebrow, title, body, note, ctaLabel, ctaHref, tone = 'light' } = Astro.props;
const light = tone === 'light';
---

<section
  class:list={[
    'page-hero border-b',
    light ? 'border-ink/10 bg-paper-warm text-ink' : 'border-paper/10 bg-ink text-paper',
  ]}
  data-track-section={`page-hero:${eyebrow.toLowerCase().replaceAll(' ', '-')}`}
>
  <div class="shell-wide py-13 sm:py-17 lg:py-22">
    <div class="page-hero__grid">
      <div data-reveal="up">
        <div class="flex items-center gap-3">
          <span
            class:list={['h-2 w-2 rounded-full', light ? 'bg-indigo-deep' : 'bg-accent']}
            aria-hidden="true"></span>
          <p class:list={['eyebrow', light ? 'text-indigo-deep' : 'text-accent']}>{eyebrow}</p>
        </div>
        <h1 class="page-hero__title">{title}</h1>
      </div>

      <div class="page-hero__aside" data-reveal="right" style="--reveal-delay:80ms">
        {note && <HandwrittenNote text={note} direction="left" tone={light ? 'ink' : 'light'} />}
        {
          body && (
            <p class:list={['page-hero__body', light ? 'text-dark-muted' : 'text-paper/55']}>
              {body}
            </p>
          )
        }
        {
          ctaLabel && ctaHref && (
            <a
              class:list={['text-link', light ? 'text-ink' : 'text-paper']}
              href={ctaHref}
              data-track-event="cta_clicked"
              data-track-label={`page-hero:${eyebrow}`}
            >
              {ctaLabel} <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .page-hero__grid {
    display: grid;
    gap: 2.5rem;
  }
  .page-hero__title {
    max-width: 14ch;
    margin-top: 1.45rem;
    font-family: var(--font-display);
    font-size: clamp(2.85rem, 5.35vw, 5.8rem);
    font-weight: 650;
    line-height: 0.97;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .page-hero__aside {
    display: grid;
    justify-items: start;
    gap: 1.45rem;
    align-self: end;
  }
  .page-hero__body {
    max-width: 34rem;
    margin: 0;
    padding-left: 1.1rem;
    border-left: 1px solid currentColor;
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.75;
  }
  .page-hero__aside :global(.hand-note) {
    justify-self: end;
    margin-right: 8%;
  }
  @media (min-width: 1024px) {
    .page-hero__grid {
      grid-template-columns: 1.07fr 0.93fr;
      align-items: end;
      gap: 5rem;
    }
  }
</style>
