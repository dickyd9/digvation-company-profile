---
type Item = { label: string; href?: string };
type Props = { items: Item[]; tone?: 'dark' | 'light' };
const { items, tone = 'dark' } = Astro.props;
---

<nav class="flex flex-wrap items-center gap-2 text-xs" aria-label="Breadcrumb">
  {
    items.map((item, index) => (
      <>
        {index > 0 && (
          <span aria-hidden="true" class={tone === 'light' ? 'text-dark-muted' : 'text-fog'}>
            /
          </span>
        )}
        {item.href ? (
          <a
            class:list={[
              'no-underline',
              tone === 'light' ? 'text-dark-muted hover:text-ink' : 'text-fog hover:text-paper',
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class={tone === 'light' ? 'text-ink' : 'text-paper'}>
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>
