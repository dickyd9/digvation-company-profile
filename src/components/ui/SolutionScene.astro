---
type Kind = 'experience' | 'workspace' | 'automation' | 'monitoring';
type Props = { kind: Kind; locale: 'id' | 'en'; compact?: boolean };

const { kind, locale, compact = false } = Astro.props;

const copy =
  locale === 'id'
    ? {
        label: 'Contoh bentuk solusi',
        experience: {
          aria: 'Contoh website dengan pesan bisnis yang jelas dan alur inquiry yang terhubung',
          brand: 'NORTH & CO.',
          nav: ['Solusi', 'Hasil kerja', 'Tentang'],
          eyebrow: 'OPERASIONAL UNTUK BISNIS YANG TUMBUH',
          title: 'Lebih mudah dipahami. Lebih mudah dihubungi.',
          body: 'Informasi, bukti, dan jalur inquiry disusun dalam satu pengalaman yang jelas.',
          cta: 'Mulai percakapan',
          proof: ['Solusi yang jelas', 'Bukti mudah ditemukan', 'Respons terarah'],
          lead: 'Inquiry baru',
          leadBody: 'Butuh website dan alur follow-up untuk tim sales.',
          status: 'Siap ditindaklanjuti',
        },
        workspace: {
          aria: 'Contoh sistem internal untuk mengelola order, penanggung jawab, status, dan approval',
          title: 'Order workspace',
          search: 'Cari order atau customer',
          nav: ['Ringkasan', 'Order', 'Approval', 'Laporan'],
          tabs: ['Semua order', 'Perlu approval', 'Terlambat'],
          head: ['Order', 'Customer', 'PIC', 'Status'],
          rows: [
            ['R-184', 'Customer A', 'Dina', 'Menunggu approval'],
            ['R-185', 'Customer B', 'Raka', 'Diproses'],
            ['R-186', 'Customer C', 'Ari', 'Siap dikirim'],
          ],
          detail: 'Approval R-184',
          detailBody: 'Harga dan ketersediaan sudah diverifikasi.',
          approve: 'Setujui',
          history: ['Order dibuat', 'Stok diverifikasi', 'Menunggu keputusan'],
        },
        automation: {
          aria: 'Contoh automation yang menghubungkan order, validasi data, sistem internal, dan notifikasi',
          title: 'Order automation',
          status: 'Flow aktif',
          nodes: ['Order masuk', 'Validasi data', 'Update sistem', 'Kirim notifikasi'],
          log: 'Aktivitas terakhir',
          events: [
            'Payload diterima',
            'Data valid',
            'Record diperbarui',
            'Tim mendapat notifikasi',
          ],
          success: 'Flow selesai tanpa input ulang',
        },
        monitoring: {
          aria: 'Contoh dashboard monitoring yang menghubungkan data, sensor, alert, dan tindakan',
          title: 'Operations intelligence',
          sync: 'Semua sumber terhubung',
          chart: 'Aktivitas operasional',
          attention: 'Perlu perhatian',
          alerts: ['Stok perlu dicek', 'Antrian meningkat', 'Sensor area B aktif'],
          action: 'Buka tindak lanjut',
          feed: 'Live floor map',
        },
      }
    : {
        label: 'Example solution form',
        experience: {
          aria: 'Example website with clear business messaging and a connected inquiry path',
          brand: 'NORTH & CO.',
          nav: ['Solutions', 'Work', 'About'],
          eyebrow: 'OPERATIONS FOR A GROWING BUSINESS',
          title: 'Easier to understand. Easier to contact.',
          body: 'Information, proof, and inquiry are shaped into one clear experience.',
          cta: 'Start a conversation',
          proof: ['Clear solutions', 'Proof is easy to find', 'Guided response'],
          lead: 'New inquiry',
          leadBody: 'Needs a website and a follow-up flow for the sales team.',
          status: 'Ready to follow up',
        },
        workspace: {
          aria: 'Example internal system for managing orders, owners, status, and approvals',
          title: 'Order workspace',
          search: 'Search order or customer',
          nav: ['Overview', 'Orders', 'Approvals', 'Reports'],
          tabs: ['All orders', 'Needs approval', 'Overdue'],
          head: ['Order', 'Customer', 'Owner', 'Status'],
          rows: [
            ['R-184', 'Customer A', 'Dina', 'Needs approval'],
            ['R-185', 'Customer B', 'Raka', 'Processing'],
            ['R-186', 'Customer C', 'Ari', 'Ready to ship'],
          ],
          detail: 'Approval R-184',
          detailBody: 'Price and availability have been verified.',
          approve: 'Approve',
          history: ['Order created', 'Stock verified', 'Waiting for decision'],
        },
        automation: {
          aria: 'Example automation connecting an order, data validation, internal systems, and notifications',
          title: 'Order automation',
          status: 'Flow active',
          nodes: ['Order received', 'Validate data', 'Update system', 'Send notification'],
          log: 'Latest activity',
          events: ['Payload received', 'Data valid', 'Record updated', 'Team notified'],
          success: 'Flow completed without repeated input',
        },
        monitoring: {
          aria: 'Example monitoring dashboard connecting data, sensors, alerts, and action',
          title: 'Operations intelligence',
          sync: 'All sources connected',
          chart: 'Operational activity',
          attention: 'Needs attention',
          alerts: ['Stock needs review', 'Queue is increasing', 'Area B sensor active'],
          action: 'Open follow-up',
          feed: 'Live floor map',
        },
      };

const scene = copy[kind];
---

<figure
  class:list={['solution-scene', `solution-scene--${kind}`, compact && 'solution-scene--compact']}
  role="img"
  aria-label={scene.aria}
  data-reveal="scale"
>
  <figcaption class="solution-scene__caption">
    <span>{copy.label}</span>
  </figcaption>

  {
    kind === 'experience' && (
      <div class="experience-stage">
        <section class="experience-browser">
          <div class="scene-windowbar">
            <>
              <span>
                <>
                  <i />
                  <i />
                  <i />
                </>
              </span>
              <b>north.example</b>
            </>
          </div>
          <nav>
            <>
              <strong>{copy.experience.brand}</strong>
              <span>{copy.experience.nav.join('   ')}</span>
            </>
          </nav>
          <div class="experience-page">
            <small>{copy.experience.eyebrow}</small>
            <h4>{copy.experience.title}</h4>
            <p>{copy.experience.body}</p>
            <button type="button" tabindex="-1">
              {copy.experience.cta}
              <span>↗</span>
            </button>
            <div class="experience-proof">
              {copy.experience.proof.map((item) => (
                <span>
                  <i>✓</i>
                  {item}
                </span>
              ))}
            </div>
          </div>
        </section>
        <aside class="lead-card">
          <div>
            <>
              <span>IN</span>
              <i>•••</i>
            </>
          </div>
          <small>{copy.experience.lead}</small>
          <strong>A••• / Operations</strong>
          <p>{copy.experience.leadBody}</p>
          <em>
            <i />
            {copy.experience.status}
          </em>
        </aside>
        <svg class="lead-line" viewBox="0 0 800 340" aria-hidden="true">
          <path d="M300 226 C430 270 510 210 614 168" />
          <circle cx="300" cy="226" r="5" />
          <circle cx="614" cy="168" r="5" />
        </svg>
      </div>
    )
  }

  {
    kind === 'workspace' && (
      <div class="workspace-stage">
        <header class="workspace-topbar">
          <strong>
            <span>D</span>
            {copy.workspace.title}
          </strong>
          <div>
            ⌕ <i>{copy.workspace.search}</i>
          </div>
          <b>NA</b>
        </header>
        <div class="workspace-body">
          <aside>
            {copy.workspace.nav.map((item, index) => (
              <span class:list={[index === 1 && 'is-active']}>
                <i>{['⌂', '□', '✓', '↗'][index]}</i>
                {item}
              </span>
            ))}
          </aside>
          <main>
            <div class="workspace-heading">
              <div>
                <>
                  <small>OPERATIONS / ORDER</small>
                  <h4>{copy.workspace.title}</h4>
                </>
              </div>
              <button type="button" tabindex="-1">
                + New order
              </button>
            </div>
            <div class="workspace-tabs">
              {copy.workspace.tabs.map((tab, index) => (
                <span class:list={[index === 0 && 'is-active']}>{tab}</span>
              ))}
            </div>
            <div class="workspace-table">
              <div class="workspace-row workspace-row--head">
                {copy.workspace.head.map((cell) => (
                  <b>{cell}</b>
                ))}
              </div>
              {copy.workspace.rows.map((row, rowIndex) => (
                <div class:list={['workspace-row', rowIndex === 0 && 'is-selected']}>
                  {row.map((cell, cellIndex) => (
                    <span class:list={[cellIndex === 3 && `status-${rowIndex}`]}>{cell}</span>
                  ))}
                </div>
              ))}
            </div>
          </main>
        </div>
        <aside class="approval-drawer">
          <header>
            <>
              <div>
                <>
                  <small>APPROVAL</small>
                  <strong>{copy.workspace.detail}</strong>
                </>
              </div>
              <span>×</span>
            </>
          </header>
          <p>{copy.workspace.detailBody}</p>
          <ol>
            {copy.workspace.history.map((item, index) => (
              <li>
                <i>{index < 2 ? '✓' : '•'}</i>
                {item}
              </li>
            ))}
          </ol>
          <button type="button" tabindex="-1">
            {copy.workspace.approve}
            <span>→</span>
          </button>
        </aside>
      </div>
    )
  }

  {
    kind === 'automation' && (
      <div class="automation-stage">
        <header class="automation-topbar">
          <div>
            <>
              <strong>{copy.automation.title}</strong>
              <span>Development / v1</span>
            </>
          </div>
          <p>
            <i />
            {copy.automation.status}
          </p>
        </header>
        <div class="automation-canvas">
          <svg viewBox="0 0 780 320" preserveAspectRatio="none" aria-hidden="true">
            <path d="M116 157 C188 157 193 78 272 78" />
            <path d="M116 157 C188 157 193 238 272 238" />
            <path d="M390 78 C475 78 450 157 532 157" />
            <path d="M390 238 C475 238 450 157 532 157" />
            <path d="M650 157 C695 157 700 157 748 157" />
          </svg>
          <div class="automation-node node-trigger">
            <>
              <i>↗</i>
              <span>
                <>
                  <small>TRIGGER</small>
                  <strong>{copy.automation.nodes[0]}</strong>
                </>
              </span>
              <b>✓</b>
            </>
          </div>
          <div class="automation-node node-validate">
            <>
              <i>◇</i>
              <span>
                <>
                  <small>LOGIC</small>
                  <strong>{copy.automation.nodes[1]}</strong>
                </>
              </span>
              <b>✓</b>
            </>
          </div>
          <div class="automation-node node-update">
            <>
              <i>▦</i>
              <span>
                <>
                  <small>SYSTEM</small>
                  <strong>{copy.automation.nodes[2]}</strong>
                </>
              </span>
              <b>✓</b>
            </>
          </div>
          <div class="automation-node node-notify">
            <>
              <i>○</i>
              <span>
                <>
                  <small>ACTION</small>
                  <strong>{copy.automation.nodes[3]}</strong>
                </>
              </span>
              <b>✓</b>
            </>
          </div>
        </div>
        <aside class="automation-log">
          <header>
            <>
              <strong>{copy.automation.log}</strong>
              <span>10:42:18</span>
            </>
          </header>
          <ol>
            {copy.automation.events.map((event, index) => (
              <li>
                <i>{String(index + 1).padStart(2, '0')}</i>
                <span>{event}</span>
                <b>done</b>
              </li>
            ))}
          </ol>
          <p>
            <span>✓</span>
            {copy.automation.success}
          </p>
        </aside>
      </div>
    )
  }

  {
    kind === 'monitoring' && (
      <div class="monitoring-stage">
        <header class="monitoring-topbar">
          <div>
            <>
              <span>D</span>
              <strong>{copy.monitoring.title}</strong>
            </>
          </div>
          <p>
            <i />
            {copy.monitoring.sync}
          </p>
        </header>
        <div class="monitoring-body">
          <section class="monitoring-chart">
            <header>
              <>
                <strong>{copy.monitoring.chart}</strong>
                <span>30 days⌄</span>
              </>
            </header>
            <div class="chart-canvas">
              <span class="chart-grid">
                <>
                  <i />
                  <i />
                  <i />
                  <i />
                </>
              </span>
              <svg viewBox="0 0 480 170" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id={`area-${locale}`} x1="0" x2="0" y1="0" y2="1">
                    <>
                      <stop offset="0" stop-color="#5367ee" stop-opacity=".28" />
                      <stop offset="1" stop-color="#5367ee" stop-opacity="0" />
                    </>
                  </linearGradient>
                </defs>
                <path
                  d="M0 138 C42 132 48 104 91 111 S153 139 190 94 S255 44 291 66 S342 113 378 76 S427 31 480 39 L480 170 L0 170 Z"
                  fill={`url(#area-${locale})`}
                />
                <path
                  d="M0 138 C42 132 48 104 91 111 S153 139 190 94 S255 44 291 66 S342 113 378 76 S427 31 480 39"
                  fill="none"
                  stroke="#5367ee"
                  stroke-width="3"
                  stroke-linecap="round"
                />
                <circle cx="291" cy="66" r="5" fill="#fff" stroke="#5367ee" stroke-width="3" />
              </svg>
            </div>
            <div class="chart-legend">
              <>
                <span>
                  <i />
                  Orders
                </span>
                <span>
                  <i />
                  Operations
                </span>
                <span>
                  <i />
                  Sensor
                </span>
              </>
            </div>
          </section>
          <section class="floor-map">
            <header>
              <>
                <strong>{copy.monitoring.feed}</strong>
                <span>LIVE</span>
              </>
            </header>
            <div class="floor-map__canvas">
              <svg viewBox="0 0 260 160" aria-hidden="true">
                <path
                  class="room"
                  d="M12 12 H248 V148 H12 Z M92 12 V86 H12 M92 86 H168 V148 M168 12 V60 H248 M168 60 V102 H248"
                />
                <path class="trail" d="M34 122 C58 98 70 60 112 64 S158 124 211 89" />
                <>
                  <circle cx="34" cy="122" r="8" />
                  <circle cx="112" cy="64" r="8" />
                  <circle cx="211" cy="89" r="8" />
                </>
              </svg>
            </div>
          </section>
          <aside class="attention-list">
            <header>
              <>
                <strong>{copy.monitoring.attention}</strong>
                <span>{copy.monitoring.alerts.length}</span>
              </>
            </header>
            {copy.monitoring.alerts.map((alert, index) => (
              <div>
                <i class={`alert-${index}`}>{['!', '↗', '◎'][index]}</i>
                <span>
                  <b>{alert}</b>
                  <small>{copy.monitoring.action} →</small>
                </span>
              </div>
            ))}
          </aside>
        </div>
      </div>
    )
  }
</figure>

<style>
  .solution-scene {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    min-height: 20rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #eef0f4;
    color: #12161d;
  }
  .solution-scene--compact {
    min-height: 17rem;
  }
  .solution-scene__caption {
    display: flex;
    min-height: 2.6rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid #dfe2e7;
    background: #fff;
    color: #858c96;
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .experience-stage,
  .workspace-stage,
  .automation-stage,
  .monitoring-stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }
  .experience-stage {
    background:
      radial-gradient(circle at 88% 14%, rgba(147, 166, 255, 0.34), transparent 30%),
      linear-gradient(145deg, #dfe4f2, #f7f7f8 62%, #d7dceb);
  }
  .experience-browser {
    position: absolute;
    top: 7%;
    right: 13%;
    bottom: 8%;
    left: 4%;
    overflow: hidden;
    border: 1px solid rgba(18, 26, 47, 0.2);
    border-radius: 0.48rem;
    background: #fff;
    box-shadow: 0 22px 50px rgba(18, 26, 47, 0.16);
  }
  .scene-windowbar {
    display: flex;
    min-height: 1.9rem;
    align-items: center;
    gap: 1rem;
    padding: 0 0.7rem;
    border-bottom: 1px solid #e4e6e9;
    background: #f7f8fa;
  }
  .scene-windowbar > span {
    display: flex;
    gap: 0.25rem;
  }
  .scene-windowbar i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #c6cbd2;
  }
  .scene-windowbar b {
    min-width: 8rem;
    padding: 0.22rem 0.6rem;
    border: 1px solid #e0e3e7;
    border-radius: 0.22rem;
    background: #fff;
    color: #9ba0a8;
    font-size: 0.43rem;
    font-weight: 500;
    text-align: center;
  }
  .experience-browser nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem 0;
  }
  .experience-browser nav strong {
    font-family: var(--font-display);
    font-size: 0.6rem;
  }
  .experience-browser nav span {
    color: #767d87;
    font-size: 0.42rem;
    word-spacing: 0.5rem;
  }
  .experience-page {
    width: 76%;
    padding: 1.7rem 1rem 1rem;
  }
  .experience-page > small {
    color: #5367ee;
    font-size: 0.4rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }
  .experience-page h4 {
    max-width: 13ch;
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.7vw, 2.25rem);
    line-height: 0.97;
    letter-spacing: -0.05em;
  }
  .experience-page > p {
    max-width: 29rem;
    margin: 0.7rem 0 0;
    color: #757d87;
    font-size: 0.5rem;
    line-height: 1.55;
  }
  .experience-page button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.8rem;
    border: 0;
    border-radius: 0.22rem;
    padding: 0.48rem 0.68rem;
    background: #121a2f;
    color: white;
    font-size: 0.46rem;
    font-weight: 750;
  }
  .experience-proof {
    display: flex;
    gap: 0.7rem;
    margin-top: 0.9rem;
  }
  .experience-proof span {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    color: #69717c;
    font-size: 0.39rem;
    font-weight: 650;
  }
  .experience-proof i {
    display: grid;
    width: 0.78rem;
    height: 0.78rem;
    place-items: center;
    border-radius: 50%;
    background: #e3e7ff;
    color: #4458d0;
    font-size: 0.38rem;
    font-style: normal;
  }
  .lead-card {
    position: absolute;
    top: 19%;
    right: 2.5%;
    z-index: 3;
    width: min(31%, 14rem);
    padding: 0.85rem;
    border: 1px solid rgba(18, 26, 47, 0.2);
    border-radius: 0.45rem;
    background: #fff;
    box-shadow: 0 18px 42px rgba(18, 26, 47, 0.18);
    transform: rotate(1.3deg);
  }
  .lead-card > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .lead-card > div span {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border-radius: 0.3rem;
    background: #121a2f;
    color: white;
    font-size: 0.42rem;
    font-weight: 850;
  }
  .lead-card > div i {
    color: #969ca5;
    font-style: normal;
  }
  .lead-card small {
    display: block;
    margin-top: 0.75rem;
    color: #5367ee;
    font-size: 0.43rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .lead-card strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.62rem;
  }
  .lead-card p {
    margin: 0.55rem 0 0;
    color: #737a84;
    font-size: 0.47rem;
    line-height: 1.5;
  }
  .lead-card em {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.65rem;
    color: #34704e;
    font-size: 0.42rem;
    font-style: normal;
    font-weight: 750;
  }
  .lead-card em i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #3d9b67;
  }
  .lead-line {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .lead-line path {
    fill: none;
    stroke: #5367ee;
    stroke-width: 1.4;
    stroke-dasharray: 5 6;
  }
  .lead-line circle {
    fill: #5367ee;
  }
  .workspace-stage {
    background: #eef0f3;
    font-size: clamp(0.34rem, 0.58vw, 0.57rem);
  }
  .workspace-topbar {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    min-height: 2.7rem;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid #d9dde2;
    background: #fff;
  }
  .workspace-topbar > strong {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.75rem;
  }
  .workspace-topbar > strong span {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border-radius: 0.3rem;
    background: #121a2f;
    color: white;
  }
  .workspace-topbar > div {
    justify-self: center;
    display: flex;
    width: min(17rem, 70%);
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid #e0e3e6;
    border-radius: 0.3rem;
    background: #f8f9fa;
    color: #8b9199;
  }
  .workspace-topbar > div i {
    font-style: normal;
  }
  .workspace-topbar > b {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.75rem;
    place-items: center;
    border-radius: 50%;
    background: #e3e7ff;
    color: #4458d0;
  }
  .workspace-body {
    display: grid;
    grid-template-columns: 8rem 1fr;
    min-height: calc(100% - 2.7rem);
  }
  .workspace-body > aside {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.7rem;
    border-right: 1px solid #d9dde2;
    background: #fff;
