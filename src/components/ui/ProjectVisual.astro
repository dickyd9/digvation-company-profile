---
import { brandConfig } from '@/config/brand';

type Props = {
  title: string;
  index?: number;
  variant?: 'ink' | 'navy' | 'paper';
  class?: string;
  image?: string | undefined;
  transitionName?: string | undefined;
  descriptor?: string;
};
const {
  title,
  index = 1,
  variant = 'navy',
  class: className = '',
  image,
  transitionName,
  descriptor,
} = Astro.props;
const scene =
  variant === 'paper'
    ? { outer: 'bg-paper-soft text-ink', screen: 'bg-paper', accent: 'bg-accent text-ink' }
    : variant === 'navy'
      ? {
          outer: 'bg-[#e6e8ec] text-ink',
          screen: 'bg-indigo-deep text-paper',
          accent: 'bg-accent text-ink',
        }
      : {
          outer: 'bg-[#dfe2e8] text-ink',
          screen: 'bg-ink text-paper',
          accent: 'bg-accent text-ink',
        };
---

<div
  class:list={['project-visual relative isolate overflow-hidden', scene.outer, className]}
  aria-label={image ? title : `Visual representation for ${title}`}
  data-transition-name={transitionName}
>
  {
    image ? (
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.015]"
      />
    ) : (
      <div class="absolute inset-0 p-4 sm:p-6">
        <div class="relative h-full">
          <div
            class:list={[
              'absolute top-[4%] right-[2%] grid size-16 place-items-center rounded-2xl opacity-90 sm:size-20',
              scene.accent,
            ]}
            aria-hidden="true"
          >
            <img
              src={brandConfig.assets.markIndigo}
              alt=""
              width="48"
              height="48"
              class="w-8 sm:w-10"
            />
          </div>

          <div
            class:list={[
              'border-ink/10 absolute top-[10%] right-[8%] bottom-[5%] left-[3%] overflow-hidden rounded-[.75rem] border shadow-[0_24px_45px_rgba(11,13,16,.18)] transition-transform duration-300 group-hover:-translate-y-1 group-hover:rotate-[.4deg]',
              scene.screen,
            ]}
          >
            <div class="flex h-9 items-center justify-between border-b border-current/10 px-3 text-[.58rem] font-bold tracking-[.08em] uppercase opacity-65">
              <div class="flex gap-1.5" aria-hidden="true">
                <>
                  <span class="size-2 rounded-full bg-current/30" />
                  <span class="size-2 rounded-full bg-current/20" />
                  <span class="size-2 rounded-full bg-current/15" />
                </>
              </div>
              <span>{descriptor ?? 'Selected work'}</span>
            </div>
            <div class="grid h-[calc(100%_-_2.25rem)] grid-cols-[.82fr_1.18fr] gap-3 p-4 sm:p-5">
              <div class="flex flex-col justify-between">
                <div>
                  <span class="text-[.6rem] font-bold tracking-[.08em] uppercase opacity-50">
                    Project 0{index}
                  </span>
                  <strong class="mt-2 block text-lg leading-tight font-semibold tracking-[-.035em] sm:text-2xl">
                    {title}
                  </strong>
                </div>
                <div class="grid gap-2">
                  <div class="h-2 w-[78%] rounded-full bg-current/15" />
                  <div class="h-2 w-[55%] rounded-full bg-current/10" />
                  <div class:list={['mt-2 h-8 w-24 rounded-full', scene.accent]} />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 self-stretch" aria-hidden="true">
                <div class="col-span-2 rounded-xl bg-current/[.07]" />
                <div class="rounded-xl bg-current/[.12]" />
                <div class="rounded-xl bg-current/[.055]" />
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }
</div>
