---
type Props = {
  current: number;
  total?: number;
  tone?: 'ink' | 'paper';
  align?: 'left' | 'right';
};

const { current, total = 7, tone = 'ink', align = 'right' } = Astro.props;
const label = `${String(current).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
---

<div
  class:list={['chapter-marker', `chapter-marker--${tone}`, `chapter-marker--${align}`]}
  aria-hidden="true"
  data-reveal="line"
>
  <span class="chapter-marker__count">{label}</span>
  <span class="chapter-marker__rail"></span>
  <span class="chapter-marker__diamond"></span>
</div>

<style>
  .chapter-marker {
    position: absolute;
    z-index: 3;
    top: clamp(1rem, 1.8vw, 1.65rem);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: rgba(11, 13, 16, 0.38);
    pointer-events: none;
  }
  .chapter-marker--left {
    left: max(0.85rem, calc((100% - 88rem) / 2 + 0.85rem));
  }
  .chapter-marker--right {
    right: max(0.85rem, calc((100% - 88rem) / 2 + 0.85rem));
    flex-direction: row-reverse;
  }
  .chapter-marker--paper {
    color: rgba(255, 255, 255, 0.42);
  }
  .chapter-marker__count {
    font-size: 0.52rem;
    font-weight: 760;
    letter-spacing: 0.105em;
    line-height: 1;
  }
  .chapter-marker__rail {
    width: clamp(1.8rem, 3vw, 2.8rem);
    height: 1px;
    background: currentColor;
    opacity: 0.52;
  }
  .chapter-marker__diamond {
    width: 0.3rem;
    height: 0.3rem;
    background: #5367ee;
    transform: rotate(45deg);
  }
  .chapter-marker--paper .chapter-marker__diamond {
    background: var(--color-accent);
  }
  @media (max-width: 640px) {
    .chapter-marker {
      top: 0.85rem;
      gap: 0.42rem;
    }
    .chapter-marker--left {
      left: 0.8rem;
    }
    .chapter-marker--right {
      right: 0.8rem;
    }
    .chapter-marker__rail {
      width: 1.35rem;
    }
    .chapter-marker__count {
      font-size: 0.48rem;
    }
  }
</style>
