---
type Props = {
  title: string;
  url: string;
  locale?: 'id' | 'en';
  class?: string;
};

const { title, url, locale = 'id', class: className = '' } = Astro.props;
const domain = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<div class:list={['live-project relative isolate overflow-hidden', className]}>
  <div class="live-project__loading absolute inset-0 grid place-items-center text-center">
    <div>
      <span>{locale === 'id' ? 'Memuat website live' : 'Loading live website'}</span>
      <strong>{title}</strong>
    </div>
  </div>

  <div class="live-project__stage">
    <header class="live-project__intro">
      <div>
        <span>{locale === 'id' ? 'PROJECT LIVE' : 'LIVE PROJECT'}</span>
        <strong>{title}</strong>
      </div>
      <p>{locale === 'id' ? 'Website yang sudah tayang' : 'Published website'}</p>
    </header>

    <div class="live-project__browser">
      <div class="live-project__chrome" aria-hidden="true">
        <div><i></i><i></i><i></i></div>
        <span>{domain}</span>
        <b><i></i>{locale === 'id' ? 'Tayang' : 'Live'}</b>
      </div>
      <div class="live-project__viewport">
        <iframe
          src={url}
          title={`Live visual preview of ${title}`}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
          tabindex="-1"
          aria-hidden="true"></iframe>
      </div>
    </div>

    <footer class="live-project__footer" aria-hidden="true">
      <span>DESIGN / BUILD / LAUNCH</span>
      <span>{locale === 'id' ? 'Kunjungi website' : 'Visit website'} ↗</span>
    </footer>
  </div>
</div>

<style>
  .live-project {
    min-height: 22rem;
    background: #121a2f;
    color: #fff;
  }
  .live-project__loading {
    background: #e7eaed;
    color: #121a2f;
  }
  .live-project__loading span {
    color: rgba(18, 26, 47, 0.42);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .live-project__loading strong {
    display: block;
    margin-top: 0.45rem;
    font-size: clamp(1rem, 2vw, 1.45rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .live-project__stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    gap: clamp(0.7rem, 1.4vw, 1.15rem);
    padding: clamp(1rem, 2.3vw, 2rem);
    background-color: #121a2f;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
  }
  .live-project__intro,
  .live-project__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .live-project__intro > div {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.8rem;
  }
  .live-project__intro span,
  .live-project__intro p,
  .live-project__footer {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: clamp(0.5rem, 0.7vw, 0.62rem);
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .live-project__intro span {
    color: var(--color-accent);
  }
  .live-project__intro strong {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.3rem);
    font-weight: 620;
    letter-spacing: -0.03em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .live-project__browser {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0.45rem;
    background: #fff;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.34);
    transition:
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 600ms ease;
  }
  .live-project__chrome {
    display: grid;
    grid-template-columns: 1fr minmax(0, 2fr) 1fr;
    align-items: center;
    min-height: 2.15rem;
    gap: 0.8rem;
    padding: 0.4rem 0.7rem;
    border-bottom: 1px solid #dedfe1;
    background: #f4f4f2;
    color: rgba(11, 13, 16, 0.5);
    font-size: clamp(0.45rem, 0.63vw, 0.57rem);
    font-weight: 700;
  }
  .live-project__chrome > div {
    display: flex;
    gap: 0.27rem;
  }
  .live-project__chrome > div i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #c8cbd0;
  }
  .live-project__chrome > span {
    overflow: hidden;
    padding: 0.25rem 0.6rem;
    border: 1px solid #dedfe1;
    border-radius: 0.25rem;
    background: #fff;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .live-project__chrome > b {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    color: #2f7550;
    font-size: inherit;
    text-transform: uppercase;
  }
  .live-project__chrome > b i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #48b97a;
    box-shadow: 0 0 0 3px rgba(72, 185, 122, 0.13);
  }
  .live-project__viewport {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #fff;
  }
  .live-project__viewport iframe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 160%;
    height: 160%;
    border: 0;
    background: #fff;
    pointer-events: none;
    transform: scale(0.625);
    transform-origin: top left;
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .live-project__footer span:last-child {
    color: rgba(255, 255, 255, 0.86);
  }
  .live-project:hover .live-project__browser {
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: translateY(-0.25rem);
  }
  .live-project:hover .live-project__viewport iframe {
    transform: scale(0.635);
  }
  @media (max-width: 560px) {
    .live-project {
      min-height: 18rem;
    }
    .live-project__intro p,
    .live-project__footer span:first-child {
      display: none;
    }
    .live-project__intro > div {
      display: grid;
      gap: 0.2rem;
    }
    .live-project__stage {
      background-size: 1.8rem 1.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-project__browser,
    .live-project__viewport iframe {
      transition: none;
    }
    .live-project:hover .live-project__browser {
      transform: none;
    }
    .live-project:hover .live-project__viewport iframe {
      transform: scale(0.625);
    }
  }
</style>
