---
import { getLocalizedPath } from '@/config/navigation';
import { pricingConfig } from '@/config/pricing';
import type { Locale } from '@/config/site';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

{
  pricingConfig.enabled && pricingConfig.items.length > 0 && (
    <section
      class="pricing-anchor bg-paper text-ink"
      data-track-section="pricing"
      data-pricing-anchor
    >
      <div class="shell section-pad">
        <header>
          <p class="eyebrow text-indigo-deep">{pricingConfig.eyebrow[locale]}</p>
          <h2>{pricingConfig.title[locale]}</h2>
          <p>{pricingConfig.description[locale]}</p>
        </header>
        <div class="pricing-anchor__items">
          {pricingConfig.items.map((item) => (
            <article>
              <h3>{item.label[locale]}</h3>
              <strong>{item.startingFrom}</strong>
              <p>{item.note[locale]}</p>
            </article>
          ))}
        </div>
        <div class="pricing-anchor__footer">
          <p>{pricingConfig.disclaimer[locale]}</p>
          <a
            class="button-primary"
            href={getLocalizedPath(locale, '/contact')}
            data-track-event="pricing_cta_click"
          >
            {locale === 'id' ? 'Diskusikan scope' : 'Discuss the scope'} ↗
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .pricing-anchor header {
    display: grid;
    gap: 1rem;
  }
  .pricing-anchor h2 {
    max-width: 17ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    font-weight: 545;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .pricing-anchor header > p:last-child {
    max-width: 38rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .pricing-anchor__items {
    display: grid;
    margin-top: 3rem;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
  }
  .pricing-anchor__items article {
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: 1.5rem 0;
  }
  .pricing-anchor__items h3 {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 750;
  }
  .pricing-anchor__items strong {
    display: block;
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: 2rem;
  }
  .pricing-anchor__items p {
    color: rgba(11, 13, 16, 0.5);
    font-size: 0.75rem;
  }
  .pricing-anchor__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-top: 2rem;
  }
  .pricing-anchor__footer p {
    max-width: 36rem;
    color: rgba(11, 13, 16, 0.5);
    font-size: 0.74rem;
  }
  @media (min-width: 760px) {
    .pricing-anchor__items {
      grid-template-columns: repeat(3, 1fr);
    }
    .pricing-anchor__items article {
      padding-right: 1.5rem;
    }
  }
</style>
