---
import ProjectFrame from '@/components/work/ProjectFrame.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import { getFeaturedWorkEntries } from '@/lib/content/catalog';

type Props = { locale: Locale };
const { locale } = Astro.props;
const works = await getFeaturedWorkEntries(locale, 2);
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Bukti, bukan klaim',
        title: 'Lihat yang sudah berjalan.',
        intro: 'Kebutuhannya berbeda. Solusinya dibangun untuk benar-benar digunakan.',
        caseStudy: 'Lihat cerita project',
        live: 'Buka project live',
        all: 'Lihat seluruh hasil kerja',
      }
    : {
        eyebrow: 'Proof, not promises',
        title: 'See what is already live.',
        intro: 'Different needs. Each solution was built to be genuinely used.',
        caseStudy: 'Read the project story',
        live: 'Open the live project',
        all: 'See all work',
      };
---

<section
  class="featured-work bg-paper text-ink"
  id="featured-work"
  data-track-section="featured-work"
>
  <div class="shell-wide featured-work__inner">
    <header class="featured-work__header" data-reveal="mask">
      <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p>{copy.intro}</p>
    </header>

    <div class="featured-work__list">
      {
        works.map((entry, index) => {
          const detailHref =
            entry.data.entryType === 'case-study'
              ? getLocalizedPath(locale, `/work/${entry.data.routeSlug}`)
              : entry.data.liveUrl;
          const image = entry.data.coverImage ?? '';
          const imageSize =
            entry.data.routeSlug === 'poseidon-filter'
              ? { width: 1348, height: 945 }
              : { width: 1363, height: 936 };
          const scene = entry.data.visualVariant === 'paper' ? 'paper' : 'navy';

          return (
            <article class:list={['featured-project', `featured-project--${scene}`]}>
              <div class="featured-project__stage" data-reveal="visual">
                <div class="featured-project__stage-meta" aria-hidden="true">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{entry.data.projectType}</span>
                  <span>{entry.data.year}</span>
                </div>
                <div class="featured-project__frame">
                  <ProjectFrame
                    image={image}
                    alt={`${entry.data.title}. ${entry.data.summary}`}
                    url={entry.data.liveUrl ? new URL(entry.data.liveUrl).hostname : undefined}
                    href={detailHref}
                    loading="lazy"
                    width={imageSize.width}
                    height={imageSize.height}
                    imageClass={
                      entry.data.routeSlug === 'poseidon-filter'
                        ? 'aspect-[1.43] object-top'
                        : 'aspect-[1.46]'
                    }
                  />
                </div>
              </div>

              <div class="featured-project__copy" data-reveal="line">
                <div>
                  <span class="featured-project__client">{entry.data.client}</span>
                  <h3>{entry.data.title}</h3>
                </div>
                <div>
                  <p>{entry.data.summary}</p>
                  <div class="featured-project__links">
                    {entry.data.entryType === 'case-study' && (
                      <a
                        href={detailHref}
                        data-track-event="project_view"
                        data-track-label={entry.data.routeSlug}
                      >
                        {copy.caseStudy}
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                    {entry.data.liveUrl && (
                      <a
                        href={entry.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-track-event="outbound_project_click"
                        data-track-label={entry.data.routeSlug}
                      >
                        {copy.live}
                        <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="featured-work__footer">
      <a class="text-link" href={getLocalizedPath(locale, '/work')}>
        {copy.all}<span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .featured-work__inner {
    padding-block: clamp(6.5rem, 11vw, 10.5rem);
  }
  .featured-work__header {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .featured-work__header h2 {
    max-width: 11ch;
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4.9vw, 5rem);
    font-weight: 570;
    line-height: 0.98;
    letter-spacing: -0.052em;
  }
  .featured-work__header > p:last-child {
    max-width: 31rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .featured-work__list {
    display: grid;
    gap: clamp(7rem, 14vw, 13rem);
  }
  .featured-project__stage {
    position: relative;
    display: grid;
    min-height: clamp(28rem, 66vw, 49rem);
    place-items: center;
    overflow: clip;
    padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 6vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .featured-project--navy .featured-project__stage {
    background: #08213e;
    color: #ffffff;
  }
  .featured-project--paper .featured-project__stage {
    background: #edf2eb;
    color: var(--color-ink);
  }
  .featured-project__stage-meta {
    position: absolute;
    top: 1.35rem;
    right: 1.4rem;
    left: 1.4rem;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    color: currentColor;
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    opacity: 0.6;
    text-transform: uppercase;
  }
  .featured-project__frame {
    width: min(100%, 70rem);
    transform-origin: 50% 70%;
  }
  .featured-project--paper .featured-project__frame {
    width: min(88%, 61rem);
  }
  .featured-project__copy {
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid rgba(11, 13, 16, 0.15);
    padding-top: 1.5rem;
  }
  .featured-project__client {
    color: rgba(11, 13, 16, 0.48);
    font-size: 0.61rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .featured-project__copy h3 {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.8vw, 3.85rem);
    font-weight: 580;
    line-height: 1;
    letter-spacing: -0.048em;
  }
  .featured-project__copy p {
    max-width: 36rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.6);
    font-size: 0.9rem;
    line-height: 1.72;
  }
  .featured-project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    margin-top: 1.25rem;
  }
  .featured-project__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.23rem;
    color: var(--color-ink);
    font-size: 0.77rem;
    font-weight: 750;
    text-decoration: none;
  }
  .featured-project__links a:last-child {
    color: rgba(11, 13, 16, 0.58);
  }
  .featured-project__links a span {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .featured-project__links a:hover span {
    transform: translate(0.18rem, -0.08rem);
  }
  .featured-work__footer {
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid rgba(11, 13, 16, 0.14);
    padding-top: 1.5rem;
  }
  @media (min-width: 820px) {
    .featured-work__header {
      grid-template-columns: 0.25fr 1fr 0.55fr;
      align-items: end;
    }
    .featured-work__header .eyebrow {
      align-self: start;
      margin-top: 0.75rem;
    }
    .featured-project__copy {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
      padding-top: 1.8rem;
    }
  }
  @media (max-width: 640px) {
    .featured-work__inner {
      padding-block: 5.5rem;
    }
    .featured-project__stage {
      min-height: 25rem;
      padding: 4.25rem 0.75rem 1.2rem;
    }
    .featured-project--paper .featured-project__frame {
      width: 94%;
    }
    .featured-project__stage-meta {
      top: 1.15rem;
      right: 1rem;
      left: 1rem;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .featured-project__frame {
        animation: project-frame-enter linear both;
        animation-range: entry 5% cover 42%;
        animation-timeline: view();
      }
      @keyframes project-frame-enter {
        from {
          clip-path: inset(8% 5% 0);
          transform: scale(0.93);
        }
        to {
          clip-path: inset(0);
          transform: scale(1);
        }
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured-project__links a span {
      transition: none;
    }
  }
</style>
