---
import ProjectFrame from '@/components/work/ProjectFrame.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import { getFeaturedWorkEntries } from '@/lib/content/catalog';

type Props = { locale: Locale };
const { locale } = Astro.props;
const works = await getFeaturedWorkEntries(locale, 2);
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Yang kami bangun',
        title: 'Bukan sekadar ide. Ini sudah berjalan.',
        intro:
          'Website dan produk digital yang dibangun untuk kebutuhan nyata, lalu digunakan di dunia nyata.',
        caseStudy: 'Lihat cerita project',
        live: 'Buka project live',
        all: 'Lihat seluruh hasil kerja',
      }
    : {
        eyebrow: 'What we build',
        title: 'Not just an idea. This is already live.',
        intro:
          'Websites and digital products built around a real need, then used in the real world.',
        caseStudy: 'Read the project story',
        live: 'Open the live project',
        all: 'See all work',
      };
---

<section
  class="featured-work bg-ink text-paper"
  id="featured-work"
  data-track-section="featured-work"
>
  <div class="shell-wide section-pad">
    <header class="featured-work__header" data-reveal="up">
      <div>
        <p class="eyebrow text-accent">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
      </div>
      <p>{copy.intro}</p>
    </header>

    <div class="featured-work__list">
      {
        works.map((entry, index) => {
          const detailHref =
            entry.data.entryType === 'case-study'
              ? getLocalizedPath(locale, `/work/${entry.data.routeSlug}`)
              : entry.data.liveUrl;
          const image = entry.data.coverImage ?? '';
          const imageSize =
            entry.data.routeSlug === 'poseidon-filter'
              ? { width: 1348, height: 945 }
              : { width: 1363, height: 936 };

          return (
            <article class:list={['featured-project', index === 1 && 'featured-project--offset']}>
              <div class="featured-project__meta" data-reveal="up">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>{entry.data.client}</span>
                <span>{entry.data.projectType}</span>
                <span>{entry.data.year}</span>
              </div>
              <div class="featured-project__visual" data-reveal="up" style="--reveal-delay:80ms">
                <ProjectFrame
                  image={image}
                  alt={`${entry.data.title}. ${entry.data.summary}`}
                  url={entry.data.liveUrl ? new URL(entry.data.liveUrl).hostname : undefined}
                  label={entry.data.title}
                  href={detailHref}
                  loading="lazy"
                  width={imageSize.width}
                  height={imageSize.height}
                  imageClass={
                    entry.data.routeSlug === 'poseidon-filter'
                      ? 'aspect-[1.43] object-top'
                      : 'aspect-[1.46]'
                  }
                />
              </div>
              <div class="featured-project__copy" data-reveal="up">
                <h3>{entry.data.title}</h3>
                <div>
                  <p>{entry.data.summary}</p>
                  <div class="featured-project__links">
                    {entry.data.entryType === 'case-study' && (
                      <a
                        href={detailHref}
                        data-track-event="project_view"
                        data-track-label={entry.data.routeSlug}
                      >
                        {copy.caseStudy}
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                    {entry.data.liveUrl && (
                      <a
                        href={entry.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-track-event="outbound_project_click"
                        data-track-label={entry.data.routeSlug}
                      >
                        {copy.live}
                        <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <a class="featured-work__all" href={getLocalizedPath(locale, '/work')}>
      {copy.all}<span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .featured-work__header {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .featured-work__header h2 {
    max-width: 13ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 6vw, 6.4rem);
    font-weight: 620;
    line-height: 0.96;
    letter-spacing: -0.06em;
  }
  .featured-work__header > p {
    max-width: 34rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .featured-work__list {
    display: grid;
    gap: clamp(5rem, 11vw, 10rem);
  }
  .featured-project__meta {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding: 1rem 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .featured-project__visual {
    color: var(--color-ink);
  }
  .featured-project__copy {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.8rem;
  }
  .featured-project__copy h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 5.3rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .featured-project__copy p {
    max-width: 39rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .featured-project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .featured-project__links a,
  .featured-work__all {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    color: var(--color-paper);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }
  .featured-project__links a:last-child {
    color: rgba(255, 255, 255, 0.68);
  }
  .featured-work__all {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  @media (min-width: 900px) {
    .featured-work__header {
      grid-template-columns: 1.35fr 0.65fr;
    }
    .featured-project__copy {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .featured-project--offset {
      width: 76%;
      margin-left: auto;
    }
  }
  @media (max-width: 640px) {
    .featured-project__meta {
      grid-template-columns: 2rem 1fr auto;
    }
    .featured-project__meta span:nth-child(3) {
      display: none;
    }
  }
</style>
