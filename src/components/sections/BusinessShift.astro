---
import ChapterMarker from '@/components/ui/ChapterMarker.astro';
import OperationalScene from '@/components/ui/OperationalScene.astro';
import type { HomeCopy } from '@/content/home';

type Props = { copy: HomeCopy['shift'] };
const { copy } = Astro.props;
---

<section class="business-shift bg-paper-soft text-ink" data-track-section="business-shift">
  <ChapterMarker current={3} />
  <div class="shell-wide business-shift__inner">
    <header class="business-shift__intro" data-reveal="mask">
      <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p>{copy.intro}</p>
    </header>

    <ol class="business-shift__stories" data-reveal-group>
      {
        copy.items.map((item, index) => {
          const titleId = `business-shift-result-${index + 1}`;

          return (
            <li
              class={`business-shift__story business-shift__story--${index + 1}`}
              data-reveal="line"
            >
              <div class="business-shift__copy">
                <span class="business-shift__index">{String(index + 1).padStart(2, '0')}</span>
                <p>{item.before}</p>
                <div class="business-shift__result">
                  <span aria-hidden="true">→</span>
                  <h3 id={titleId}>{item.after}</h3>
                </div>
              </div>

              <figure aria-labelledby={titleId}>
                <OperationalScene
                  variant={index === 0 ? 'order' : index === 1 ? 'status' : 'report'}
                  diagram={item.diagram}
                  beforeLabel={copy.beforeLabel}
                  afterLabel={copy.afterLabel}
                />
                <figcaption>{item.detail}</figcaption>
              </figure>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .business-shift {
    position: relative;
  }
  .business-shift__inner {
    padding-block: var(--space-section);
  }
  .business-shift__intro {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .business-shift__intro h2 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 4.45vw, 4.55rem);
    font-weight: 545;
    line-height: 0.99;
    letter-spacing: -0.054em;
  }
  .business-shift__intro > p:last-child {
    max-width: 31rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.72;
  }
  .business-shift__stories {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    list-style: none;
  }
  .business-shift__story {
    display: grid;
    min-width: 0;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
    padding: clamp(4rem, 8vw, 7rem) 0;
  }
  .business-shift__story + .business-shift__story {
    border-top: 1px solid var(--border-subtle);
  }
  .business-shift__copy {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    align-content: center;
  }
  .business-shift__index {
    padding-top: 0.35rem;
    color: var(--text-soft);
    font-size: 0.59rem;
    font-weight: 780;
    letter-spacing: 0.08em;
  }
  .business-shift__copy > p {
    max-width: 19rem;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: clamp(1.16rem, 1.65vw, 1.5rem);
    font-weight: 520;
    line-height: 1.22;
    letter-spacing: -0.03em;
  }
  .business-shift__result {
    display: grid;
    grid-column: 2;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    margin-top: 0.5rem;
  }
  .business-shift__result > span {
    padding-top: 0.32rem;
    color: var(--color-indigo-deep);
    font-size: 0.9rem;
  }
  .business-shift h3 {
    max-width: 11ch;
    margin: 0;
    color: var(--color-indigo-deep);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    font-weight: 565;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .business-shift figure {
    min-width: 0;
    margin: 0;
  }
  .business-shift figcaption {
    max-width: 34rem;
    margin-top: 0.9rem;
    color: var(--text-soft);
    font-size: 0.7rem;
    line-height: 1.58;
  }
  @media (min-width: 900px) {
    .business-shift__intro {
      grid-template-columns: 0.25fr minmax(0, 1fr) minmax(18rem, 0.54fr);
    }
    .business-shift__intro .eyebrow {
      align-self: start;
      margin-top: 0.75rem;
    }
  }
  @media (min-width: 980px) {
    .business-shift__story {
      grid-template-columns: minmax(17rem, 0.42fr) minmax(0, 1fr);
    }
    .business-shift__story:nth-child(even) {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.42fr);
    }
    .business-shift__story:nth-child(even) figure {
      grid-column: 1;
      grid-row: 1;
    }
    .business-shift__story:nth-child(even) .business-shift__copy {
      grid-column: 2;
      grid-row: 1;
    }
  }
  @media (max-width: 720px) {
    .business-shift__story {
      gap: 2rem;
      padding-block: 4rem;
    }
  }
</style>
