---
import type { Locale } from '@/config/site';
import { clients } from '@/content/social-proof';

type Props = { locale: Locale };
const { locale } = Astro.props;
const realClients = clients;
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Kenapa disebut partner?',
        title: 'Karena bisnis butuh lebih dari daftar fitur.',
        body: 'Kami ikut memahami masalah, menjaga keputusan tetap jelas, dan bertanggung jawab sampai solusi bisa dipakai.',
        items: [
          ['Masuk ke konteks bisnis', 'Proses, orang, data, dan hambatan dilihat lebih dulu.'],
          ['Keputusan tetap jelas', 'Scope, prioritas, dan risiko dibahas tanpa jargon.'],
          [
            'Tetap ada setelah launch',
            'Sistem bisa dirawat dan ditingkatkan saat bisnis bergerak.',
          ],
        ],
        proof: 'Bisnis yang sudah kami bantu',
        honest: 'Kami hanya menampilkan project dan nama client yang memang bisa diverifikasi.',
      }
    : {
        eyebrow: 'Why call it a partnership?',
        title: 'Because a business needs more than a feature list.',
        body: 'We understand the problem, keep decisions clear, and stay accountable until the solution works in practice.',
        items: [
          ['Enter the business context', 'Process, people, data, and friction come first.'],
          ['Keep decisions clear', 'Scope, priority, and risk without the jargon.'],
          ['Stay after launch', 'The system can improve as the business moves.'],
        ],
        proof: 'Businesses we have helped',
        honest: 'We only show projects and client names that can be verified.',
      };
---

<section class="section-pad bg-ink text-paper overflow-hidden" data-track-section="trust">
  <div class="shell-wide">
    <div class="trust-intro" data-reveal="up">
      <div><p class="eyebrow text-accent">{copy.eyebrow}</p><h2>{copy.title}</h2></div>
      <p>{copy.body}</p>
    </div>

    <div class="trust-items" data-reveal="up" style="--reveal-delay:70ms">
      {
        copy.items.map(([title, body], index) => (
          <article>
            <>
              <span>0{index + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </>
          </article>
        ))
      }
    </div>

    {
      realClients.length > 0 && (
        <div class="client-proof" data-reveal="up" style="--reveal-delay:120ms">
          <div>
            <>
              <span>{copy.proof}</span>
              <small>{copy.honest}</small>
            </>
          </div>
          <div>
            {realClients.map((client) =>
              client.href ? (
                <a href={client.href} target="_blank" rel="noopener noreferrer">
                  {client.name}
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <strong>{client.name}</strong>
              ),
            )}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .trust-intro {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(2.8rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }
  .trust-intro h2 {
    max-width: 15ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.052em;
  }
  .trust-intro > p {
    max-width: 42rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: clamp(1rem, 1.2vw, 1.14rem);
    line-height: 1.75;
  }
  .trust-items {
    display: grid;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }
  .trust-items article {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .trust-items article:last-child {
    border-bottom: 0;
  }
  .trust-items span {
    color: #93a6ff;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .trust-items h3 {
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .trust-items p {
    max-width: 27rem;
    margin-top: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .client-proof {
    display: grid;
    gap: 1.5rem;
    padding-top: 2rem;
  }
  .client-proof > div:first-child {
    display: grid;
    gap: 0.45rem;
  }
  .client-proof > div:first-child span {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .client-proof small {
    color: rgba(255, 255, 255, 0.34);
    font-size: 0.67rem;
  }
  .client-proof > div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .client-proof a,
  .client-proof strong {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }
  .client-proof a:hover {
    border-color: #93a6ff;
    color: #fff;
  }
  .client-proof a span {
    color: #93a6ff;
    font-size: 0.72rem;
  }
  @media (min-width: 768px) {
    .trust-items {
      grid-template-columns: repeat(3, 1fr);
    }
    .trust-items article {
      padding: 2.4rem 2rem;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 0;
    }
    .trust-items article:first-child {
      padding-left: 0;
    }
    .trust-items article:last-child {
      padding-right: 0;
      border-right: 0;
    }
    .client-proof {
      grid-template-columns: 0.75fr 1.25fr;
      align-items: center;
    }
    .client-proof > div:last-child {
      justify-content: flex-end;
    }
  }
  @media (min-width: 1024px) {
    .trust-intro {
      grid-template-columns: 1.06fr 0.94fr;
      gap: 5rem;
    }
  }
</style>
