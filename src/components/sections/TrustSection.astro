---
import type { Locale } from '@/config/site';
import { clients } from '@/content/clients';
import SliderControls from '@/components/ui/SliderControls.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Apa arti partner?',
        title: 'Ada yang tetap memikirkan hasil, bukan hanya fitur.',
        body: 'Digvation ikut memahami cara bisnis berjalan, menjaga prioritas, dan bertanggung jawab sampai solusinya bisa digunakan.',
        items: [
          [
            'Masalah dibaca sebelum solusi dipilih',
            'Proses, orang, data, dan hambatan dilihat lebih dulu.',
          ],
          [
            'Keputusan dibuat dengan bahasa bisnis',
            'Scope, prioritas, dan risiko dibahas tanpa jargon teknis.',
          ],
          [
            'Hubungan tidak berhenti saat live',
            'Solusi bisa dirawat dan ditingkatkan saat kebutuhan bisnis berubah.',
          ],
        ],
        proof: 'Client Digvation',
        clientNote: 'Bisnis dan tim yang pernah bekerja bersama kami.',
        visit: 'Kunjungi website',
      }
    : {
        eyebrow: 'What does partnership mean?',
        title: 'Someone stays focused on the outcome, not only the features.',
        body: 'Digvation learns how the business works, keeps priorities clear, and stays accountable until the solution can be used.',
        items: [
          [
            'Understand the problem before choosing the solution',
            'Process, people, data, and friction come first.',
          ],
          [
            'Make decisions in business language',
            'Scope, priority, and risk are discussed without technical jargon.',
          ],
          [
            'Stay involved after launch',
            'The solution can improve as the needs of the business change.',
          ],
        ],
        proof: 'Digvation clients',
        clientNote: 'Businesses and teams we have worked with.',
        visit: 'Visit website',
      };
---

<section class="section-pad bg-ink text-paper overflow-hidden" data-track-section="trust">
  <div class="shell-wide">
    <div class="trust-intro" data-reveal="up">
      <div><p class="eyebrow text-accent">{copy.eyebrow}</p><h2>{copy.title}</h2></div>
      <p>{copy.body}</p>
    </div>

    <div class="trust-controls" data-reveal="up" style="--reveal-delay:50ms">
      <SliderControls
        controls={`trust-slider-${locale}`}
        count={copy.items.length}
        locale={locale}
        tone="dark"
      />
    </div>

    <div
      class="trust-items"
      id={`trust-slider-${locale}`}
      data-slider-rail
      data-reveal="up"
      style="--reveal-delay:70ms"
    >
      {
        copy.items.map(([title, body], index) => (
          <article data-slider-slide>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))
      }
    </div>

    {
      clients.length > 0 && (
        <div class="client-proof" data-reveal="up" style="--reveal-delay:120ms">
          <header class="client-proof__head">
            <span>{copy.proof}</span>
            <p>{copy.clientNote}</p>
          </header>

          <ul class="client-logo-wall" aria-label={copy.proof}>
            {clients.map((client) => (
              <li>
                <a
                  href={client.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${copy.visit}: ${client.name}`}
                >
                  <img
                    class:list={[
                      'client-logo',
                      client.logoType === 'mark' ? 'client-logo--mark' : 'client-logo--wordmark',
                    ]}
                    src={client.logo}
                    alt={client.name}
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .trust-intro {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(2.8rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }
  .trust-intro h2 {
    max-width: 15ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.052em;
  }
  .trust-intro > p {
    max-width: 42rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: clamp(1rem, 1.2vw, 1.14rem);
    line-height: 1.75;
  }
  .trust-items {
    display: grid;
    grid-auto-columns: min(82vw, 27rem);
    grid-auto-flow: column;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 0 0 1.4rem;
    padding-right: calc(100% - min(82vw, 27rem));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .trust-items::-webkit-scrollbar {
    display: none;
  }
  .trust-controls {
    padding-block: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }
  .trust-items article {
    min-height: 18rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.035);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .trust-items article:nth-child(2) {
    background: rgba(147, 166, 255, 0.08);
  }
  .trust-items span {
    color: #93a6ff;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .trust-items h3 {
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .trust-items p {
    max-width: 27rem;
    margin-top: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .client-proof {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .client-proof__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.25rem;
  }
  .client-proof__head span,
  .client-proof__head p {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .client-proof__head span {
    color: var(--color-accent);
  }
  .client-proof__head p {
    color: rgba(255, 255, 255, 0.4);
  }
  .client-logo-wall {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    list-style: none;
  }
  .client-logo-wall li {
    min-width: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .client-logo-wall li:last-child {
    border-bottom: 0;
  }
  .client-logo-wall a {
    position: relative;
    display: grid;
    min-height: clamp(9rem, 15vw, 12rem);
    place-items: center;
    overflow: hidden;
    padding: 2rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 240ms ease;
  }
  .client-logo-wall a::before {
    position: absolute;
    right: 50%;
    bottom: 0;
    left: 50%;
    height: 2px;
    background: var(--color-accent);
    content: '';
    transition:
      right 480ms cubic-bezier(0.22, 1, 0.36, 1),
      left 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .client-logo-wall a:hover {
    background: rgba(147, 166, 255, 0.055);
  }
  .client-logo-wall a:hover::before {
    right: 0;
    left: 0;
  }
  .client-logo {
    display: block;
    object-fit: contain;
    opacity: 0.56;
    filter: grayscale(1) brightness(3.8);
    transition:
      opacity 240ms ease,
      filter 320ms ease,
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .client-logo--wordmark {
    width: min(14rem, 72%);
    max-height: 5.5rem;
  }
  .client-logo--mark {
    width: min(5.75rem, 38%);
    max-height: 5.75rem;
  }
  .client-logo-wall a:hover .client-logo {
    opacity: 1;
    filter: none;
    transform: translateY(-0.2rem);
  }
  @media (min-width: 768px) {
    .trust-controls {
      display: none;
    }
    .trust-items {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-columns: auto;
      grid-auto-flow: row;
      gap: 0;
      overflow: visible;
      padding: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    }
    .trust-items article {
      min-height: 0;
      padding: 2.4rem 2rem;
      border: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      background: transparent;
    }
    .trust-items article:first-child {
      padding-left: 0;
    }
    .trust-items article:last-child {
      padding-right: 0;
      border-right: 0;
    }
    .client-logo-wall {
      grid-template-columns: repeat(2, 1fr);
    }
    .client-logo-wall li {
      border-right: 1px solid rgba(255, 255, 255, 0.12);
      border-bottom: 0;
    }
    .client-logo-wall li:last-child {
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .trust-intro {
      grid-template-columns: 1.06fr 0.94fr;
      gap: 5rem;
    }
  }
  @media (max-width: 640px) {
    .client-proof__head {
      display: grid;
      gap: 0.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-logo-wall a,
    .client-logo-wall a::before,
    .client-logo {
      transition: none;
    }
    .client-logo-wall a:hover .client-logo {
      transform: none;
    }
  }
</style>
