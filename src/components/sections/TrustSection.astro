---
import type { Locale } from '@/config/site';
import { getLocalizedPath } from '@/config/navigation';
import { getFeaturedWorkEntries } from '@/lib/content/catalog';
import { resolveWorkPreview } from '@/lib/content/work-preview';
import SliderControls from '@/components/ui/SliderControls.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const realProjects = (await getFeaturedWorkEntries(locale, 2)).map((entry, index) => {
  const preview = resolveWorkPreview(entry.data);
  const href =
    preview.liveUrl ??
    (entry.data.entryType === 'case-study'
      ? getLocalizedPath(locale, `/work/${entry.data.routeSlug}`)
      : getLocalizedPath(locale, '/work'));
  const domain = preview.liveUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
  const initials = entry.data.title
    .split(/\s+/)
    .map((word) => word[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

  return {
    index,
    title: entry.data.title,
    client: entry.data.client,
    summary: entry.data.summary,
    projectType: entry.data.projectType,
    year: entry.data.year,
    variant: entry.data.visualVariant,
    href,
    domain,
    initials,
  };
});
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Apa arti partner?',
        title: 'Ada yang tetap memikirkan hasil, bukan hanya fitur.',
        body: 'Digvation ikut memahami cara bisnis berjalan, menjaga prioritas, dan bertanggung jawab sampai solusinya bisa digunakan.',
        items: [
          [
            'Masalah dibaca sebelum solusi dipilih',
            'Proses, orang, data, dan hambatan dilihat lebih dulu.',
          ],
          [
            'Keputusan dibuat dengan bahasa bisnis',
            'Scope, prioritas, dan risiko dibahas tanpa jargon teknis.',
          ],
          [
            'Hubungan tidak berhenti saat live',
            'Solusi bisa dirawat dan ditingkatkan saat kebutuhan bisnis berubah.',
          ],
        ],
        proof: 'Bisnis yang sudah kami bantu',
        honest: 'Project terpilih yang dapat Anda lihat langsung.',
        live: 'Project live',
        view: 'Kunjungi project',
      }
    : {
        eyebrow: 'What does partnership mean?',
        title: 'Someone stays focused on the outcome, not only the features.',
        body: 'Digvation learns how the business works, keeps priorities clear, and stays accountable until the solution can be used.',
        items: [
          [
            'Understand the problem before choosing the solution',
            'Process, people, data, and friction come first.',
          ],
          [
            'Make decisions in business language',
            'Scope, priority, and risk are discussed without technical jargon.',
          ],
          [
            'Stay involved after launch',
            'The solution can improve as the needs of the business change.',
          ],
        ],
        proof: 'Businesses we have helped',
        honest: 'Selected projects you can visit directly.',
        live: 'Live project',
        view: 'Visit project',
      };
---

<section class="section-pad bg-ink text-paper overflow-hidden" data-track-section="trust">
  <div class="shell-wide">
    <div class="trust-intro" data-reveal="up">
      <div><p class="eyebrow text-accent">{copy.eyebrow}</p><h2>{copy.title}</h2></div>
      <p>{copy.body}</p>
    </div>

    <div class="trust-controls" data-reveal="up" style="--reveal-delay:50ms">
      <SliderControls
        controls={`trust-slider-${locale}`}
        count={copy.items.length}
        locale={locale}
        tone="dark"
      />
    </div>

    <div
      class="trust-items"
      id={`trust-slider-${locale}`}
      data-slider-rail
      data-reveal="up"
      style="--reveal-delay:70ms"
    >
      {
        copy.items.map(([title, body], index) => (
          <article data-slider-slide>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))
      }
    </div>

    {
      realProjects.length > 0 && (
        <div class="client-proof" data-reveal="up" style="--reveal-delay:120ms">
          <header class="client-proof__head">
            <div>
              <span>{copy.proof}</span>
              <strong>{copy.honest}</strong>
            </div>
            <p>SELECTED WORK / {String(realProjects.length).padStart(2, '0')}</p>
          </header>

          <div class="client-projects">
            {realProjects.map((project) => (
              <a
                class:list={['client-project', `client-project--${project.variant}`]}
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${copy.view}: ${project.title}`}
              >
                <div class="client-project__top">
                  <span>
                    0{project.index + 1} / {copy.live}
                  </span>
                  <span>{project.year}</span>
                </div>

                <div class="client-project__visual" aria-hidden="true">
                  <strong>{project.initials}</strong>
                  <div>
                    <span>DIGVATION / SELECTED WORK</span>
                    <b>{project.projectType}</b>
                    <i />
                    <i />
                    <i />
                  </div>
                </div>

                <div class="client-project__copy">
                  <h3>{project.client}</h3>
                  <p>{project.summary}</p>
                </div>

                <div class="client-project__footer">
                  <span>{project.domain ?? project.projectType}</span>
                  <strong>{copy.view} ↗</strong>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .trust-intro {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(2.8rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }
  .trust-intro h2 {
    max-width: 15ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.052em;
  }
  .trust-intro > p {
    max-width: 42rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: clamp(1rem, 1.2vw, 1.14rem);
    line-height: 1.75;
  }
  .trust-items {
    display: grid;
    grid-auto-columns: min(82vw, 27rem);
    grid-auto-flow: column;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 0 0 1.4rem;
    padding-right: calc(100% - min(82vw, 27rem));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .trust-items::-webkit-scrollbar {
    display: none;
  }
  .trust-controls {
    padding-block: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }
  .trust-items article {
    min-height: 18rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.035);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .trust-items article:nth-child(2) {
    background: rgba(147, 166, 255, 0.08);
  }
  .trust-items span {
    color: #93a6ff;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .trust-items h3 {
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .trust-items p {
    max-width: 27rem;
    margin-top: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .client-proof {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .client-proof__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.35rem;
  }
  .client-proof__head > div {
    display: grid;
    gap: 0.45rem;
  }
  .client-proof__head span,
  .client-proof__head p {
    margin: 0;
    color: rgba(255, 255, 255, 0.44);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .client-proof__head span {
    color: var(--color-accent);
  }
  .client-proof__head strong {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.78rem;
    font-weight: 550;
  }
  .client-projects {
    display: grid;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .client-project {
    display: grid;
    min-width: 0;
    gap: 1.3rem;
    padding: clamp(1.15rem, 2.2vw, 1.8rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    color: inherit;
    text-decoration: none;
  }
  .client-project:last-child {
    border-bottom: 0;
  }
  .client-project__top,
  .client-project__footer {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.43);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .client-project__top span:first-child {
    color: var(--color-accent);
  }
  .client-project__visual {
    position: relative;
    display: grid;
    min-height: 11rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #17213a;
  }
  .client-project--paper .client-project__visual {
    background: #e9e8e2;
    color: #121a2f;
  }
  .client-project--ink .client-project__visual {
    background: #15171c;
  }
  .client-project__visual > strong {
    position: absolute;
    top: 50%;
    left: 8%;
    color: rgba(147, 166, 255, 0.13);
    font-family: var(--font-display);
    font-size: clamp(5rem, 10vw, 8.5rem);
    line-height: 0.7;
    letter-spacing: -0.09em;
    transform: translateY(-50%);
  }
  .client-project--paper .client-project__visual > strong {
    color: rgba(18, 26, 47, 0.1);
  }
  .client-project__visual > div {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(72%, 22rem);
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(11, 13, 16, 0.42);
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.2);
    transform: translateX(8%);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .client-project--paper .client-project__visual > div {
    border-color: rgba(18, 26, 47, 0.16);
    background: rgba(255, 255, 255, 0.74);
    box-shadow: 0 1.25rem 3rem rgba(18, 26, 47, 0.12);
  }
  .client-project__visual span {
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.48rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }
  .client-project--paper .client-project__visual span {
    color: rgba(18, 26, 47, 0.48);
  }
  .client-project__visual b {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 620;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .client-project__visual i {
    display: block;
    width: 88%;
    height: 1px;
    background: currentColor;
    opacity: 0.16;
  }
  .client-project__visual i:nth-last-child(2) {
    width: 68%;
  }
  .client-project__visual i:last-child {
    width: 46%;
  }
  .client-project__copy h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
    font-weight: 620;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .client-project__copy p {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.76rem;
    line-height: 1.65;
  }
  .client-project__footer {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .client-project__footer span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .client-project__footer strong {
    flex: none;
    color: rgba(255, 255, 255, 0.78);
    transition: color 180ms ease;
  }
  .client-project:hover .client-project__visual > div {
    transform: translateX(8%) translateY(-0.3rem);
  }
  .client-project:hover .client-project__footer strong {
    color: var(--color-accent);
  }
  @media (min-width: 768px) {
    .trust-controls {
      display: none;
    }
    .trust-items {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-columns: auto;
      grid-auto-flow: row;
      gap: 0;
      overflow: visible;
      padding: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    }
    .trust-items article {
      min-height: 0;
      padding: 2.4rem 2rem;
      border: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      background: transparent;
    }
    .trust-items article:first-child {
      padding-left: 0;
    }
    .trust-items article:last-child {
      padding-right: 0;
      border-right: 0;
    }
    .client-projects {
      grid-template-columns: repeat(2, 1fr);
    }
    .client-project {
      border-right: 1px solid rgba(255, 255, 255, 0.14);
      border-bottom: 0;
    }
    .client-project:last-child {
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .trust-intro {
      grid-template-columns: 1.06fr 0.94fr;
      gap: 5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-project__visual > div,
    .client-project__footer strong {
      transition: none;
    }
    .client-project:hover .client-project__visual > div {
      transform: translateX(8%);
    }
  }
</style>
