---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['partner'] };
const { locale, copy } = Astro.props;
---

<section class="partner-section bg-paper text-ink" data-track-section="partner-model">
  <div class="shell-wide partner-section__inner">
    <header class="partner-section__intro" data-reveal="mask">
      <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <div>
        <p>{copy.body}</p>
        <a class="text-link" href={getLocalizedPath(locale, '/about')}>
          {copy.linkLabel}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <ol class="partner-section__path" data-reveal-group>
      {
        copy.items.map((item, index) => (
          <li data-reveal="line">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .partner-section__inner {
    padding-block: var(--space-section);
  }
  .partner-section__intro {
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(4.5rem, 8vw, 7.5rem);
  }
  .partner-section h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4.8vw, 4.9rem);
    font-weight: 545;
    line-height: 0.99;
    letter-spacing: -0.054em;
  }
  .partner-section__intro > div > p {
    max-width: 34rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.72;
  }
  .partner-section__intro .text-link {
    margin-top: 1.75rem;
  }
  .partner-section__path {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }
  .partner-section__path li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: clamp(1.65rem, 3vw, 2.4rem) 0;
  }
  .partner-section__path li > span {
    color: var(--text-soft);
    font-size: 0.59rem;
    font-weight: 780;
    letter-spacing: 0.08em;
  }
  .partner-section__path h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 2.25rem);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .partner-section__path p {
    max-width: 34rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.68;
  }
  @media (min-width: 900px) {
    .partner-section__intro {
      grid-template-columns: 0.25fr 0.9fr 0.62fr;
    }
  }
  @media (max-width: 680px) {
    .partner-section__path li {
      grid-template-columns: 2rem 1fr;
    }
    .partner-section__path h3,
    .partner-section__path p {
      grid-column: 2;
    }
  }
</style>
