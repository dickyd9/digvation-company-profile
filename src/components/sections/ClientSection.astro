---
import type { Locale } from '@/config/site';
import { clients } from '@/content/clients';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Client & kolaborasi',
        title: 'Brand dan tim yang pernah mempercayakan pekerjaan digitalnya kepada Digvation.',
        label: 'Client yang pernah bekerja bersama Digvation',
        hint: 'Geser untuk melihat lainnya',
        visit: 'Kunjungi website',
      }
    : {
        eyebrow: 'Clients & collaborations',
        title: 'Brands and teams that have trusted Digvation with their digital work.',
        label: 'Clients that have worked with Digvation',
        hint: 'Swipe to see more',
        visit: 'Visit website',
      };
const hasManyClients = clients.length > 4;
---

{
  clients.length > 0 && (
    <section
      class="client-section bg-paper text-ink"
      aria-labelledby={`client-section-title-${locale}`}
      data-track-section="clients"
    >
      <div class="shell-wide client-section__layout">
        <header class="client-section__intro" data-reveal="up">
          <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
          <h2 id={`client-section-title-${locale}`}>{copy.title}</h2>
          {hasManyClients && <small>{copy.hint} →</small>}
        </header>

        <div class="client-section__rail" data-reveal="up" style="--reveal-delay:70ms">
          <ul
            class:list={['client-logo-grid', hasManyClients && 'client-logo-grid--many']}
            aria-label={copy.label}
            tabindex={hasManyClients ? '0' : undefined}
            style={`--client-count:${Math.min(clients.length, 4)}`}
          >
            {clients.map((client) => (
              <li>
                <a
                  href={client.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${copy.visit}: ${client.name}`}
                >
                  <img
                    class:list={[
                      'client-logo',
                      client.logoType === 'mark' ? 'client-logo--mark' : 'client-logo--wordmark',
                    ]}
                    src={client.logo}
                    alt={client.name}
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

<style>
  .client-section {
    border-bottom: 1px solid rgba(11, 13, 16, 0.1);
  }
  .client-section__layout {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.4rem, 4.5vw, 4rem);
  }
  .client-section__intro {
    display: grid;
    align-content: center;
  }
  .client-section__intro h2 {
    max-width: 31rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.1vw, 1.8rem);
    font-weight: 620;
    line-height: 1.18;
    letter-spacing: -0.035em;
  }
  .client-section__intro small {
    margin-top: 0.85rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.65rem;
    font-weight: 750;
  }
  .client-section__rail {
    min-width: 0;
    border-top: 1px solid rgba(11, 13, 16, 0.13);
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
  }
  .client-logo-grid {
    display: grid;
    grid-template-columns: repeat(var(--client-count, 2), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .client-logo-grid li {
    min-width: 0;
    border-right: 1px solid rgba(11, 13, 16, 0.1);
  }
  .client-logo-grid li:last-child {
    border-right: 0;
  }
  .client-logo-grid--many {
    grid-template-rows: repeat(2, minmax(6rem, 1fr));
    grid-auto-columns: minmax(8rem, 1fr);
    grid-auto-flow: column;
    grid-template-columns: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: rgba(18, 26, 47, 0.25) transparent;
  }
  .client-logo-grid--many li {
    min-width: 8rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.1);
    scroll-snap-align: start;
  }
  .client-logo-grid a {
    position: relative;
    display: grid;
    min-height: clamp(6.5rem, 9vw, 8rem);
    place-items: center;
    overflow: hidden;
    padding: 1.25rem;
    background: transparent;
    text-decoration: none;
    transition: background-color 220ms ease;
  }
  .client-logo-grid a::after {
    position: absolute;
    right: 50%;
    bottom: 0;
    left: 50%;
    height: 2px;
    background: #5367ee;
    content: '';
    transition:
      right 440ms cubic-bezier(0.22, 1, 0.36, 1),
      left 440ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .client-logo-grid a:hover {
    background: #f5f5f3;
  }
  .client-logo-grid a:hover::after {
    right: 0;
    left: 0;
  }
  .client-logo {
    display: block;
    object-fit: contain;
    opacity: 0.52;
    filter: grayscale(1);
    transition:
      opacity 220ms ease,
      filter 300ms ease,
      transform 440ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .client-logo--wordmark {
    width: min(9.5rem, 72%);
    max-height: 3.8rem;
  }
  .client-logo--mark {
    width: min(3.9rem, 34%);
    max-height: 3.9rem;
  }
  .client-logo-grid a:hover .client-logo {
    opacity: 1;
    filter: none;
    transform: translateY(-0.15rem);
  }
  @media (min-width: 820px) {
    .client-section__layout {
      grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
      align-items: stretch;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }
  @media (max-width: 819px) {
    .client-logo-grid {
      --client-count: 2;
    }
  }
  @media (max-width: 520px) {
    .client-logo-grid a {
      min-height: 6rem;
      padding: 1rem;
    }
  }
  @media (min-width: 820px) {
    .client-logo-grid--many {
      grid-template-rows: repeat(2, minmax(6.5rem, 1fr));
      grid-auto-columns: minmax(10rem, 1fr);
    }
    .client-logo-grid--many li {
      min-width: 10rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-logo-grid a,
    .client-logo-grid a::after,
    .client-logo {
      transition: none;
    }
    .client-logo-grid a:hover .client-logo {
      transform: none;
    }
  }
</style>
