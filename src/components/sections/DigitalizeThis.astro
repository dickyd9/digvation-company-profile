---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';
import SliderControls from '@/components/ui/SliderControls.astro';

type Props = { copy: HomeCopy['digitalize']; locale?: Locale };
const { copy, locale = 'id' } = Astro.props;
---

<section class="section-pad bg-paper text-ink" id="digitalize" data-track-section="digitalize-this">
  <div class="shell-wide">
    <header class="digitalize-head" data-reveal="up">
      <div>
        <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
        <h2 class="display-xl mt-4 max-w-[14ch]">{copy.title}</h2>
      </div>
      <div>
        <p class="body-lg text-dark-muted m-0 max-w-2xl">{copy.intro}</p>
        <a
          class="border-ink text-ink mt-6 inline-flex items-center gap-3 border-b pb-1 text-sm font-extrabold no-underline"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_clicked"
          data-track-label="problem-section"
        >
          {copy.linkLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="signal-controls" data-reveal="up" style="--reveal-delay:60ms">
      <SliderControls
        controls={`digitalize-slider-${locale}`}
        count={copy.items.length}
        locale={locale}
      />
    </div>

    <div class="signal-list" id={`digitalize-slider-${locale}`} data-slider-rail>
      {
        copy.items.map((item, index) => (
          <article
            class="signal-row"
            data-slider-slide
            data-reveal="up"
            style={`--reveal-delay:${Math.min(index * 60, 120)}ms`}
          >
            <div class="signal-topline">
              <span class="signal-number">{item.index}</span>
              <p>{copy.signalLabel}</p>
            </div>
            <h3>{item.signal}</h3>
            <div class="signal-response">
              <p>{copy.responseLabel}</p>
              <strong>{item.response}</strong>
            </div>
          </article>
        ))
      }
    </div>

    <p class="scope-note" data-reveal="up">{copy.note}</p>
  </div>
</section>

<style>
  .digitalize-head {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
  }
  .signal-controls {
    padding-block: 1.25rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
  }
  .signal-list {
    display: grid;
    grid-auto-columns: min(82vw, 33rem);
    grid-auto-flow: column;
    gap: 0.9rem;
    overflow-x: auto;
    padding: 1.1rem calc(100% - min(82vw, 33rem)) 1.6rem 0;
    scroll-padding-inline: 0.1rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .signal-list::-webkit-scrollbar {
    display: none;
  }
  .signal-row {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: clamp(22rem, 34vw, 29rem);
    gap: 1.7rem;
    padding: clamp(1.5rem, 2.5vw, 2.2rem);
    border: 1px solid rgba(11, 13, 16, 0.14);
    background: #fff;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .signal-row:nth-child(2) {
    background: #f3f4f7;
  }
  .signal-row:nth-child(3) {
    background: #e8ebff;
  }
  .signal-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .signal-number {
    color: rgba(78, 101, 243, 0.52);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }
  .signal-row p {
    margin: 0;
    color: rgba(11, 13, 16, 0.38);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .signal-row h3 {
    max-width: 19ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 3.25rem);
    font-weight: 620;
    line-height: 1.04;
    letter-spacing: -0.047em;
  }
  .signal-row strong {
    display: block;
    max-width: 40rem;
    margin-top: 0.7rem;
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.88rem;
    font-weight: 550;
    line-height: 1.75;
  }
  .signal-response {
    padding-top: 1.2rem;
    border-top: 1px solid rgba(11, 13, 16, 0.13);
  }
  .scope-note {
    max-width: 54rem;
    margin: clamp(2.2rem, 4vw, 3.5rem) 0 0 auto;
    padding-left: 1rem;
    border-left: 2px solid #5367ee;
    color: rgba(11, 13, 16, 0.54);
    font-size: 0.82rem;
    line-height: 1.75;
  }
  @media (min-width: 1024px) {
    .digitalize-head {
      grid-template-columns: 0.92fr 1.08fr;
      align-items: end;
      gap: 5rem;
    }
    .signal-list {
      grid-auto-columns: calc((100% - 1.8rem) / 2.45);
      padding-right: calc(100% - ((100% - 1.8rem) / 2.45));
    }
  }
</style>
