---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';
import SliderControls from '@/components/ui/SliderControls.astro';
import ProblemScene from '@/components/ui/ProblemScene.astro';

type Props = { copy: HomeCopy['digitalize']; locale?: Locale };
const { copy, locale = 'id' } = Astro.props;
---

<section class="section-pad bg-paper text-ink" id="digitalize" data-track-section="digitalize-this">
  <div class="shell-wide">
    <header class="digitalize-head" data-reveal="up">
      <div>
        <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
        <h2 class="display-xl mt-4 max-w-[14ch]">{copy.title}</h2>
      </div>
      <div>
        <p class="body-lg text-dark-muted m-0 max-w-2xl">{copy.intro}</p>
        <a
          class="border-ink text-ink mt-6 inline-flex items-center gap-3 border-b pb-1 text-sm font-extrabold no-underline"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_clicked"
          data-track-label="problem-section"
        >
          {copy.linkLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="signal-controls" data-reveal="up" style="--reveal-delay:60ms">
      <p class="slider-note" aria-hidden="true">
        {copy.visualNote}
        <span>↘</span>
      </p>
      <div>
        <SliderControls
          controls={`digitalize-slider-${locale}`}
          count={copy.items.length}
          locale={locale}
        />
      </div>
    </div>

    <div
      class="signal-list"
      id={`digitalize-slider-${locale}`}
      data-slider-rail
      role="region"
      aria-roledescription="carousel"
      aria-label={locale === 'id' ? 'Contoh masalah bisnis' : 'Business problem examples'}
      tabindex="0"
    >
      {
        copy.items.map((item, index) => (
          <article
            class="signal-row"
            data-slider-slide
            data-reveal="up"
            role="group"
            aria-roledescription="slide"
            aria-posinset={index + 1}
            aria-setsize={copy.items.length}
            aria-labelledby={`signal-title-${locale}-${index}`}
            style={`--reveal-delay:${Math.min(index * 60, 120)}ms`}
          >
            <div class="signal-copy">
              <div class="signal-topline">
                <span class="signal-number">{item.index}</span>
                <p>{copy.signalLabel}</p>
              </div>
              <h3 id={`signal-title-${locale}-${index}`}>{item.signal}</h3>
              <div class="signal-response">
                <p>{copy.responseLabel}</p>
                <strong>{item.response}</strong>
              </div>
            </div>

            <div class="signal-visual">
              <ProblemScene kind={item.preview} locale={locale} />
            </div>
          </article>
        ))
      }
    </div>

    <p class="scope-note" data-reveal="up">{copy.note}</p>
  </div>
</section>

<style>
  .digitalize-head {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
  }
  .signal-controls {
    display: grid;
    gap: 1rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
  }
  .slider-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.72);
    font-family: var(--font-hand);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    line-height: 1;
    transform: rotate(-1.5deg);
  }
  .slider-note span {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 1rem;
    transform: translateY(0.25rem) rotate(5deg);
  }
  .signal-list {
    display: grid;
    grid-auto-columns: min(84vw, 68rem);
    grid-auto-flow: column;
    gap: 1rem;
    overflow-x: auto;
    padding: 1.1rem calc(100% - min(84vw, 68rem)) 1.8rem 0;
    scroll-padding-inline: 0;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .signal-list::-webkit-scrollbar {
    display: none;
  }
  .signal-list:focus-visible {
    outline: 2px solid var(--color-indigo-deep);
    outline-offset: 4px;
  }
  .signal-row {
    display: grid;
    min-height: 34rem;
    overflow: hidden;
    border: 1px solid rgba(11, 13, 16, 0.14);
    background: #fff;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .signal-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 3rem);
  }
  .signal-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .signal-number {
    color: rgba(78, 101, 243, 0.52);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }
  .signal-row p {
    margin: 0;
    color: rgba(11, 13, 16, 0.38);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .signal-row h3 {
    max-width: 18ch;
    margin: clamp(2.5rem, 5vw, 5rem) 0 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.65rem);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .signal-row strong {
    display: block;
    max-width: 34rem;
    margin-top: 0.7rem;
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.88rem;
    font-weight: 550;
    line-height: 1.75;
  }
  .signal-response {
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(11, 13, 16, 0.13);
  }
  .signal-visual {
    min-width: 0;
  }
  .scope-note {
    max-width: 54rem;
    margin: clamp(2.2rem, 4vw, 3.5rem) 0 0 auto;
    padding-left: 1rem;
    border-left: 2px solid #5367ee;
    color: rgba(11, 13, 16, 0.54);
    font-size: 0.82rem;
    line-height: 1.75;
  }
  @media (min-width: 1024px) {
    .digitalize-head {
      grid-template-columns: 0.92fr 1.08fr;
      align-items: end;
      gap: 5rem;
    }
    .signal-controls {
      grid-template-columns: minmax(18rem, auto) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
    .signal-list {
      grid-auto-columns: min(78vw, 68rem);
      padding-right: calc(100% - min(78vw, 68rem));
    }
    .signal-row {
      grid-template-columns: minmax(22rem, 0.9fr) minmax(32rem, 1.1fr);
    }
  }
  @media (max-width: 699px) {
    .signal-row {
      min-height: auto;
    }
    .signal-row h3 {
      margin-top: 2.5rem;
    }
  }
</style>
