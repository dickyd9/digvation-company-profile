---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['solutions'] };
const { locale, copy } = Astro.props;
---

<section class="solution-areas bg-paper text-ink" data-track-section="solutions">
  <div class="shell-wide section-pad">
    <header class="solution-areas__intro" data-reveal="up">
      <div>
        <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
      </div>
      <div>
        <p>{copy.intro}</p>
        <small>{copy.prompt}</small>
      </div>
    </header>

    <div class="solution-areas__list" data-solution-list>
      {
        copy.items.map((item, index) => (
          <details class="solution-row" open={index === 0} data-solution-row>
            <summary>
              <span class="solution-row__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="solution-row__verb">{item.verb}</span>
              <strong>{item.title}</strong>
              <span class="solution-row__toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="solution-row__detail">
              <p>{item.body}</p>
              <small>{item.examples}</small>
            </div>
          </details>
        ))
      }
    </div>

    <a class="text-link solution-areas__link" href={getLocalizedPath(locale, '/solutions')}>
      {copy.linkLabel}<span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .solution-areas__intro {
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .solution-areas__intro h2 {
    max-width: 15ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.4vw, 5.7rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.058em;
  }
  .solution-areas__intro p {
    max-width: 35rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.96rem;
    line-height: 1.75;
  }
  .solution-areas__intro small {
    display: block;
    margin-top: 1rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.69rem;
    font-weight: 750;
  }
  .solution-areas__list {
    border-top: 1px solid rgba(11, 13, 16, 0.16);
  }
  .solution-row {
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
  }
  .solution-row summary {
    display: grid;
    grid-template-columns: 3rem minmax(5rem, 0.35fr) minmax(0, 1fr) 2rem;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.35rem, 2.5vw, 2rem) 0;
    cursor: pointer;
    list-style: none;
  }
  .solution-row summary::-webkit-details-marker {
    display: none;
  }
  .solution-row__index {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .solution-row__verb {
    color: var(--color-indigo-deep);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 800;
  }
  .solution-row strong {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.9vw, 2.75rem);
    font-weight: 620;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }
  .solution-row__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(11, 13, 16, 0.18);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 400;
    transition:
      transform 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }
  .solution-row[open] .solution-row__toggle {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: rotate(45deg);
  }
  .solution-row__detail {
    display: grid;
    grid-template-columns: 3rem minmax(5rem, 0.35fr) minmax(0, 1fr) 2rem;
    gap: 1rem 1.25rem;
    padding: 0 0 1.75rem;
  }
  .solution-row__detail p {
    grid-column: 3;
    max-width: 38rem;
    margin: 0 0 0 auto;
    color: rgba(11, 13, 16, 0.6);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .solution-row__detail small {
    grid-column: 3;
    max-width: 38rem;
    margin-left: auto;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.03em;
  }
  .solution-areas__link {
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .solution-areas__intro {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }
  @media (max-width: 760px) {
    .solution-row summary {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: 0.75rem;
    }
    .solution-row__verb {
      grid-column: 2;
    }
    .solution-row strong {
      grid-column: 2;
    }
    .solution-row__toggle {
      grid-row: 1 / span 2;
      grid-column: 3;
    }
    .solution-row__detail {
      display: block;
      padding: 0 0 1.5rem 2.75rem;
    }
    .solution-row__detail p,
    .solution-row__detail small {
      margin-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-row__toggle {
      transition: none;
    }
  }
</style>

<script>
  const setupSolutionList = () => {
    document.querySelectorAll<HTMLElement>('[data-solution-list]').forEach((list) => {
      if (list.dataset.ready === 'true') return;
      list.dataset.ready = 'true';
      list.querySelectorAll<HTMLDetailsElement>('[data-solution-row]').forEach((row) => {
        row.addEventListener('toggle', () => {
          if (!row.open) return;
          list.querySelectorAll<HTMLDetailsElement>('[data-solution-row]').forEach((other) => {
            if (other !== row) other.open = false;
          });
        });
      });
    });
  };
  setupSolutionList();
  document.addEventListener('astro:page-load', setupSolutionList);
</script>
