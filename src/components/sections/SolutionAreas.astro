---
import ChapterMarker from '@/components/ui/ChapterMarker.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['solutions'] };
const { locale, copy } = Astro.props;
---

<section class="solution-areas bg-paper-warm text-ink" data-track-section="solutions">
  <ChapterMarker current={4} align="left" />
  <div class="shell-wide solution-areas__layout">
    <header class="solution-areas__intro" data-reveal="mask">
      <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p>{copy.intro}</p>
      <small>{copy.prompt}</small>
      <a class="text-link" href={getLocalizedPath(locale, '/solutions')}>
        {copy.linkLabel}<span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="solution-areas__list" data-solution-list data-reveal="line">
      {
        copy.items.map((item, index) => (
          <details class="solution-row" open={index === 0} data-solution-row>
            <summary>
              <span class="solution-row__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="solution-row__verb">{item.verb}</span>
              <span class="solution-row__toggle" aria-hidden="true">
                <>
                  <i />
                  <i />
                </>
              </span>
            </summary>
            <div class="solution-row__detail">
              <strong>{item.title}</strong>
              <p>{item.body}</p>
              <small>{item.examples}</small>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .solution-areas {
    position: relative;
    border-top: 1px solid rgba(11, 13, 16, 0.1);
  }
  .solution-areas__layout {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: var(--space-section);
  }
  .solution-areas__intro h2 {
    max-width: 14ch;
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 4.4vw, 4.45rem);
    font-weight: 545;
    line-height: 1;
    letter-spacing: -0.052em;
  }
  .solution-areas__intro > p:not(.eyebrow) {
    max-width: 29rem;
    margin: 1.6rem 0 0;
    color: var(--text-muted);
    font-size: 0.91rem;
    line-height: 1.7;
  }
  .solution-areas__intro > small {
    display: block;
    margin-top: 0.5rem;
    color: rgba(11, 13, 16, 0.46);
    font-size: 0.65rem;
    font-weight: 700;
  }
  .solution-areas__intro .text-link {
    margin-top: 2.2rem;
  }
  .solution-areas__list {
    align-self: start;
    border-top: 1px solid rgba(11, 13, 16, 0.18);
  }
  .solution-row {
    overflow: clip;
    border-bottom: 1px solid rgba(11, 13, 16, 0.18);
  }
  .solution-row summary {
    display: grid;
    min-height: 5rem;
    grid-template-columns: 2.25rem minmax(0, 1fr) 2rem;
    gap: 1rem;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }
  .solution-row summary::-webkit-details-marker {
    display: none;
  }
  .solution-row__index {
    color: rgba(11, 13, 16, 0.42);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .solution-row__verb {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.85rem);
    font-weight: 550;
    letter-spacing: -0.045em;
    transition: color 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .solution-row__toggle {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }
  .solution-row__toggle i {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: 1rem;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .solution-row__toggle i:last-child {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .solution-row[open]:not([data-enhanced='true']) .solution-row__verb,
  .solution-row[data-expanded='true'] .solution-row__verb {
    color: var(--color-indigo-deep);
  }
  .solution-row[open]:not([data-enhanced='true']) .solution-row__toggle i:last-child,
  .solution-row[data-expanded='true'] .solution-row__toggle i:last-child {
    transform: translate(-50%, -50%) rotate(0);
  }
  .solution-row__detail {
    display: grid;
    gap: 0.85rem;
    padding: 0 2.5rem 2.1rem 3.25rem;
  }
  .solution-row__detail strong {
    max-width: 32rem;
    font-size: 0.96rem;
    font-weight: 650;
    line-height: 1.55;
  }
  .solution-row__detail p {
    max-width: 33rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .solution-row__detail small {
    color: rgba(11, 13, 16, 0.42);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.035em;
  }
  .solution-row[data-enhanced='true'] .solution-row__detail {
    opacity: 0;
    transform: translateY(-0.45rem);
    transition:
      opacity 280ms ease,
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .solution-row[data-enhanced='true'][data-expanded='true'] .solution-row__detail {
    opacity: 1;
    transform: translateY(0);
  }
  @media (min-width: 900px) {
    .solution-areas__layout {
      grid-template-columns: minmax(19rem, 0.82fr) minmax(0, 1.18fr);
      align-items: start;
    }
    .solution-areas__intro {
      position: sticky;
      top: 8rem;
    }
  }
  @media (max-width: 640px) {
    .solution-row summary {
      min-height: 4.5rem;
    }
    .solution-row__detail {
      padding-right: 1rem;
      padding-left: 3.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-row__verb,
    .solution-row__toggle i {
      transition: none;
    }
    .solution-row[data-enhanced='true'] .solution-row__detail {
      transition: none;
    }
  }
</style>

<script>
  const solutionAnimations = new WeakMap<HTMLDetailsElement, Animation>();

  const setSolutionRowState = (
    row: HTMLDetailsElement,
    expanded: boolean,
    reduceMotion: boolean,
  ) => {
    const summary = row.querySelector<HTMLElement>('summary');
    if (!summary) return;

    const currentHeight = row.getBoundingClientRect().height;
    solutionAnimations.get(row)?.cancel();
    row.style.height = '';
    row.style.overflow = '';
    row.dataset.expanded = String(expanded);

    if (reduceMotion || typeof row.animate !== 'function') {
      row.open = expanded;
      row.dataset.animating = 'false';
      return;
    }

    if (expanded) row.open = true;

    const borderHeight = row.offsetHeight - row.clientHeight;
    const targetHeight = expanded
      ? row.scrollHeight + borderHeight
      : summary.getBoundingClientRect().height + borderHeight;
    row.style.height = `${currentHeight}px`;
    row.style.overflow = 'hidden';
    row.dataset.animating = 'true';

    const animation = row.animate(
      [{ height: `${currentHeight}px` }, { height: `${targetHeight}px` }],
      {
        duration: 460,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      },
    );
    solutionAnimations.set(row, animation);

    animation.onfinish = () => {
      if (solutionAnimations.get(row) !== animation) return;
      if (!expanded) row.open = false;
      row.style.height = '';
      row.style.overflow = '';
      row.dataset.animating = 'false';
      solutionAnimations.delete(row);
    };
  };

  const setupSolutionList = () => {
    document.querySelectorAll<HTMLElement>('[data-solution-list]').forEach((list) => {
      if (list.dataset.ready === 'true') return;
      list.dataset.ready = 'true';
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

      list.querySelectorAll<HTMLDetailsElement>('[data-solution-row]').forEach((row) => {
        const summary = row.querySelector<HTMLElement>('summary');
        if (!summary) return;

        row.dataset.enhanced = 'true';
        row.dataset.expanded = String(row.open);

        summary.addEventListener('click', (event) => {
          event.preventDefault();
          const shouldOpen = row.dataset.expanded !== 'true';

          if (shouldOpen) {
            list.querySelectorAll<HTMLDetailsElement>('[data-solution-row]').forEach((other) => {
              if (other !== row && other.dataset.expanded === 'true') {
                setSolutionRowState(other, false, motionPreference.matches);
              }
            });
          }

          setSolutionRowState(row, shouldOpen, motionPreference.matches);
        });
      });
    });
  };
  setupSolutionList();
  document.addEventListener('astro:page-load', setupSolutionList);
</script>
