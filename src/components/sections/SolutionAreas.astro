---
import type { Locale } from '@/config/site';
import { getLocalizedPath } from '@/config/navigation';
import type { HomeCopy } from '@/content/home';
import SliderControls from '@/components/ui/SliderControls.astro';
import SolutionScene from '@/components/ui/SolutionScene.astro';

type Props = { copy: HomeCopy['solutions']; locale?: Locale };
const { copy, locale = 'id' } = Astro.props;
---

<section class="section-pad bg-ink text-paper" id="solutions" data-track-section="solutions">
  <div class="shell-wide">
    <div class="solution-head" data-reveal="up">
      <div>
        <p class="eyebrow text-accent">{copy.eyebrow}</p>
        <h2 class="display-xl mt-4 max-w-[14ch]">{copy.title}</h2>
      </div>
      <div>
        <p class="body-lg m-0 max-w-2xl text-white/60">{copy.intro}</p>
      </div>
    </div>

    <div class="solution-controls" data-reveal="up" style="--reveal-delay:60ms">
      <p class="slider-note" aria-hidden="true">
        {copy.visualNote}
        <span>↘</span>
      </p>
      <div>
        <SliderControls
          controls={`solutions-slider-${locale}`}
          count={copy.items.length}
          locale={locale}
          tone="dark"
        />
      </div>
    </div>

    <div
      class="solution-list"
      id={`solutions-slider-${locale}`}
      data-slider-rail
      data-reveal="up"
      role="region"
      aria-roledescription="carousel"
      aria-label={locale === 'id' ? 'Kemungkinan bentuk solusi' : 'Possible solution forms'}
      tabindex="0"
      style="--reveal-delay:70ms"
    >
      {
        copy.items.map((item, index) => (
          <article
            class="solution-card group"
            data-slider-slide
            role="group"
            aria-roledescription="slide"
            aria-posinset={index + 1}
            aria-setsize={copy.items.length}
            aria-labelledby={`solution-title-${locale}-${index}`}
          >
            <div class="solution-card__top">
              <span>{item.index}</span>
              <span>{copy.contextLabel}</span>
            </div>
            <div class="solution-card__message">
              <h3 id={`solution-title-${locale}-${index}`}>{item.title}</h3>
              <p>{item.body}</p>
            </div>

            <div class="solution-card__visual">
              <SolutionScene kind={item.preview} locale={locale} />
            </div>

            <div class="solution-card__outputs">
              <p>{copy.outputLabel}</p>
              <div>
                {item.outputs.map((output) => (
                  <span>{output}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-9 flex flex-wrap items-center justify-between gap-5">
      <p class="m-0 max-w-2xl text-sm leading-6 text-white/50">
        {
          locale === 'id'
            ? 'Belum tahu bentuk yang cocok? Mulai saja dari proses yang ingin dibenahi.'
            : 'Not sure which form fits? Start with the process you want to improve.'
        }
      </p>
      <a
        class="text-paper inline-flex items-center gap-3 border-b border-white/70 pb-1 text-sm font-extrabold no-underline"
        href={getLocalizedPath(locale, '/solutions')}
      >
        {locale === 'id' ? 'Lihat kemungkinan solusinya' : 'Explore possible solutions'}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .solution-head {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .solution-controls {
    display: grid;
    gap: 1rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .slider-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-family: var(--font-hand);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    line-height: 1;
    transform: rotate(-1.5deg);
  }
  .slider-note span {
    display: inline-block;
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 1rem;
    transform: translateY(0.25rem) rotate(5deg);
  }
  .solution-list {
    display: grid;
    grid-auto-columns: min(84vw, 62rem);
    grid-auto-flow: column;
    gap: 1rem;
    overflow-x: auto;
    padding: 1.1rem calc(100% - min(84vw, 62rem)) 1.8rem 0;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .solution-list::-webkit-scrollbar {
    display: none;
  }
  .solution-list:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .solution-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    min-height: clamp(42rem, 58vw, 49rem);
    gap: clamp(1.4rem, 2.4vw, 2.35rem);
    padding: clamp(1.5rem, 3.2vw, 3.25rem);
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--color-surface);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      border-color 220ms ease;
  }
  .solution-card:hover {
    border-color: rgba(147, 166, 255, 0.55);
    background: #171b23;
    transform: translateY(-0.35rem);
  }
  .solution-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .solution-card__top span:first-child {
    color: var(--color-accent);
  }
  .solution-card h3 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.1vw, 4.35rem);
    font-weight: 630;
    line-height: 0.99;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .solution-card__message > p {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .solution-card__visual {
    min-width: 0;
  }
  .solution-card__outputs > p {
    margin: 0;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .solution-card__outputs {
    min-width: 0;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .solution-card__outputs > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .solution-card__outputs span {
    padding: 0.48rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }
  @media (min-width: 1024px) {
    .solution-head {
      grid-template-columns: 0.92fr 1.08fr;
      align-items: end;
      gap: 5rem;
    }
    .solution-controls {
      grid-template-columns: minmax(18rem, auto) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
    .solution-list {
      grid-auto-columns: min(72vw, 62rem);
      padding-right: calc(100% - min(72vw, 62rem));
    }
  }
  @media (max-width: 540px) {
    .solution-card {
      min-height: 46rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-card {
      transition: none;
    }
  }
</style>
