---
import type { Locale } from '@/config/site';
import { getLocalizedPath } from '@/config/navigation';
import type { HomeCopy } from '@/content/home';
import SliderControls from '@/components/ui/SliderControls.astro';

type Props = { copy: HomeCopy['solutions']; locale?: Locale };
const { copy, locale = 'id' } = Astro.props;
---

<section class="section-pad bg-paper text-ink" id="solutions" data-track-section="solutions">
  <div class="shell-wide">
    <div
      class="border-ink/12 grid gap-8 border-b pb-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end lg:gap-16"
      data-reveal="up"
    >
      <div>
        <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
        <h2 class="display-xl mt-4 max-w-[14ch]">{copy.title}</h2>
      </div>
      <div>
        <p class="body-lg text-dark-muted m-0 max-w-2xl">{copy.intro}</p>
      </div>
    </div>

    <div class="solution-controls" data-reveal="up" style="--reveal-delay:60ms">
      <SliderControls
        controls={`solutions-slider-${locale}`}
        count={copy.items.length}
        locale={locale}
      />
    </div>

    <div
      class="solution-list"
      id={`solutions-slider-${locale}`}
      data-slider-rail
      data-reveal="up"
      style="--reveal-delay:70ms"
    >
      {
        copy.items.map((item) => (
          <article class="solution-card group" data-slider-slide>
            <div class="solution-card__top">
              <span>{item.index}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>{item.title}</h3>
            <div class="solution-card__body">
              <p>{item.body}</p>
              <div class="solution-card__outputs">
                {item.outputs.map((output, outputIndex) => (
                  <>
                    <span>{output}</span>
                    {outputIndex < item.outputs.length - 1 && <span>/</span>}
                  </>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-9 flex flex-wrap items-center justify-between gap-5">
      <p class="text-dark-muted m-0 max-w-2xl text-sm leading-6">
        {
          locale === 'id'
            ? 'Belum tahu solusi mana yang cocok? Tidak masalah. Kategori dan teknologinya justru kami tentukan setelah konteks bisnisnya cukup jelas.'
            : 'Not sure which solution fits? That is fine. We decide the category and technology after the business context is clear enough.'
        }
      </p>
      <a
        class="border-ink text-ink inline-flex items-center gap-3 border-b pb-1 text-sm font-extrabold no-underline"
        href={getLocalizedPath(locale, '/solutions')}
      >
        {locale === 'id' ? 'Lihat semua kemungkinan solusi' : 'See all solution possibilities'}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .solution-controls {
    padding-block: 1.25rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
  }
  .solution-list {
    display: grid;
    grid-auto-columns: min(82vw, 30rem);
    grid-auto-flow: column;
    gap: 0.9rem;
    overflow-x: auto;
    padding: 1.1rem calc(100% - min(82vw, 30rem)) 1.6rem 0;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .solution-list::-webkit-scrollbar {
    display: none;
  }
  .solution-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: clamp(22rem, 31vw, 27rem);
    gap: 1.5rem;
    padding: clamp(1.45rem, 2.4vw, 2rem);
    border: 1px solid rgba(11, 13, 16, 0.14);
    background: #fff;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      border-color 220ms ease;
  }
  .solution-card:nth-child(2) {
    background: #f3f4f7;
  }
  .solution-card:nth-child(3) {
    background: #e8ebff;
  }
  .solution-card:nth-child(4) {
    background: #f0ede7;
  }
  .solution-card:hover {
    border-color: rgba(18, 26, 47, 0.36);
    transform: translateY(-0.35rem);
  }
  .solution-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(18, 26, 47, 0.48);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .solution-card__top span:last-child {
    font-size: 1.1rem;
    font-weight: 400;
  }
  .solution-card h3 {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.1vw, 3.25rem);
    font-weight: 630;
    line-height: 1;
    letter-spacing: -0.052em;
  }
  .solution-card__body {
    padding-top: 1.2rem;
    border-top: 1px solid rgba(11, 13, 16, 0.13);
  }
  .solution-card__body > p {
    max-width: 30rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .solution-card__outputs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.8rem;
    margin-top: 1rem;
    color: rgba(11, 13, 16, 0.38);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (min-width: 1024px) {
    .solution-list {
      grid-auto-columns: calc((100% - 1.8rem) / 2.45);
      padding-right: calc(100% - ((100% - 1.8rem) / 2.45));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-card {
      transition: none;
    }
  }
</style>
