---
import ChapterMarker from '@/components/ui/ChapterMarker.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { HomeCopy } from '@/content/home';
import type { Locale } from '@/config/site';

type Props = { copy: HomeCopy['process']; locale: Locale };
const { copy, locale } = Astro.props;
---

<section class="home-process bg-indigo-deep text-paper" data-track-section="process">
  <ChapterMarker current={5} tone="paper" />
  <div class="shell-wide home-process__inner">
    <header class="home-process__intro" data-reveal="mask">
      <div>
        <p class="eyebrow text-accent">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
      </div>
      <div>
        <p>{copy.body}</p>
        <a href={getLocalizedPath(locale, '/process')}
          >{copy.linkLabel}<span aria-hidden="true">↗</span></a
        >
      </div>
    </header>

    <div class="home-process__path" data-reveal="line">
      <i class="home-process__progress" aria-hidden="true"></i>
      <ol class="home-process__steps">
        {
          copy.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .home-process {
    position: relative;
  }
  .home-process__inner {
    padding-block: var(--space-section);
  }
  .home-process__intro {
    display: grid;
    gap: 2.5rem;
    align-items: end;
    margin-bottom: clamp(5rem, 9vw, 8rem);
  }
  .home-process__intro h2 {
    max-width: 12ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 4.6vw, 4.7rem);
    font-weight: 545;
    line-height: 0.99;
    letter-spacing: -0.052em;
  }
  .home-process__intro > div:last-child > p {
    max-width: 31rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.91rem;
    line-height: 1.72;
  }
  .home-process__intro a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.22rem;
    color: var(--color-paper);
    font-size: 0.77rem;
    font-weight: 750;
    text-decoration: none;
  }
  .home-process__intro a span {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .home-process__intro a:hover span {
    transform: translate(0.18rem, -0.1rem);
  }
  .home-process__path {
    position: relative;
  }
  .home-process__progress {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .home-process__steps {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    list-style: none;
  }
  .home-process__steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    min-width: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.17);
    padding: 1.45rem 0;
  }
  .home-process__steps li::before {
    position: absolute;
    top: -0.25rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: var(--color-indigo-deep);
    content: '';
  }
  .home-process__steps li > span {
    color: rgba(147, 166, 255, 0.76);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .home-process__steps h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.8vw, 1.75rem);
    font-weight: 550;
    letter-spacing: -0.035em;
  }
  .home-process__steps p {
    max-width: 15rem;
    margin: 0.65rem 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.74rem;
    line-height: 1.62;
  }
  @media (min-width: 900px) {
    .home-process__intro {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .home-process__steps {
      grid-template-columns: repeat(6, 1fr);
    }
    .home-process__steps li {
      min-height: 12.5rem;
      grid-template-columns: 1fr;
      align-content: space-between;
      border-right: 1px solid rgba(255, 255, 255, 0.17);
      border-bottom: 0;
      padding: 1.45rem clamp(0.8rem, 1.4vw, 1.35rem);
    }
    .home-process__steps li:first-child {
      padding-left: 0;
    }
    .home-process__steps li:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .home-process__progress {
        animation: process-line linear both;
        animation-range: entry 20% cover 55%;
        animation-timeline: view();
      }
      @keyframes process-line {
        to {
          transform: scaleX(1);
        }
      }
    }
  }
  @media (max-width: 640px) {
  }
  @media (prefers-reduced-motion: reduce) {
    .home-process__intro a span {
      transition: none;
    }
    .home-process__progress {
      transform: scaleX(1);
    }
  }
</style>
