---
import ChapterMarker from '@/components/ui/ChapterMarker.astro';
import { getWhatsAppUrl } from '@/config/contact';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['finalCta'] };
const { locale, copy } = Astro.props;
const whatsappUrl = getWhatsAppUrl(locale);
---

<section class="final-cta bg-paper-warm text-ink" data-track-section="final-cta">
  <ChapterMarker current={7} />
  <div class="shell-wide final-cta__inner">
    <div class="final-cta__label" data-reveal="line">
      <span aria-hidden="true"></span>
      <p>{copy.eyebrow}</p>
    </div>

    <div class="final-cta__content" data-reveal="mask">
      <h2>{copy.title}</h2>
      <div>
        <p>{copy.body}</p>
        <div class="final-cta__actions">
          <a
            class="button-primary"
            href={getLocalizedPath(locale, '/contact')}
            data-track-event="cta_click"
            data-track-label="final-cta"
          >
            {copy.button}<span aria-hidden="true">↗</span>
          </a>
          {
            whatsappUrl && (
              <a
                class="final-cta__whatsapp"
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track-event="whatsapp_click"
                data-track-label="final-cta"
              >
                WhatsApp <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
        <small>{copy.note}</small>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    border-top: 1px solid rgba(11, 13, 16, 0.11);
  }
  .final-cta__inner {
    display: grid;
    min-height: min(78svh, 48rem);
    grid-template-rows: auto 1fr;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(6rem, 11vw, 10rem);
  }
  .final-cta__label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
    padding-bottom: 1.25rem;
  }
  .final-cta__label > span {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: #5367ee;
  }
  .final-cta__label p {
    margin: 0;
    color: rgba(11, 13, 16, 0.56);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .final-cta__content {
    display: grid;
    gap: 3rem;
    align-items: end;
    padding-top: clamp(5rem, 10vw, 9rem);
  }
  .final-cta h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 5.6rem);
    font-weight: 540;
    line-height: 0.97;
    letter-spacing: -0.056em;
  }
  .final-cta__content > div > p {
    max-width: 29rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.6);
    font-size: 0.94rem;
    line-height: 1.72;
  }
  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.4rem;
    margin-top: 2rem;
  }
  .final-cta__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.22rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
  }
  .final-cta small {
    display: block;
    max-width: 28rem;
    margin-top: 1.25rem;
    color: rgba(11, 13, 16, 0.46);
    font-size: 0.67rem;
    line-height: 1.55;
  }
  @media (min-width: 880px) {
    .final-cta__content {
      grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.65fr);
    }
  }
  @media (max-width: 640px) {
    .final-cta__inner {
      min-height: auto;
      padding-bottom: 6rem;
    }
  }
</style>
