---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['hero'] };
const { locale, copy } = Astro.props;
---

<section class="home-hero bg-paper-warm text-ink" data-track-section="hero">
  <div class="shell home-hero__inner">
    <div class="home-hero__copy" data-reveal="up">
      <p class="home-hero__eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="home-hero__body">{copy.body}</p>
      <div class="home-hero__actions">
        <a
          class="button-primary"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_click"
          data-track-label="hero-primary"
        >
          {copy.primaryCta}<span aria-hidden="true">↗</span>
        </a>
        <a class="home-hero__work" href="#featured-work">
          {copy.secondaryCta}<span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <a class="home-hero__scroll" href="#featured-work" aria-label={copy.scrollLabel}>
      <span>{copy.scrollLabel}</span><i aria-hidden="true"></i>
    </a>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - 4.75rem);
    overflow: hidden;
    border-bottom: 1px solid rgba(11, 13, 16, 0.1);
  }
  .home-hero::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49.96%, rgba(11, 13, 16, 0.035) 50%, transparent 50.04%),
      linear-gradient(rgba(11, 13, 16, 0.025) 1px, transparent 1px);
    background-size:
      100% 100%,
      100% 7.5rem;
    content: '';
    pointer-events: none;
  }
  .home-hero__inner {
    position: relative;
    display: grid;
    min-height: calc(100svh - 4.75rem);
    align-items: center;
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .home-hero__copy {
    width: min(100%, 68rem);
    margin-inline: auto;
    text-align: center;
  }
  .home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 2rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .home-hero__eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #5367ee;
    box-shadow: 0 0 0 5px rgba(83, 103, 238, 0.1);
  }
  .home-hero h1 {
    max-width: 13ch;
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 8.2vw, 8.6rem);
    font-weight: 620;
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .home-hero__body {
    max-width: 43rem;
    margin: clamp(2rem, 3.4vw, 3rem) auto 0;
    color: rgba(11, 13, 16, 0.6);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.75;
    text-wrap: balance;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .home-hero__work {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    gap: 0.65rem;
    color: rgba(11, 13, 16, 0.65);
    font-size: 0.83rem;
    font-weight: 750;
    text-decoration: none;
  }
  .home-hero__work:hover {
    color: var(--color-ink);
  }
  .home-hero__scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
  }
  .home-hero__scroll i {
    display: block;
    width: 1px;
    height: 1.8rem;
    background: rgba(11, 13, 16, 0.28);
    transform-origin: top;
    animation: scroll-line 2s ease-in-out infinite;
  }
  @keyframes scroll-line {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }
  @media (max-width: 640px) {
    .home-hero h1 {
      font-size: clamp(3rem, 15vw, 4.65rem);
    }
    .home-hero__body {
      max-width: 31rem;
    }
    .home-hero__scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero__scroll i {
      animation: none;
    }
  }
</style>
