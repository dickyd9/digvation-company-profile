---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['hero'] };
const { locale, copy } = Astro.props;
---

<section class="home-hero bg-paper-warm text-ink" data-track-section="hero">
  <div class="shell-wide home-hero__inner">
    <div class="home-hero__statement">
      <p class="home-hero__eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
      <div class="home-hero__title-mask">
        <h1>{copy.title}</h1>
      </div>
    </div>

    <div class="home-hero__footer">
      <p class="home-hero__body">{copy.body}</p>
      <div class="home-hero__actions">
        <a
          class="button-primary"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_click"
          data-track-label="hero-primary"
        >
          {copy.primaryCta}<span aria-hidden="true">↗</span>
        </a>
        <a class="home-hero__work" href="#featured-work">
          {copy.secondaryCta}<span aria-hidden="true">↓</span>
        </a>
      </div>
      <a class="home-hero__scroll" href="#featured-work" aria-label={copy.scrollLabel}>
        <span>{copy.scrollLabel}</span><i aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    overflow: clip;
  }
  .home-hero::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: rgba(11, 13, 16, 0.12);
    content: '';
    transform-origin: left;
  }
  .home-hero__inner {
    display: grid;
    min-height: calc(100svh - 4.5rem);
    grid-template-rows: minmax(0, 1fr) auto;
    padding-top: clamp(4.5rem, 9vh, 7rem);
    padding-bottom: clamp(2rem, 4vh, 3.25rem);
  }
  .home-hero__statement {
    align-self: center;
  }
  .home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 clamp(1.6rem, 3vw, 2.6rem);
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .home-hero__eyebrow span {
    width: 1.8rem;
    height: 1px;
    background: var(--color-indigo-deep);
  }
  .home-hero__title-mask {
    overflow: clip;
  }
  .home-hero h1 {
    max-width: 11.5ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.45rem, 6.2vw, 6.4rem);
    font-weight: 545;
    line-height: 0.95;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }
  .home-hero__footer {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    border-top: 1px solid rgba(11, 13, 16, 0.12);
    padding-top: 1.4rem;
  }
  .home-hero__body {
    max-width: 34rem;
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(0.96rem, 1.2vw, 1.08rem);
    line-height: 1.72;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
  }
  .home-hero__work {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    gap: 0.65rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }
  .home-hero__work span {
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .home-hero__work:hover {
    color: var(--color-ink);
  }
  .home-hero__work:hover span {
    transform: translateY(0.18rem);
  }
  .home-hero__scroll {
    display: none;
    justify-self: end;
    color: rgba(11, 13, 16, 0.5);
    font-size: 0.56rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .home-hero__scroll i {
    display: block;
    width: 3rem;
    height: 1px;
    background: currentColor;
    transform-origin: left;
  }
  @media (min-width: 820px) {
    .home-hero__footer {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.75fr) auto;
    }
    .home-hero__scroll {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
  }
  @media (max-width: 640px) {
    .home-hero {
      min-height: calc(100svh - 4.25rem);
    }
    .home-hero__inner {
      min-height: calc(100svh - 4.25rem);
      padding-top: clamp(3.5rem, 10vh, 5rem);
      padding-bottom: 1.5rem;
    }
    .home-hero h1 {
      max-width: 10.5ch;
      font-size: clamp(3.15rem, 14.8vw, 4.35rem);
      letter-spacing: -0.062em;
    }
    .home-hero__body {
      max-width: 29rem;
      line-height: 1.64;
    }
    .home-hero__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-hero__eyebrow {
      animation: hero-detail-in 700ms 120ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
    .home-hero h1 {
      animation: hero-title-in 900ms 80ms both cubic-bezier(0.16, 1, 0.3, 1);
    }
    .home-hero__footer {
      animation: hero-footer-in 760ms 430ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
    .home-hero::after {
      animation: hero-rule-in 900ms 420ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.digvation-opening) .home-hero__eyebrow {
      animation-delay: 850ms;
    }
    :global(html.digvation-opening) .home-hero h1 {
      animation-delay: 820ms;
    }
    :global(html.digvation-opening) .home-hero__footer {
      animation-delay: 1120ms;
    }
    :global(html.digvation-opening) .home-hero::after {
      animation-delay: 1080ms;
    }
  }
  @keyframes hero-title-in {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(18%);
    }
    to {
      clip-path: inset(0);
      transform: translateY(0);
    }
  }
  @keyframes hero-detail-in {
    from {
      opacity: 0;
      letter-spacing: 0.16em;
    }
  }
  @keyframes hero-footer-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes hero-rule-in {
    from {
      transform: scaleX(0);
    }
  }
</style>
