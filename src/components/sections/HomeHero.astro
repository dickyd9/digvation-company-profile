---
import BusinessSystemPreview from '@/components/ui/BusinessSystemPreview.astro';
import HandwrittenNote from '@/components/ui/HandwrittenNote.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['hero'] };
const { locale, copy } = Astro.props;
const proofFlow =
  locale === 'id'
    ? ['Order masuk', 'Stok terbarui', 'Tim melihat status']
    : ['Order arrives', 'Stock updates', 'Team sees status'];
---

<section class="hero-home bg-paper-warm text-ink overflow-hidden" data-track-section="hero">
  <div class="shell-wide hero-grid py-12 sm:py-16 lg:py-20">
    <div class="hero-copy" data-hero-enter style="--hero-delay:60ms">
      <div class="mb-7 flex items-center gap-3">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="eyebrow text-indigo-deep">{copy.eyebrow}</span>
      </div>

      <h1 class="hero-title">
        <span class="sr-only">{copy.titleA11y}</span>
        <span class="hero-title__visual" aria-hidden="true">
          <span class="hero-title__prefix">{copy.titlePrefix}</span>
          <span class="hero-title__words" data-hero-rotator>
            {
              copy.titleWords.map((word, index) => (
                <span class:list={['hero-title__word', index === 0 && 'is-active']}>{word}</span>
              ))
            }
          </span>
        </span>
      </h1>

      <p class="hero-body">{copy.body}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="button-primary"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_clicked"
          data-track-label="hero-primary"
        >
          {copy.primaryCta}
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button-secondary"
          href="#work"
          data-track-event="cta_clicked"
          data-track-label="hero-work"
        >
          {copy.secondaryCta}
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="hero-note">{copy.note}</p>
    </div>

    <aside
      class="system-proof"
      data-hero-enter
      style="--hero-delay:150ms"
      aria-label={copy.proofLabel}
    >
      <div class="proof-meta">
        <span>{copy.proofLabel}</span>
        <span>{copy.proofMeta}</span>
      </div>

      <div class="proof-stage">
        <div class="system-annotation">
          <HandwrittenNote
            text={locale === 'id'
              ? 'Yang tersebar, jadi satu alur.'
              : 'Scattered work becomes one flow.'}
            direction="down"
          />
        </div>

        <div class="proof-flow" aria-hidden="true">
          {
            proofFlow.map((item, index) => (
              <>
                <span>
                  <i>{String(index + 1).padStart(2, '0')}</i>
                  {item}
                </span>
                {index < proofFlow.length - 1 && <b>→</b>}
              </>
            ))
          }
        </div>

        <div class="proof-visual">
          <BusinessSystemPreview locale={locale} />
        </div>

        <div class="proof-copy">
          <div>
            <span>01 / CONNECTED OPERATIONS</span>
            <h2>{copy.proofTitle}</h2>
          </div>
          <p>{copy.proofBody}</p>
        </div>
      </div>
    </aside>
  </div>

  <div class="shell-wide outcome-strip" data-hero-enter style="--hero-delay:230ms">
    <p>{copy.outcomeLabel}</p>
    <ul>
      {
        copy.outcomes.map((outcome, index) => (
          <li>
            <span>0{index + 1}</span>
            {outcome}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero-home {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid rgba(11, 13, 16, 0.1);
  }
  .hero-grid {
    display: grid;
    gap: clamp(3.5rem, 7vw, 7rem);
    align-items: center;
  }
  .hero-title {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3.15rem, 5.3vw, 5.8rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.057em;
  }
  .hero-title__visual,
  .hero-title__prefix,
  .hero-title__words {
    display: block;
  }
  .hero-title__words {
    position: relative;
    min-height: 1.02em;
    color: #4057db;
  }
  .hero-title__word {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    transform: translateY(0.28em);
    transition:
      opacity 420ms ease,
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
    white-space: nowrap;
  }
  .hero-title__word.is-active {
    opacity: 1;
    transform: translateY(0);
  }
  .hero-body {
    max-width: 37rem;
    margin: 1.75rem 0 0;
    color: var(--color-dark-muted);
    font-size: clamp(1.02rem, 1.2vw, 1.16rem);
    line-height: 1.75;
  }
  .hero-note {
    max-width: 34rem;
    margin: 1.35rem 0 0;
    padding-left: 1rem;
    border-left: 1px solid rgba(11, 13, 16, 0.18);
    color: rgba(11, 13, 16, 0.52);
    font-size: 0.78rem;
    line-height: 1.65;
  }
  .status-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 999px;
    background: #4e65f3;
    box-shadow: 0 0 0 5px rgba(78, 101, 243, 0.11);
  }
  .system-proof {
    min-width: 0;
  }
  .proof-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
    color: rgba(11, 13, 16, 0.45);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .proof-stage {
    position: relative;
    padding: clamp(1rem, 2.1vw, 1.75rem);
    border: 1px solid rgba(11, 13, 16, 0.12);
    background: #eef0f4;
  }
  .system-annotation {
    position: absolute;
    z-index: 3;
    top: 0.7rem;
    right: 1.2rem;
    width: 10rem;
    pointer-events: none;
  }
  .system-annotation :global(.hand-note) {
    max-width: 10rem;
  }
  .proof-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.45rem, 1vw, 0.8rem);
    min-height: 4.5rem;
    margin-bottom: 0.8rem;
    padding-right: 11rem;
  }
  .proof-flow span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: clamp(0.54rem, 0.7vw, 0.66rem);
    font-weight: 750;
  }
  .proof-flow i {
    color: #5267ec;
    font-style: normal;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }
  .proof-flow b {
    color: rgba(11, 13, 16, 0.25);
    font-size: 0.72rem;
  }
  .proof-visual {
    overflow: hidden;
    border: 1px solid rgba(11, 13, 16, 0.14);
    background: #e9edf2;
    box-shadow: 0 1.75rem 4.5rem rgba(11, 13, 16, 0.12);
  }
  .proof-copy {
    display: grid;
    gap: 0.8rem 1.5rem;
    align-items: end;
    padding-top: 1.15rem;
  }
  .proof-copy span {
    color: rgba(18, 26, 47, 0.46);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .proof-copy h2 {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.1vw, 2rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .proof-copy p {
    max-width: 25rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.57);
    font-size: 0.74rem;
    line-height: 1.65;
  }
  .outcome-strip {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.65rem;
    border-top: 1px solid rgba(11, 13, 16, 0.1);
  }
  .outcome-strip > p {
    margin: 0;
    color: rgba(11, 13, 16, 0.42);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .outcome-strip ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .outcome-strip li {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(11, 13, 16, 0.08);
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    font-weight: 590;
    letter-spacing: -0.025em;
  }
  .outcome-strip li:last-child {
    border-bottom: 0;
  }
  .outcome-strip li span {
    color: rgba(78, 101, 243, 0.55);
    font-family: var(--font-sans);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  :global(html.motion-ready) [data-hero-enter] {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--hero-delay, 0ms) forwards;
  }
  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (min-width: 700px) {
    .proof-copy {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }
  @media (min-width: 768px) {
    .outcome-strip {
      grid-template-columns: 0.55fr 1.45fr;
      align-items: start;
    }
    .outcome-strip ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .outcome-strip li {
      padding: 0 1.25rem;
      border-right: 1px solid rgba(11, 13, 16, 0.1);
      border-bottom: 0;
    }
    .outcome-strip li:first-child {
      padding-left: 0;
    }
    .outcome-strip li:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(22rem, 0.82fr) minmax(34rem, 1.18fr);
      min-height: calc(100svh - 4.75rem - 6.2rem);
    }
  }
  @media (max-width: 699px) {
    .hero-title {
      font-size: clamp(2.9rem, 13vw, 4.25rem);
    }
    .proof-meta span:last-child {
      display: none;
    }
    .proof-stage {
      padding: 0.7rem;
    }
    .system-annotation {
      display: none;
    }
    .proof-flow {
      gap: 0.35rem;
      min-height: 0;
      padding-right: 0;
    }
    .proof-flow span {
      display: grid;
      gap: 0.05rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title__word {
      display: none;
      transition: none;
    }
    .hero-title__word:first-child {
      display: block;
      opacity: 1;
      transform: none;
    }
    :global(html.motion-ready) [data-hero-enter] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const heroRotatorTimers = new Map<HTMLElement, number>();
  const reducedHeroMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setupHeroRotators = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-rotator]').forEach((rotator) => {
      if (rotator.dataset.rotatorReady === 'true') return;
      rotator.dataset.rotatorReady = 'true';

      const words = Array.from(rotator.querySelectorAll<HTMLElement>('.hero-title__word'));
      if (words.length < 2 || reducedHeroMotion.matches) return;

      let activeIndex = 0;
      const timer = window.setInterval(() => {
        words[activeIndex]?.classList.remove('is-active');
        activeIndex = (activeIndex + 1) % words.length;
        words[activeIndex]?.classList.add('is-active');
      }, 2600);

      heroRotatorTimers.set(rotator, timer);
    });
  };

  const cleanupHeroRotators = () => {
    heroRotatorTimers.forEach((timer) => window.clearInterval(timer));
    heroRotatorTimers.clear();
  };

  setupHeroRotators();
  document.addEventListener('astro:page-load', setupHeroRotators);
  document.addEventListener('astro:before-swap', cleanupHeroRotators);
</script>
