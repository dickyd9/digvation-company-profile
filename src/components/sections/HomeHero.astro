---
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['hero'] };
const { locale, copy } = Astro.props;
---

<section class="home-hero bg-paper-warm text-ink" data-track-section="hero">
  <div class="shell-wide home-hero__inner">
    <div class="home-hero__main">
      <p class="home-hero__eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
      <div class="home-hero__title-mask">
        <h1>
          <span class="home-hero__title-lead">{copy.titleLead}</span>
          <span>{copy.titleRest}</span>
        </h1>
      </div>
      <p class="home-hero__body">{copy.body}</p>
      <div class="home-hero__actions">
        <a
          class="button-primary"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_click"
          data-track-label="hero-primary"
        >
          {copy.primaryCta}<span aria-hidden="true">↗</span>
        </a>
        <a class="home-hero__work" href="#featured-work">
          {copy.secondaryCta}<span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <ul class="home-hero__commitments" aria-label={copy.commitmentsLabel}>
      {
        copy.commitments.map((commitment) => (
          <li>
            <span aria-hidden="true" />
            {commitment}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    overflow: clip;
  }
  .home-hero::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: rgba(11, 13, 16, 0.12);
    content: '';
    transform-origin: left;
  }
  .home-hero__inner {
    display: grid;
    min-height: calc(100svh - 4.5rem);
    grid-template-rows: minmax(0, 1fr) auto;
    padding-top: clamp(3.5rem, 7vh, 5.5rem);
    padding-bottom: clamp(1.25rem, 2.5vh, 2rem);
  }
  .home-hero__main {
    display: grid;
    width: 100%;
    max-width: 78rem;
    align-self: center;
    justify-self: center;
    justify-items: center;
    padding-block: clamp(2.5rem, 6vh, 5rem);
    text-align: center;
  }
  .home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 clamp(1.5rem, 2.5vw, 2.15rem);
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .home-hero__eyebrow span {
    width: 2.4rem;
    height: 1px;
    background: var(--color-indigo-deep);
  }
  .home-hero__eyebrow::after {
    width: 2.4rem;
    height: 1px;
    background: var(--color-indigo-deep);
    content: '';
  }
  .home-hero__title-mask {
    width: 100%;
    overflow: clip;
  }
  .home-hero h1 {
    max-width: 13.5ch;
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 6.4vw, 7rem);
    font-weight: 545;
    line-height: 0.94;
    letter-spacing: -0.062em;
    text-wrap: balance;
  }
  .home-hero__title-lead {
    display: block;
    color: var(--color-indigo-deep);
  }
  .home-hero__body {
    max-width: 45rem;
    margin: clamp(1.5rem, 2.8vw, 2.2rem) auto 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.3vw, 1.14rem);
    line-height: 1.7;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.9rem 1.4rem;
    margin-top: clamp(1.7rem, 3vw, 2.35rem);
  }
  .home-hero__work {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    gap: 0.65rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }
  .home-hero__work span {
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .home-hero__work:hover {
    color: var(--color-ink);
  }
  .home-hero__work:hover span {
    transform: translateY(0.18rem);
  }
  .home-hero__commitments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem clamp(1.25rem, 3vw, 3rem);
    margin: 0;
    border-top: 1px solid rgba(11, 13, 16, 0.12);
    padding: clamp(1rem, 2vh, 1.35rem) 0 0;
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.69rem;
    font-weight: 680;
    letter-spacing: 0.015em;
    list-style: none;
  }
  .home-hero__commitments li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .home-hero__commitments li > span {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--color-indigo-deep);
  }
  @media (max-width: 640px) {
    .home-hero {
      min-height: calc(100svh - 4.25rem);
    }
    .home-hero__inner {
      min-height: calc(100svh - 4.25rem);
      padding-top: clamp(2.5rem, 7vh, 3.75rem);
      padding-bottom: 1.1rem;
    }
    .home-hero__main {
      padding-block: 2.25rem 2.75rem;
    }
    .home-hero h1 {
      max-width: 10.8ch;
      font-size: clamp(3.05rem, 13.5vw, 4.15rem);
      letter-spacing: -0.062em;
    }
    .home-hero__eyebrow {
      gap: 0.55rem;
      font-size: 0.58rem;
    }
    .home-hero__eyebrow span,
    .home-hero__eyebrow::after {
      width: 1.5rem;
    }
    .home-hero__body {
      max-width: 30rem;
      line-height: 1.62;
    }
    .home-hero__actions {
      gap: 0.6rem 1.1rem;
    }
    .home-hero__commitments {
      gap: 0.55rem 1rem;
      font-size: 0.62rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.digvation-opening) .home-hero__eyebrow {
      animation: hero-detail-in 600ms 500ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.digvation-opening) .home-hero h1 {
      animation: hero-title-in 760ms 420ms both cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(html.digvation-opening) .home-hero__body,
    :global(html.digvation-opening) .home-hero__actions {
      animation: hero-footer-in 620ms 700ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.digvation-opening) .home-hero__commitments {
      animation: hero-detail-in 600ms 820ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.digvation-opening) .home-hero::after {
      animation: hero-rule-in 700ms 680ms both cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @keyframes hero-title-in {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(18%);
    }
    to {
      clip-path: inset(0);
      transform: translateY(0);
    }
  }
  @keyframes hero-detail-in {
    from {
      opacity: 0;
      letter-spacing: 0.16em;
    }
  }
  @keyframes hero-footer-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes hero-rule-in {
    from {
      transform: scaleX(0);
    }
  }
</style>
