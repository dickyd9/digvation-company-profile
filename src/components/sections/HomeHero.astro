---
import BusinessSystemPreview from '@/components/ui/BusinessSystemPreview.astro';
import HandwrittenNote from '@/components/ui/HandwrittenNote.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import type { HomeCopy } from '@/content/home';

type Props = { locale: Locale; copy: HomeCopy['hero'] };
const { locale, copy } = Astro.props;
---

<section class="hero-home bg-paper-warm text-ink overflow-hidden" data-track-section="hero">
  <div class="shell-wide hero-grid py-12 sm:py-16 lg:py-20">
    <div class="hero-copy" data-hero-enter style="--hero-delay:60ms">
      <div class="mb-7 flex items-center gap-3">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="eyebrow text-indigo-deep">{copy.eyebrow}</span>
      </div>

      <h1 class="hero-title">{copy.title}</h1>
      <p class="text-dark-muted mt-7 max-w-[43rem] text-[clamp(1.02rem,1.25vw,1.18rem)] leading-8">
        {copy.body}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="button-primary"
          href={getLocalizedPath(locale, '/contact')}
          data-track-event="cta_clicked"
          data-track-label="hero-primary"
        >
          {copy.primaryCta}
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button-secondary"
          href="#work"
          data-track-event="cta_clicked"
          data-track-label="hero-work"
        >
          {copy.secondaryCta}
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="border-ink/18 text-ink/50 mt-6 max-w-[41rem] border-l pl-4 text-sm leading-6">
        {copy.note}
      </p>
    </div>

    <aside
      class="system-proof"
      data-hero-enter
      style="--hero-delay:150ms"
      aria-label={copy.proofLabel}
    >
      <div class="proof-meta">
        <span>{copy.proofLabel}</span>
        <span>{copy.proofMeta}</span>
      </div>

      <div class="system-annotation">
        <HandwrittenNote
          text={locale === 'id'
            ? 'Yang tadinya tersebar, jadi satu alur.'
            : 'What was scattered becomes one flow.'}
          direction="left"
        />
      </div>

      <div class="proof-visual">
        <BusinessSystemPreview locale={locale} />
      </div>

      <div class="proof-copy">
        <div>
          <span>01 / CONNECTED OPERATIONS</span>
          <h2>{copy.proofTitle}</h2>
        </div>
        <p>{copy.proofBody}</p>
      </div>
    </aside>
  </div>

  <div class="shell-wide outcome-strip" data-hero-enter style="--hero-delay:230ms">
    <p>{copy.outcomeLabel}</p>
    <ul>
      {
        copy.outcomes.map((outcome, index) => (
          <li>
            <span>0{index + 1}</span>
            {outcome}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero-home {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid rgba(11, 13, 16, 0.1);
  }
  .hero-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6.5rem);
    align-items: center;
  }
  .hero-title {
    max-width: 11.5ch;
    font-family: var(--font-display);
    font-size: clamp(3.15rem, 5.65vw, 6.2rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.057em;
    text-wrap: balance;
  }
  .status-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 999px;
    background: #4e65f3;
    box-shadow: 0 0 0 5px rgba(78, 101, 243, 0.11);
  }
  .system-proof {
    min-width: 0;
  }
  .proof-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
    color: rgba(11, 13, 16, 0.45);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .system-annotation {
    position: relative;
    z-index: 2;
    display: flex;
    height: 4.6rem;
    justify-content: flex-end;
    padding-right: 8%;
    margin-bottom: -1.5rem;
    pointer-events: none;
  }
  .system-annotation :global(.hand-note) {
    max-width: 10.5rem;
  }
  .proof-visual {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(11, 13, 16, 0.14);
    background: #e9edf2;
    color: inherit;
    box-shadow: 0 1.75rem 4.5rem rgba(11, 13, 16, 0.13);
  }
  .proof-copy {
    display: grid;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.13);
    padding-bottom: 1.35rem;
  }
  .proof-copy span {
    color: rgba(18, 26, 47, 0.46);
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .proof-copy h2 {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 3rem);
    font-weight: 630;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .proof-copy p {
    max-width: 30rem;
    color: rgba(11, 13, 16, 0.56);
    font-size: 0.78rem;
    line-height: 1.7;
  }
  .outcome-strip {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.65rem;
    border-top: 1px solid rgba(11, 13, 16, 0.1);
  }
  .outcome-strip > p {
    margin: 0;
    color: rgba(11, 13, 16, 0.42);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .outcome-strip ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .outcome-strip li {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(11, 13, 16, 0.08);
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    font-weight: 590;
    letter-spacing: -0.025em;
  }
  .outcome-strip li:last-child {
    border-bottom: 0;
  }
  .outcome-strip li span {
    color: rgba(78, 101, 243, 0.55);
    font-family: var(--font-sans);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  :global(html.motion-ready) [data-hero-enter] {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--hero-delay, 0ms) forwards;
  }
  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (min-width: 768px) {
    .proof-copy {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: end;
    }
    .outcome-strip {
      grid-template-columns: 0.55fr 1.45fr;
      align-items: start;
    }
    .outcome-strip ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .outcome-strip li {
      padding: 0 1.25rem;
      border-right: 1px solid rgba(11, 13, 16, 0.1);
      border-bottom: 0;
    }
    .outcome-strip li:first-child {
      padding-left: 0;
    }
    .outcome-strip li:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(29rem, 0.98fr);
      min-height: calc(100svh - 4.75rem - 7rem);
    }
  }
  @media (max-width: 640px) {
    .hero-title {
      font-size: clamp(2.9rem, 13vw, 4.25rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.motion-ready) [data-hero-enter] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
