---
import type { Locale } from '@/config/site';
import { getLocalizedPath } from '@/config/navigation';
import { getWhatsAppUrl } from '@/config/contact';
import { PUBLIC_TURNSTILE_SITEKEY } from 'astro:env/client';

type Props = { locale: Locale };
const { locale } = Astro.props;
const serverStatus = '';
const whatsappUrl = getWhatsAppUrl(locale);

const field =
  'inquiry-control w-full rounded-[.32rem] border border-line-light bg-paper px-4 py-3.5 text-[.95rem] text-ink outline-none transition-[background-color,border-color,box-shadow] placeholder:text-dark-muted/55 hover:border-ink/30 focus:border-indigo-deep focus:bg-paper focus:shadow-[0_0_0_3px_rgba(18,26,47,.09)] user-invalid:border-[#9f3f32]';
const copy =
  locale === 'id'
    ? {
        title: 'Ceritakan masalah bisnisnya.',
        helper:
          'Gunakan bahasa sehari-hari. Kami bantu menilai masalah, prioritas, dan langkah digital yang masuk akal.',
        name: 'Nama',
        email: 'Email',
        phone: 'WhatsApp / Telepon',
        company: 'Perusahaan / Organisasi',
        problem: 'Apa yang sedang menghambat bisnis Anda?',
        required: 'Wajib diisi',
        namePlaceholder: 'Nama lengkap',
        emailPlaceholder: 'nama@perusahaan.com',
        phonePlaceholder: '+62 812 3456 7890',
        companyPlaceholder: 'Nama bisnis atau organisasi',
        placeholder:
          'Contoh: order masih masuk dari WhatsApp, admin mencatat ulang ke spreadsheet, lalu statusnya sulit dipantau...',
        consent:
          'Saya setuju Digvation menggunakan informasi ini untuk menghubungi dan melanjutkan percakapan dengan saya.',
        deliveryTitle: 'Pilih jalur yang paling nyaman',
        deliveryFormOnly: 'Kirim lewat form agar cerita Anda langsung tercatat.',
        deliveryWithWhatsapp: 'Kirim lewat form, atau lanjutkan obrolannya di WhatsApp.',
        submit: 'Kirim untuk dipetakan',
        sending: 'Mengirim…',
        whatsapp: 'Bahas di WhatsApp',
        whatsappNote:
          'Kami menyiapkan isi pesannya di WhatsApp. Anda tetap memeriksa dan menekan Kirim sendiri.',
        privacy: 'Kebijakan Privasi',
        optional: 'opsional',
      }
    : {
        title: 'Tell us the business problem.',
        helper:
          'Use everyday language. We will help assess the problem, priority, and a sensible digital next step.',
        name: 'Name',
        email: 'Email',
        phone: 'WhatsApp / Phone',
        company: 'Company / Organization',
        problem: 'What is getting in the way of the business?',
        required: 'Required',
        namePlaceholder: 'Full name',
        emailPlaceholder: 'name@company.com',
        phonePlaceholder: '+62 812 3456 7890',
        companyPlaceholder: 'Business or organization name',
        placeholder:
          'Example: orders still come through WhatsApp, the team re-enters them into spreadsheets, and status is difficult to track...',
        consent:
          'I agree that Digvation may use this information to contact me and continue our conversation.',
        deliveryTitle: 'Choose the easiest way to continue',
        deliveryFormOnly: 'Send the form so your story reaches us in one place.',
        deliveryWithWhatsapp: 'Send the form, or continue the conversation on WhatsApp.',
        submit: 'Send for assessment',
        sending: 'Sending…',
        whatsapp: 'Discuss on WhatsApp',
        whatsappNote:
          'We prepare the message in WhatsApp. You still review it and press Send yourself.',
        privacy: 'Privacy Policy',
        optional: 'optional',
      };
---

<form
  class="inquiry-form grid gap-8"
  aria-labelledby="inquiry-form-title"
  data-inquiry-form
  data-clarity-mask="true"
  method="POST"
  action="/api/inquiry"
>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmContent" />
  <input type="hidden" name="utmTerm" />
  <input type="hidden" name="clickId" />
  <input type="hidden" name="landingPage" />
  <input type="hidden" name="referrer" />
  <input
    class="absolute -left-[9999px]"
    aria-hidden="true"
    tabindex="-1"
    autocomplete="off"
    name="website"
  />

  <div>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="text-indigo-deep text-xs font-extrabold tracking-[.08em]">01</span><span
          class="bg-ink/12 h-px w-7"
          aria-hidden="true"></span><span
          class="text-dark-muted text-xs font-extrabold tracking-[.08em] uppercase"
          >{locale === 'id' ? 'Tentang kebutuhan Anda' : 'About your need'}</span
        >
      </div>
      <p class="text-dark-muted m-0 text-[.68rem] font-semibold">
        <span class="text-[#9f3f32]" aria-hidden="true">*</span>
        {copy.required}
      </p>
    </div><h2
      id="inquiry-form-title"
      class="m-0 text-xl leading-tight font-semibold tracking-[-.02em]"
    >
      {copy.title}
    </h2>
    <p class="text-dark-muted mt-3 max-w-2xl text-sm leading-6">{copy.helper}</p>
  </div>

  <div class="grid gap-x-5 gap-y-6 md:grid-cols-2">
    <label class="inquiry-field grid gap-2.5">
      <span class="text-sm font-semibold">{copy.name} <span aria-hidden="true">*</span></span>
      <input
        class={field}
        name="name"
        placeholder={copy.namePlaceholder}
        autocomplete="name"
        enterkeyhint="next"
        minlength="2"
        maxlength="80"
        required
      />
    </label>

    <label class="inquiry-field grid gap-2.5">
      <span class="text-sm font-semibold">{copy.email} <span aria-hidden="true">*</span></span>
      <input
        class={field}
        type="email"
        name="email"
        placeholder={copy.emailPlaceholder}
        autocomplete="email"
        inputmode="email"
        enterkeyhint="next"
        required
      />
    </label>

    <label class="inquiry-field grid gap-2.5">
      <span class="text-sm font-semibold"
        >{copy.phone} <span class="text-dark-muted font-normal">({copy.optional})</span></span
      >
      <input
        class={field}
        type="tel"
        name="phone"
        placeholder={copy.phonePlaceholder}
        autocomplete="tel"
        inputmode="tel"
        enterkeyhint="next"
        maxlength="40"
      />
    </label>

    <label class="inquiry-field grid gap-2.5">
      <span class="text-sm font-semibold"
        >{copy.company} <span class="text-dark-muted font-normal">({copy.optional})</span></span
      >
      <input
        class={field}
        name="company"
        placeholder={copy.companyPlaceholder}
        autocomplete="organization"
        enterkeyhint="next"
        maxlength="120"
      />
    </label>

    <label class="inquiry-field grid gap-2.5 md:col-span-2">
      <span class="text-sm font-semibold">{copy.problem} <span aria-hidden="true">*</span></span>
      <textarea
        class={field}
        name="improvement"
        rows="6"
        minlength="20"
        maxlength="2200"
        required
        enterkeyhint="send"
        placeholder={copy.placeholder}></textarea>
    </label>
  </div>

  {
    PUBLIC_TURNSTILE_SITEKEY && (
      <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITEKEY} data-action="inquiry" />
    )
  }

  <label class="text-dark-muted flex items-start gap-3 text-sm leading-6">
    <input class="accent-ink mt-1 size-4" type="checkbox" name="consent" value="true" required />
    <span
      >{copy.consent}
      <a class="underline underline-offset-4" href={getLocalizedPath(locale, '/privacy')}
        >{copy.privacy}</a
      ></span
    >
  </label>

  <div class="inquiry-delivery border-line-light border-t pt-7">
    <div class="inquiry-delivery__intro">
      <p class="text-ink m-0 text-sm font-bold">{copy.deliveryTitle}</p>
      <p class="text-dark-muted mt-1 mb-0 text-xs leading-5">
        {whatsappUrl ? copy.deliveryWithWhatsapp : copy.deliveryFormOnly}
      </p>
    </div>
    <div class="inquiry-delivery__actions">
      <button
        type="submit"
        class="button-accent cursor-pointer disabled:cursor-wait disabled:opacity-50"
        data-submit-label={copy.submit}
        data-sending-label={copy.sending}
      >
        <span data-submit-text>{copy.submit}</span>
        <span aria-hidden="true">→</span>
      </button>
      {
        whatsappUrl && (
          <a
            class="button-secondary"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-inquiry
            data-track-event="whatsapp_click"
            data-track-label="inquiry-form"
          >
            {copy.whatsapp}
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>

  {whatsappUrl && <p class="text-dark-muted -mt-5 mb-0 text-xs leading-5">{copy.whatsappNote}</p>}

  <p
    class="text-dark-muted data-[state=error]:text-ink data-[state=success]:border-indigo-deep data-[state=success]:text-ink m-0 max-w-xl border-l border-transparent pl-0 text-sm transition-[border-color,color,padding] data-[state=error]:border-[#b45d4d] data-[state=error]:pl-3 data-[state=success]:pl-3"
    data-form-status
    data-state="idle"
    role="status"
    aria-live="polite"
  >
    {serverStatus}
  </p>
</form>

<style>
  .inquiry-field > span:first-child {
    transition: color 160ms ease;
  }

  .inquiry-field:focus-within > span:first-child {
    color: var(--color-indigo-deep);
  }

  textarea.inquiry-control {
    min-height: 11rem;
    resize: vertical;
  }

  .inquiry-delivery {
    display: grid;
    gap: 1.25rem;
  }

  .inquiry-delivery__intro {
    max-width: 31rem;
  }

  .inquiry-delivery__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .inquiry-delivery {
      grid-template-columns: minmax(12rem, 1fr) auto;
      align-items: end;
    }
  }

  @media (max-width: 520px) {
    .inquiry-delivery__actions,
    .inquiry-delivery__actions > :global(*) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inquiry-field > span:first-child {
      transition: none;
    }
  }
</style>

<script>
  import { track } from '@/lib/analytics/client';
  import { addMessageToWhatsAppUrl, buildWhatsAppInquiryMessage } from '@/lib/inquiry/whatsapp';

  type TurnstileApi = {
    render: (container: HTMLElement, options?: Record<string, unknown>) => string;
    reset: (widgetId?: string) => void;
  };

  const getTurnstile = () => (window as typeof window & { turnstile?: TurnstileApi }).turnstile;

  const setupTurnstile = (form: HTMLFormElement) => {
    const container = form.querySelector<HTMLElement>('.cf-turnstile[data-sitekey]');
    if (!container || container.dataset.rendered === 'true') return;

    const render = () => {
      const api = getTurnstile();
      if (!api || !container.isConnected || container.dataset.rendered === 'true') return;
      const widgetId = api.render(container, {
        sitekey: container.dataset.sitekey,
        action: container.dataset.action || 'inquiry',
        theme: 'light',
      });
      container.dataset.rendered = 'true';
      container.dataset.widgetId = String(widgetId);
    };

    if (getTurnstile()) {
      render();
      return;
    }

    let script = document.querySelector<HTMLScriptElement>('script[data-digvation-turnstile]');
    if (!script) {
      script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.dataset.digvationTurnstile = 'true';
      document.head.appendChild(script);
    }
    script.addEventListener('load', render, { once: true });
  };

  const resetTurnstile = (form: HTMLFormElement) => {
    const container = form.querySelector<HTMLElement>('.cf-turnstile[data-rendered="true"]');
    const api = getTurnstile();
    if (!container || !api) return;
    api.reset(container.dataset.widgetId);
  };

  const setupInquiry = () => {
    const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    try {
      const attribution = JSON.parse(
        sessionStorage.getItem('digvation:campaign-attribution') || '{}',
      );
      [
        'utmSource',
        'utmMedium',
        'utmCampaign',
        'utmContent',
        'utmTerm',
        'clickId',
        'landingPage',
        'referrer',
      ].forEach((name) => {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement && typeof attribution[name] === 'string')
          input.value = attribution[name].slice(0, 500);
      });
    } catch {
      /* attribution remains optional */
    }

    setupTurnstile(form);

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonText = button?.querySelector<HTMLElement>('[data-submit-text]');
    const whatsappLink = form.querySelector<HTMLAnchorElement>('[data-whatsapp-inquiry]');
    let started = false;

    whatsappLink?.addEventListener('click', () => {
      const data = new FormData(form);
      const localeInput = form.elements.namedItem('locale');
      const locale = localeInput instanceof HTMLInputElement ? localeInput.value : 'id';
      const value = (name: string) => String(data.get(name) ?? '');
      const message = buildWhatsAppInquiryMessage(locale === 'en' ? 'en' : 'id', {
        name: value('name'),
        company: value('company'),
        email: value('email'),
        phone: value('phone'),
        improvement: value('improvement'),
      });
      whatsappLink.href = addMessageToWhatsAppUrl(whatsappLink.href, message);
    });

    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('contact_start');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      track('contact_submit');

      const localeInput = form.elements.namedItem('locale');
      const locale = localeInput instanceof HTMLInputElement ? localeInput.value : 'id';

      form.setAttribute('aria-busy', 'true');
      if (button) button.disabled = true;
      if (buttonText) buttonText.textContent = button?.dataset.sendingLabel ?? 'Sending…';
      if (status) {
        status.textContent = '';
        status.dataset.state = 'idle';
      }

      try {
        const formData = new FormData(form);
        formData.set('consent', 'true');

        const response = await fetch('/api/inquiry', {
          method: 'POST',
          body: formData,
          headers: { accept: 'application/json' },
        });
        const result = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !result?.ok) {
          if (status) {
            status.dataset.state = 'error';
            status.textContent =
              result?.message ||
              (locale === 'id'
                ? 'Pesan belum berhasil dikirim. Silakan coba lagi.'
                : 'Your message could not be sent. Please try again.');
          }
          return;
        }

        track('contact_success', { lead_source: 'website_inquiry' });
        form.reset();
        resetTurnstile(form);
        if (localeInput instanceof HTMLInputElement) localeInput.value = locale;
        if (status) {
          status.dataset.state = 'success';
          status.textContent =
            locale === 'id'
              ? 'Terima kasih, ceritanya sudah kami terima. Kami akan membacanya dan menghubungi Anda untuk langkah berikutnya.'
              : 'Thank you, we received your story. We will read it and get in touch about the next step.';
        }
      } catch {
        if (status) {
          status.dataset.state = 'error';
          status.textContent =
            locale === 'id'
              ? 'Koneksi sedang bermasalah dan pesan belum terkirim. Silakan coba lagi.'
              : 'There was a connection problem and your message was not sent. Please try again.';
        }
      } finally {
        form.removeAttribute('aria-busy');
        if (button) button.disabled = false;
        if (buttonText) buttonText.textContent = button?.dataset.submitLabel ?? 'Submit';
      }
    });
  };

  setupInquiry();
  document.addEventListener('astro:page-load', setupInquiry);
</script>
