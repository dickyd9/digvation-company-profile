---
import { brandConfig } from '@/config/brand';
---

<div class="opening-sequence" aria-hidden="true">
  <div>
    <img src={brandConfig.assets.lockupIndigo} alt="" width="192" height="40" />
    <span></span>
  </div>
</div>

<style>
  .opening-sequence {
    position: fixed;
    z-index: 999;
    inset: 0;
    display: grid;
    visibility: hidden;
    place-items: center;
    overflow: hidden;
    background: var(--color-paper-warm);
    pointer-events: none;
  }
  .opening-sequence > div {
    display: grid;
    width: min(12rem, 46vw);
    gap: 1.1rem;
  }
  .opening-sequence img {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
  }
  .opening-sequence span {
    display: block;
    width: 100%;
    height: 1px;
    background: rgba(18, 26, 47, 0.24);
    transform: scaleX(0);
    transform-origin: left;
  }
  :global(html.digvation-opening) .opening-sequence {
    visibility: visible;
    animation: opening-canvas 980ms both var(--ease-emphasis);
  }
  :global(html.digvation-opening) .opening-sequence img {
    animation: opening-brand 520ms 80ms both var(--ease-out);
  }
  :global(html.digvation-opening) .opening-sequence span {
    animation: opening-line 560ms 90ms both var(--ease-out);
  }
  @keyframes opening-brand {
    0% {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
    }
    100% {
      clip-path: inset(0);
      opacity: 1;
    }
  }
  @keyframes opening-line {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes opening-canvas {
    0%,
    65% {
      clip-path: inset(0);
    }
    100% {
      clip-path: inset(0 0 100% 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .opening-sequence,
    :global(html.digvation-opening) .opening-sequence {
      display: none;
      animation: none;
    }
  }
</style>
