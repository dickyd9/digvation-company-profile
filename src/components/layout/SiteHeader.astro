---
import BrandLogo from '@/components/brand/BrandLogo.astro';
import LanguageSwitch from '@/components/layout/LanguageSwitch.astro';
import { getLocalizedPath, getNavigation } from '@/config/navigation';
import type { Locale } from '@/config/site';

type Props = { locale: Locale; showLanguageSwitch?: boolean };
const { locale, showLanguageSwitch = true } = Astro.props;
const navigation = getNavigation(locale);
const contactHref = getLocalizedPath(locale, '/contact');
const homeHref = getLocalizedPath(locale, '/');
const alternateHref =
  locale === 'id'
    ? `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`
    : Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === homeHref ? currentPath === href : currentPath.startsWith(href);
---

<header
  class="border-ink/8 bg-paper-warm/92 text-ink sticky top-0 z-50 border-b backdrop-blur-xl"
  data-site-header
>
  <div class="shell flex min-h-[4.75rem] items-center gap-5">
    <BrandLogo locale={locale} tone="brand" />

    <nav
      class="nav:flex ml-auto hidden items-center gap-6"
      aria-label={locale === 'id' ? 'Navigasi utama' : 'Main navigation'}
    >
      {
        navigation.map((item) => (
          <a
            class:list={[
              'after:bg-indigo-deep relative py-2 text-[.82rem] font-semibold no-underline transition-colors after:absolute after:right-0 after:bottom-0 after:left-0 after:h-px after:origin-left after:scale-x-0 after:transition-transform',
              isActive(item.href)
                ? 'text-ink after:scale-x-100'
                : 'text-dark-muted hover:text-ink hover:after:scale-x-100',
            ]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav:flex hidden items-center gap-3">
      {showLanguageSwitch && <LanguageSwitch locale={locale} href={alternateHref} compact />}
      <a
        class="button-accent"
        href={contactHref}
        data-track-event="cta_clicked"
        data-track-label="header"
      >
        {locale === 'id' ? 'Mulai Diskusi' : 'Start a Conversation'}
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <button
      class="menu-toggle border-line-light bg-paper text-ink hover:border-line-strong hover:bg-paper-warm nav:hidden ml-auto grid size-10 place-items-center rounded-full border transition-[background-color,border-color,transform] duration-200 active:scale-95"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span
        class="sr-only"
        data-menu-label
        data-open-label={locale === 'id' ? 'Buka menu' : 'Open menu'}
        data-close-label={locale === 'id' ? 'Tutup menu' : 'Close menu'}
        >{locale === 'id' ? 'Buka menu' : 'Open menu'}</span
      >
      <span class="menu-icon relative block h-4 w-4" aria-hidden="true">
        <i class="absolute top-[5px] left-0 block h-px w-4 bg-current"></i>
        <i class="absolute top-[11px] left-0 block h-px w-4 bg-current"></i>
      </span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu border-line-light bg-paper/98 text-ink nav:hidden absolute top-[calc(100%+.6rem)] right-4 z-50 w-[min(23rem,calc(100vw-2rem))] overflow-hidden rounded-[.75rem] border shadow-[0_24px_70px_rgba(11,13,16,.16)] backdrop-blur-xl"
    data-mobile-menu
    data-state="closed"
    aria-hidden="true"
  >
    <div class="p-2.5">
      <nav class="grid" aria-label={locale === 'id' ? 'Navigasi mobile' : 'Mobile navigation'}>
        {
          navigation.map((item) => (
            <a
              class:list={[
                'group text-ink hover:bg-paper-warm focus-visible:bg-paper-warm flex items-center justify-between rounded-xl px-4 py-3.5 text-[.98rem] font-semibold no-underline transition-colors',
                isActive(item.href) ? 'bg-paper-soft' : '',
              ]}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <span
                class="text-dark-muted translate-x-0 text-sm transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </nav>

      <div class="bg-line-light my-2 h-px"></div>

      <div class="grid gap-2">
        <a
          class="button-accent w-full justify-center"
          href={contactHref}
          data-track-event="cta_clicked"
          data-track-label="mobile-header"
        >
          {locale === 'id' ? 'Mulai Diskusi' : 'Start a Conversation'}
          <span aria-hidden="true">↗</span>
        </a>
        {showLanguageSwitch && <LanguageSwitch locale={locale} href={alternateHref} />}
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.5rem) scale(0.985);
    transform-origin: top right;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 220ms;
  }

  .mobile-menu[data-state='open'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 0s;
  }

  .menu-icon i {
    transform-origin: center;
    transition:
      top 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon i:first-child {
    top: 8px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon i:last-child {
    top: 8px;
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-icon i {
      transition: none;
    }
  }
</style>

<script>
  const setupMenu = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (!header || !button || !menu || button.dataset.ready === 'true') return;

    button.dataset.ready = 'true';
    const controller = new AbortController();
    const { signal } = controller;

    const label = button.querySelector<HTMLElement>('[data-menu-label]');
    let focusTimer = 0;

    const setOpen = (open: boolean, restoreFocus = false) => {
      window.clearTimeout(focusTimer);
      button.setAttribute('aria-expanded', String(open));
      if (label)
        label.textContent = open
          ? (label.dataset.closeLabel ?? 'Close menu')
          : (label.dataset.openLabel ?? 'Open menu');
      menu.dataset.state = open ? 'open' : 'closed';
      menu.setAttribute('aria-hidden', String(!open));

      if (open) {
        focusTimer = window.setTimeout(
          () => menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true }),
          80,
        );
      } else if (restoreFocus) {
        button.focus({ preventScroll: true });
      }
    };

    button.addEventListener(
      'click',
      () => setOpen(button.getAttribute('aria-expanded') !== 'true'),
      { signal },
    );

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false), { signal });
    });

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (button.getAttribute('aria-expanded') !== 'true') return;
        if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true')
          setOpen(false, true);
      },
      { signal },
    );

    window.addEventListener(
      'resize',
      () => {
        if (window.matchMedia('(min-width: 62rem)').matches) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearTimeout(focusTimer);
        controller.abort();
      },
      { once: true },
    );
  };

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>
