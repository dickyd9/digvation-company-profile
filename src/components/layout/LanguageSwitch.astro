---
import type { Locale } from '@/config/site';

type Props = {
  locale: Locale;
  href: string;
  compact?: boolean;
};

const { locale, href, compact = false } = Astro.props;
const targetLocale = locale === 'id' ? 'en' : 'id';
const targetLabel = locale === 'id' ? 'English' : 'Bahasa Indonesia';
const currentCode = locale.toUpperCase();
const targetCode = targetLocale.toUpperCase();
---

<a
  class:list={[
    'group text-ink hover:text-indigo-deep inline-flex items-center gap-1.5 no-underline transition-colors',
    compact ? 'px-1 py-2 text-[.68rem] font-bold' : 'px-2 py-3 text-[.76rem] font-bold',
  ]}
  href={href}
  hreflang={targetLocale}
  lang={targetLocale}
  aria-label={`${locale === 'id' ? 'Ganti bahasa ke' : 'Switch language to'} ${targetLabel}`}
  title={`${locale === 'id' ? 'Ganti bahasa ke' : 'Switch language to'} ${targetLabel}`}
  data-track-event="language_change"
  data-track-label={targetLocale}
>
  {
    !compact && (
      <span class="text-dark-muted text-[.62rem] font-bold tracking-[.08em] uppercase">
        {locale === 'id' ? 'Bahasa:' : 'Language:'}
      </span>
    )
  }
  <span class="font-bold tracking-[.05em]">{currentCode}</span>
  <span class="text-dark-muted" aria-hidden="true">/</span>
  <span class="text-indigo-deep font-bold tracking-[.05em]">{targetCode}</span>
</a>
