---
import BrandLogo from '@/components/brand/BrandLogo.astro';
import { getNavigation } from '@/config/navigation';
import { siteConfig, type Locale } from '@/config/site';
import { analyticsConfig } from '@/config/analytics';

type Props = { locale: Locale };
const { locale } = Astro.props;
const navigation = getNavigation(locale).filter((item) => item.href !== '/' && item.href !== '/en');
---

<footer class="border-paper/10 bg-ink text-paper border-t">
  <div class="shell-wide">
    <div class="grid gap-10 py-12 sm:py-14 lg:grid-cols-[1.35fr_.65fr_.65fr] lg:gap-14">
      <div>
        <BrandLogo locale={locale} tone="light" />
        <p class="text-paper/48 mt-6 max-w-md text-sm leading-7">
          {
            locale === 'id'
              ? 'Kami membantu bisnis merapikan proses, membangun sistem, menghubungkan data, dan menciptakan pengalaman digital yang benar-benar dipakai.'
              : 'We help businesses improve processes, build systems, connect data, and create digital experiences that people genuinely use.'
          }
        </p>
        <p class="text-paper/30 mt-5 text-xs font-semibold">
          Jakarta, Indonesia · Bekerja dengan bisnis di mana pun.
        </p>
      </div>
      <div>
        <p class="eyebrow text-paper/30">{locale === 'id' ? 'Jelajahi' : 'Explore'}</p>
        <nav class="mt-5 grid gap-3 text-sm" aria-label="Footer navigation">
          {
            navigation.map((item) => (
              <a
                class="text-paper/58 hover:border-paper/30 hover:text-paper w-fit border-b border-transparent no-underline transition-colors"
                href={item.href}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <div>
        <p class="eyebrow text-paper/30">{locale === 'id' ? 'Kontak' : 'Contact'}</p>
        <div class="mt-5 grid gap-3 text-sm">
          <a
            class="text-paper/58 hover:border-paper/30 hover:text-paper w-fit border-b border-transparent no-underline transition-colors"
            href={`mailto:${siteConfig.contact.email}`}
            data-track-event="email_clicked"
            data-track-label="footer">{siteConfig.contact.email}</a
          >
          <a
            class="text-paper/58 hover:border-paper/30 hover:text-paper w-fit border-b border-transparent no-underline transition-colors"
            href={locale === 'id' ? '/privacy' : '/en/privacy'}>Privacy</a
          >
          <a
            class="text-paper/58 hover:border-paper/30 hover:text-paper w-fit border-b border-transparent no-underline transition-colors"
            href={locale === 'id' ? '/terms' : '/en/terms'}>Terms</a
          >
          {
            analyticsConfig.enabled && analyticsConfig.mode === 'consent' && (
              <button
                class="text-paper/58 hover:text-paper w-fit cursor-pointer border-0 bg-transparent p-0 text-left"
                type="button"
                data-analytics-settings
              >
                {locale === 'id' ? 'Pengaturan privasi' : 'Privacy settings'}
              </button>
            )
          }
        </div>
      </div>
    </div>

    <div
      class="border-paper/10 text-paper/30 flex flex-col gap-2 border-t py-5 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {new Date().getFullYear()} Digvation</span>
      <span>Your Digitalization Partner.</span>
    </div>
  </div>
</footer>

<script>
  const setupPrivacySettings = () => {
    document.querySelectorAll<HTMLElement>('[data-analytics-settings]').forEach((button) => {
      if (button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('digvation:analytics-settings'));
      });
    });
  };
  setupPrivacySettings();
  document.addEventListener('astro:page-load', setupPrivacySettings);
</script>
