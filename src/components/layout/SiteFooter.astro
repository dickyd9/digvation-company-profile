---
import BrandLogo from '@/components/brand/BrandLogo.astro';
import { getNavigation } from '@/config/navigation';
import { siteConfig, type Locale } from '@/config/site';
import { analyticsConfig } from '@/config/analytics';
import { getWhatsAppUrl } from '@/config/contact';

type Props = { locale: Locale };
const { locale } = Astro.props;
const navigation = getNavigation(locale).filter((item) => item.href !== '/' && item.href !== '/en');
const whatsappUrl = getWhatsAppUrl(locale);
---

<footer class="site-footer bg-ink text-paper">
  <div class="shell-wide site-footer__inner">
    <div class="site-footer__rail">
      <BrandLogo locale={locale} tone="light" />
      <span>Your Digitalization Partner</span>
    </div>

    <div class="site-footer__main">
      <div class="site-footer__statement">
        <h2>
          {
            locale === 'id'
              ? 'Teknologi yang tepat membuat bisnis lebih mudah dijalankan.'
              : 'The right technology makes a business easier to run.'
          }
        </h2>
        <p>
          {
            locale === 'id'
              ? 'Mulai dari masalahnya. Kami bantu menentukan dan mewujudkan langkah digitalnya.'
              : 'Start with the problem. We help decide and deliver the digital next step.'
          }
        </p>
      </div>

      <div class="site-footer__links">
        <div>
          <p class="eyebrow">{locale === 'id' ? 'Jelajahi' : 'Explore'}</p>
          <nav aria-label="Footer navigation">
            {
              navigation.map((item) => (
                <a href={item.href}>
                  {item.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))
            }
          </nav>
        </div>
        <div>
          <p class="eyebrow">{locale === 'id' ? 'Kontak' : 'Contact'}</p>
          <div class="site-footer__contact">
            <a
              href={`mailto:${siteConfig.contact.email}`}
              data-track-event="email_click"
              data-track-label="footer">{siteConfig.contact.email}</a
            >
            {
              whatsappUrl && (
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-event="whatsapp_click"
                  data-track-label="footer"
                >
                  WhatsApp
                </a>
              )
            }
            <a href={locale === 'id' ? '/privacy' : '/en/privacy'}>Privacy</a>
            <a href={locale === 'id' ? '/terms' : '/en/terms'}>Terms</a>
            {
              analyticsConfig.enabled && analyticsConfig.mode === 'consent' && (
                <button type="button" data-analytics-settings>
                  {locale === 'id' ? 'Pengaturan privasi' : 'Privacy settings'}
                </button>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} Digvation</span>
      <span>
        {
          locale === 'id'
            ? 'Jakarta, Indonesia. Bekerja dengan bisnis di mana pun.'
            : 'Jakarta, Indonesia. Working with businesses wherever they are.'
        }
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer__inner {
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .site-footer__rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 1.25rem;
  }
  .site-footer__rail span {
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.58rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .site-footer__main {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .site-footer__statement h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.6vw, 4.7rem);
    font-weight: 535;
    line-height: 0.99;
    letter-spacing: -0.052em;
  }
  .site-footer__statement p {
    max-width: 31rem;
    margin: 1.75rem 0 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.88rem;
    line-height: 1.72;
  }
  .site-footer__links {
    display: grid;
    gap: 2.5rem;
    align-self: end;
  }
  .site-footer__links .eyebrow {
    margin: 0 0 1.35rem;
    color: rgba(255, 255, 255, 0.42);
  }
  .site-footer nav,
  .site-footer__contact {
    display: grid;
    gap: 0.7rem;
  }
  .site-footer nav a,
  .site-footer__contact a,
  .site-footer__contact button {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0 0 0.1rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.67);
    font-size: 0.76rem;
    font-weight: 620;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }
  .site-footer nav a:hover,
  .site-footer__contact a:hover,
  .site-footer__contact button:hover {
    border-color: rgba(255, 255, 255, 0.5);
    color: var(--color-paper);
  }
  .site-footer nav a span {
    color: rgba(255, 255, 255, 0.36);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-block: 1.4rem;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.62rem;
    font-weight: 620;
  }
  @media (min-width: 900px) {
    .site-footer__main {
      grid-template-columns: minmax(0, 1.22fr) minmax(20rem, 0.58fr);
    }
    .site-footer__links {
      grid-template-columns: 0.75fr 1.25fr;
    }
  }
  @media (max-width: 520px) {
    .site-footer__rail span {
      display: none;
    }
  }
</style>

<script>
  const setupPrivacySettings = () => {
    document.querySelectorAll<HTMLElement>('[data-analytics-settings]').forEach((button) => {
      if (button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('digvation:analytics-settings'));
      });
    });
  };
  setupPrivacySettings();
  document.addEventListener('astro:page-load', setupPrivacySettings);
</script>
