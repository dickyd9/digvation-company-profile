---
import BrandLogo from '@/components/brand/BrandLogo.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Tentang Digvation',
        title: 'Teknologi seharusnya meringankan bisnis. Bukan menambah beban baru.',
        intro:
          'Itulah alasan Digvation ada. Kami membantu bisnis mengambil keputusan digital dengan lebih jernih, lalu membawa keputusan itu menjadi solusi yang benar-benar bekerja.',
        whyEyebrow: 'Mengapa kami ada',
        whyTitle: 'Karena masalah bisnis jarang datang dalam bentuk spesifikasi teknis.',
        whyBody:
          'Sering kali yang terasa hanyalah proses makin lambat, informasi tercecer, atau peluang sulit ditindaklanjuti. Digvation hadir untuk memahami situasi itu lebih dulu. Teknologinya dipilih setelah arah perubahannya jelas.',
        beliefsEyebrow: 'Yang kami percaya',
        beliefs: [
          [
            'Kegunaan lebih penting daripada keramaian fitur.',
            'Solusi yang baik membantu orang menyelesaikan pekerjaan, bukan sekadar terlihat canggih.',
          ],
          [
            'Keputusan harus bisa dipahami.',
            'Scope, prioritas, dan risikonya perlu jelas bagi orang bisnis, bukan hanya tim teknis.',
          ],
          [
            'Peluncuran bukan garis akhir.',
            'Nilai baru terlihat ketika solusi digunakan, dipantau, dan terus disesuaikan dengan kebutuhan.',
          ],
        ],
        directionEyebrow: 'Ke mana kami menuju',
        directionTitle: 'Menjadi partner digitalisasi yang tumbuh bersama bisnis yang kami bantu.',
        directionBody:
          'Kami ingin membantu lebih banyak bisnis melakukan digitalisasi secara bermakna, memperkuat kemampuan Digvation, dan membangun hubungan kerja yang tetap berguna jauh setelah project diluncurkan.',
        principles: [
          'Terus belajar dari penggunaan nyata',
          'Membangun kemampuan yang relevan',
          'Menjaga hubungan kerja jangka panjang',
          'Membuat teknologi tetap berguna setelah launch',
        ],
        closeEyebrow: 'Your Digitalization Partner',
        closeTitle:
          'Kami tidak harus tahu jawabannya sebelum percakapan dimulai. Kami harus tahu cara menemukannya bersama Anda.',
        cta: 'Kenalkan bisnis Anda',
      }
    : {
        eyebrow: 'About Digvation',
        title: 'Technology should make a business lighter to run. Not create another burden.',
        intro:
          'That is why Digvation exists. We help businesses make clearer digital decisions, then carry those decisions through to solutions that actually work.',
        whyEyebrow: 'Why we exist',
        whyTitle: 'Because business problems rarely arrive as technical specifications.',
        whyBody:
          'What people feel is a slower process, scattered information, or an opportunity that is difficult to act on. Digvation starts by understanding that situation. Technology is chosen after the direction is clear.',
        beliefsEyebrow: 'What we believe',
        beliefs: [
          [
            'Usefulness matters more than a crowded feature list.',
            'A good solution helps people complete the work, not merely look sophisticated.',
          ],
          [
            'Decisions should be understandable.',
            'Scope, priorities, and risks must be clear to business people, not only the technical team.',
          ],
          [
            'Launch is not the finish line.',
            'Value becomes visible when a solution is used, monitored, and adjusted to the need.',
          ],
        ],
        directionEyebrow: 'Where we are going',
        directionTitle: 'To be a digitalization partner that grows with the businesses we help.',
        directionBody:
          'We want to help more businesses digitalize with purpose, strengthen Digvation’s capabilities, and build working relationships that remain useful long after launch.',
        principles: [
          'Keep learning from real use',
          'Build relevant capabilities',
          'Maintain long-term working relationships',
          'Keep technology useful after launch',
        ],
        closeEyebrow: 'Your Digitalization Partner',
        closeTitle:
          'We do not need to know the answer before the conversation starts. We need to know how to find it with you.',
        cta: 'Introduce your business',
      };
---

<section class="about-hero bg-paper-warm text-ink">
  <div class="shell about-hero__inner" data-reveal="up">
    <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.intro}</p>
  </div>
</section>

<section class="about-why bg-ink text-paper" data-track-section="about-purpose">
  <div class="shell-wide section-pad about-why__grid">
    <div data-reveal="left"><BrandLogo locale={locale} tone="light" compact /></div>
    <div data-reveal="up">
      <p class="eyebrow text-accent">{copy.whyEyebrow}</p>
      <h2>{copy.whyTitle}</h2>
      <p>{copy.whyBody}</p>
    </div>
  </div>
</section>

<section class="about-beliefs bg-paper text-ink" data-track-section="about-beliefs">
  <div class="shell-wide section-pad">
    <header><p class="eyebrow text-indigo-deep">{copy.beliefsEyebrow}</p></header>
    <ol>
      {
        copy.beliefs.map(([title, body], index) => (
          <li data-reveal="up">
            <>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h2>{title}</h2>
              <p>{body}</p>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="about-direction bg-paper-soft text-ink" data-track-section="about-direction">
  <div class="shell section-pad">
    <div class="about-direction__intro">
      <p class="eyebrow text-indigo-deep">{copy.directionEyebrow}</p>
      <h2>{copy.directionTitle}</h2>
      <p>{copy.directionBody}</p>
    </div>
    <ul>
      {
        copy.principles.map((item, index) => (
          <li>
            <span>0{index + 1}</span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="about-close bg-indigo-deep text-paper">
  <div class="shell about-close__inner">
    <div><p class="eyebrow text-accent">{copy.closeEyebrow}</p><h2>{copy.closeTitle}</h2></div>
    <a class="button-primary bg-paper! text-ink!" href={getLocalizedPath(locale, '/contact')}
      >{copy.cta} ↗</a
    >
  </div>
</section>

<style>
  .about-hero__inner {
    padding-block: clamp(5rem, 11vw, 10rem);
  }
  .about-hero h1 {
    max-width: 14ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 7.4vw, 7.8rem);
    font-weight: 620;
    line-height: 0.95;
    letter-spacing: -0.064em;
  }
  .about-hero__inner > p:last-child {
    max-width: 43rem;
    margin: 2rem 0 0 auto;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.98rem;
    line-height: 1.8;
  }
  .about-why__grid {
    display: grid;
    gap: 3rem;
  }
  .about-why h2 {
    max-width: 17ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.4vw, 5.7rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.058em;
  }
  .about-why__grid > div:last-child > p:last-child {
    max-width: 42rem;
    margin: 1.75rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.94rem;
    line-height: 1.8;
  }
  .about-beliefs header {
    margin-bottom: 2rem;
  }
  .about-beliefs ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    list-style: none;
  }
  .about-beliefs li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: clamp(2rem, 4vw, 3.25rem) 0;
  }
  .about-beliefs li > span {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.61rem;
    font-weight: 800;
  }
  .about-beliefs h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 3.5rem);
    font-weight: 620;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .about-beliefs li > p {
    max-width: 34rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .about-direction__intro {
    display: grid;
    gap: 1.5rem;
  }
  .about-direction h2 {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5.8rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.058em;
  }
  .about-direction__intro > p:last-child {
    max-width: 40rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .about-direction ul {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    list-style: none;
  }
  .about-direction li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: 1.1rem 0;
    font-size: 0.88rem;
    font-weight: 650;
  }
  .about-direction li span {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.61rem;
  }
  .about-close__inner {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(4rem, 7vw, 6rem);
  }
  .about-close h2 {
    max-width: 23ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.1vw, 4.2rem);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.052em;
  }
  @media (min-width: 900px) {
    .about-why__grid {
      grid-template-columns: 0.45fr 1.55fr;
    }
    .about-direction__intro {
      grid-template-columns: 0.35fr 1fr 0.65fr;
    }
    .about-close__inner {
      grid-template-columns: 1fr auto;
    }
  }
  @media (max-width: 760px) {
    .about-beliefs li {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
    }
    .about-beliefs h2,
    .about-beliefs li > p {
      grid-column: 2;
    }
  }
</style>
