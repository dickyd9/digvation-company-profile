---
import BrandLogo from '@/components/brand/BrandLogo.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
type Props = { locale: Locale };
const { locale } = Astro.props;
const principles =
  locale === 'id'
    ? [
        ['Pahami dulu', 'Lihat prosesnya sebelum memilih teknologi.'],
        ['Buat seperlunya', 'Bangun yang penting, bukan yang terlihat ramai.'],
        ['Jelaskan keputusan', 'Scope dan risiko harus mudah dipahami.'],
        ['Sampai dipakai', 'Solusi harus bekerja di dunia nyata.'],
      ]
    : [
        ['Understand first', 'See the process before choosing technology.'],
        ['Build what matters', 'Build what is useful, not what looks busy.'],
        ['Explain decisions', 'Scope and risk should be easy to understand.'],
        ['Through to use', 'The solution has to work in real life.'],
      ];
---

<PageHero
  eyebrow={locale === 'id' ? 'Tentang Digvation' : 'About Digvation'}
  title={locale === 'id'
    ? 'Bukan sekadar tim pembuat software.'
    : 'More than a software delivery team.'}
  body={locale === 'id'
    ? 'Kami memahami bisnisnya, lalu membangun bagian digital yang paling penting.'
    : 'We understand the business, then build the digital part that matters most.'}
  note={locale === 'id'
    ? 'Masalah dulu. Teknologi setelahnya.'
    : 'Problem first. Technology second.'}
  ctaLabel={locale === 'id' ? 'Ceritakan bisnis Anda' : 'Tell us about your business'}
  ctaHref={getLocalizedPath(locale, '/contact')}
/>

<section class="section-pad bg-paper text-ink">
  <div class="shell-wide">
    <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:gap-16">
      <div class="bg-ink text-paper p-7 sm:p-9 lg:sticky lg:top-28 lg:self-start">
        <BrandLogo locale={locale} tone="light" compact />
        <p class="eyebrow text-accent mt-9">
          {locale === 'id' ? 'Cara kami berpikir' : 'How we think'}
        </p>
        <h2
          class="font-display mt-5 max-w-[13ch] text-[clamp(2.5rem,5vw,5.2rem)] leading-[.96] font-semibold tracking-[-.058em]"
        >
          {
            locale === 'id'
              ? 'Pahami bisnisnya. Bangun yang perlu.'
              : 'Understand the business. Build what matters.'
          }
        </h2>
        <p class="text-paper/52 mt-7 max-w-xl text-sm leading-7">
          {
            locale === 'id'
              ? 'Website, sistem, automation, AI, atau IoT hanyalah bentuk. Nilainya ada pada masalah yang selesai.'
              : 'Websites, systems, automation, AI, and IoT are only forms. The value is in the problem solved.'
          }
        </p>
      </div>

      <div class="border-ink/12 border-t">
        {
          principles.map(([title, body], index) => (
            <article
              class="border-ink/12 grid gap-4 border-b py-7 sm:grid-cols-[4rem_.8fr_1.2fr] sm:gap-8 sm:py-8"
              data-reveal="up"
              style={`--reveal-delay:${index * 55}ms`}
            >
              <>
                <span class="text-indigo-deep/42 text-[.65rem] font-extrabold tracking-[.1em] uppercase">
                  0{index + 1}
                </span>
                <h3 class="font-display text-[clamp(1.6rem,2.5vw,2.4rem)] leading-[1.02] font-semibold tracking-[-.045em]">
                  {title}
                </h3>
                <p class="text-ink/58 m-0 text-sm leading-7">{body}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>

    <div class="border-ink/12 mt-14 grid gap-6 border-t pt-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="eyebrow text-indigo-deep">
          {locale === 'id' ? 'Mulai dari masalahnya' : 'Start with the problem'}
        </p><h2
          class="font-display mt-4 max-w-[22ch] text-[clamp(2rem,3.5vw,3.5rem)] leading-[1.02] font-semibold tracking-[-.05em]"
        >
          {
            locale === 'id'
              ? 'Ceritakan cara kerjanya hari ini.'
              : 'Tell us how the work happens today.'
          }
        </h2>
      </div>
      <a class="button-primary shrink-0" href={getLocalizedPath(locale, '/contact')}
        >{locale === 'id' ? 'Diskusikan dengan Digvation' : 'Discuss It with Digvation'} ↗</a
      >
    </div>
  </div>
</section>
