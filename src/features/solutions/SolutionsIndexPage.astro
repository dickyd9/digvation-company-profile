---
import { getCollection } from 'astro:content';
import ProjectFrame from '@/components/work/ProjectFrame.astro';
import { getLocalizedPath } from '@/config/navigation';
import { pricingConfig } from '@/config/pricing';
import type { Locale } from '@/config/site';

type Props = { locale: Locale };
const { locale } = Astro.props;
const solutions = (await getCollection('solutions'))
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => a.data.order - b.data.order);
const relatedProjects = (await getCollection('work')).filter(
  (entry) =>
    entry.data.locale === locale &&
    entry.data.entryType === 'case-study' &&
    !entry.data.draft &&
    entry.data.status === 'published',
);
const PricingAnchor =
  pricingConfig.enabled && pricingConfig.items.length > 0
    ? (await import('@/components/commercial/PricingAnchor.astro')).default
    : null;
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Solusi',
        title: 'Mulai dari kebutuhan bisnisnya.',
        intro: 'Pilih situasi yang paling dekat dengan apa yang sedang ingin Anda benahi.',
        hint: 'Buka satu untuk melihat pendekatannya',
        fit: 'Cocok saat',
        help: 'Yang kami bantu',
        output: 'Yang Anda dapat',
        example: 'Contoh bentuk solusi',
        start: 'Mulai dari sini',
        cta: 'Ceritakan kebutuhan Anda',
        proof: 'Hasil kerja terkait',
      }
    : {
        eyebrow: 'Solutions',
        title: 'Start with the business need.',
        intro: 'Choose the situation closest to what you are trying to improve.',
        hint: 'Open one to see the approach',
        fit: 'A good fit when',
        help: 'How we help',
        output: 'What you receive',
        example: 'Possible solution forms',
        start: 'Start here',
        cta: 'Tell us what you need',
        proof: 'Related work',
      };
---

<section class="solutions-directory bg-paper-warm text-ink" data-solutions-directory>
  <div class="shell-wide solutions-directory__inner">
    <header class="solutions-directory__header" data-reveal="up">
      <div>
        <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <div>
        <p>{copy.intro}</p>
        <small>{copy.hint} ↓</small>
      </div>
    </header>

    <div class="solutions-directory__list">
      {
        solutions.map((entry, index) => {
          const relatedProject = relatedProjects.find(
            (project) =>
              project.data.entryType === 'case-study' &&
              project.data.relatedSolution === entry.data.routeSlug,
          );
          return (
            <details
              class="solution-directory-row"
              id={entry.data.routeSlug}
              data-solution-detail
              data-solution-slug={entry.data.routeSlug}
            >
              <summary>
                <span class="solution-directory-row__number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <small>{entry.data.eyebrow}</small>
                  <h2>{entry.data.title}</h2>
                </div>
                <p>{entry.data.summary}</p>
                <span class="solution-directory-row__toggle" aria-hidden="true">
                  +
                </span>
              </summary>

              <div class="solution-directory-row__detail">
                <div class="solution-directory-row__lead">
                  <p class="eyebrow text-indigo-deep">{copy.start}</p>
                  <p class="solution-directory-row__problem">{entry.data.problem}</p>
                  <strong>{entry.data.start}</strong>
                  <a
                    class="button-primary bg-paper! text-ink!"
                    href={getLocalizedPath(locale, '/contact')}
                    data-track-event="cta_click"
                    data-track-label={`solution-${entry.data.routeSlug}`}
                  >
                    {copy.cta}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>

                <div class="solution-directory-row__facts">
                  <section>
                    <h3>{copy.fit}</h3>
                    <ul>
                      {entry.data.when.slice(0, 3).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                  <section>
                    <h3>{copy.help}</h3>
                    <ul>
                      {entry.data.whatWeDo.slice(0, 3).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                  <section>
                    <h3>{copy.output}</h3>
                    <ul>
                      {entry.data.outputs.slice(0, 4).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                  <section>
                    <h3>{copy.example}</h3>
                    <p>{entry.data.examples.slice(0, 3).join(' / ')}</p>
                  </section>
                </div>

                {relatedProject && (
                  <aside class="solution-directory-row__proof">
                    <div>
                      <p class="eyebrow text-indigo-deep">{copy.proof}</p>
                      <strong>{relatedProject.data.title}</strong>
                    </div>
                    <ProjectFrame
                      image={relatedProject.data.coverImage ?? ''}
                      alt={`${relatedProject.data.title}. ${relatedProject.data.summary}`}
                      href={getLocalizedPath(locale, `/work/${relatedProject.data.routeSlug}`)}
                      width={relatedProject.data.routeSlug === 'poseidon-filter' ? 1348 : 1363}
                      height={relatedProject.data.routeSlug === 'poseidon-filter' ? 945 : 936}
                      imageClass={
                        relatedProject.data.routeSlug === 'poseidon-filter'
                          ? 'aspect-[1.43] object-top'
                          : 'aspect-[1.46]'
                      }
                    />
                  </aside>
                )}
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</section>

{PricingAnchor && <PricingAnchor locale={locale} />}

<style>
  .solutions-directory {
    min-height: calc(100svh - 4.5rem);
  }
  .solutions-directory__inner {
    padding-block: clamp(4rem, 7vw, 6rem);
  }
  .solutions-directory__header {
    display: grid;
    gap: 1.25rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .solutions-directory__header h1 {
    max-width: 12ch;
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.85rem, 4.8vw, 4.8rem);
    font-weight: 570;
    line-height: 0.98;
    letter-spacing: -0.054em;
  }
  .solutions-directory__header > div:last-child > p {
    max-width: 34rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .solutions-directory__header small {
    display: block;
    margin-top: 0.75rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.63rem;
    font-weight: 700;
  }
  .solutions-directory__list {
    border-top: 1px solid rgba(11, 13, 16, 0.17);
  }
  .solution-directory-row {
    border-bottom: 1px solid rgba(11, 13, 16, 0.17);
    scroll-margin-top: 6rem;
  }
  .solution-directory-row summary {
    display: grid;
    grid-template-columns: 2.5rem minmax(12rem, 0.75fr) minmax(0, 1.25fr) 2rem;
    gap: 1.25rem;
    align-items: center;
    min-height: 3.9rem;
    cursor: pointer;
    list-style: none;
  }
  .solution-directory-row summary::-webkit-details-marker {
    display: none;
  }
  .solution-directory-row__number {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.6rem;
    font-weight: 700;
  }
  .solution-directory-row summary small {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .solution-directory-row h2 {
    margin: 0.18rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.85rem);
    font-weight: 580;
    letter-spacing: -0.04em;
  }
  .solution-directory-row summary > p {
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.77rem;
    line-height: 1.55;
  }
  .solution-directory-row__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 0;
    transition:
      transform 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }
  .solution-directory-row[open] .solution-directory-row__toggle {
    transform: rotate(45deg);
  }
  .solution-directory-row[open] > summary {
    border-bottom: 1px solid rgba(11, 13, 16, 0.12);
    background: #eef0fa;
    color: var(--color-ink);
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
  }
  .solution-directory-row[open] summary small,
  .solution-directory-row[open] summary > p,
  .solution-directory-row[open] .solution-directory-row__number {
    color: rgba(11, 13, 16, 0.52);
  }
  .solution-directory-row[open] .solution-directory-row__toggle {
    color: var(--color-ink);
  }
  .solution-directory-row__detail {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    margin-inline: calc(50% - 50vw);
    padding: clamp(3rem, 6vw, 5rem) max(calc(50vw - 44rem), clamp(0.75rem, 3vw, 2.5rem));
    background: #eef0fa;
    color: var(--color-ink);
    animation: directory-detail-in 440ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .solution-directory-row__problem {
    max-width: 38rem;
    margin: 1.15rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.25vw, 2.05rem);
    font-weight: 560;
    line-height: 1.28;
    letter-spacing: -0.035em;
  }
  .solution-directory-row__lead > strong {
    display: block;
    max-width: 35rem;
    margin: 1.15rem 0 0;
    color: rgba(11, 13, 16, 0.58);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.65;
  }
  .solution-directory-row__lead a {
    margin-top: 1.5rem;
  }
  .solution-directory-row__facts {
    display: grid;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
  }
  .solution-directory-row__facts section {
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: 1.25rem 0;
  }
  .solution-directory-row__facts h3 {
    margin: 0 0 0.8rem;
    color: var(--color-indigo-deep);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .solution-directory-row__facts ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .solution-directory-row__facts li,
  .solution-directory-row__facts p {
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .solution-directory-row__proof {
    display: grid;
    gap: 1.25rem;
    grid-column: 1 / -1;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    padding-top: 1.5rem;
  }
  .solution-directory-row__proof > div > strong {
    display: block;
    margin-top: 0.45rem;
    font-size: 1rem;
    font-weight: 600;
  }
  @keyframes directory-detail-in {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0;
    }
    to {
      clip-path: inset(0);
      opacity: 1;
    }
  }
  @media (min-width: 900px) {
    .solutions-directory__header {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .solution-directory-row__detail {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .solution-directory-row__facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .solution-directory-row__facts section:nth-child(odd) {
      padding-right: 1.5rem;
      border-right: 1px solid rgba(11, 13, 16, 0.16);
    }
    .solution-directory-row__facts section:nth-child(even) {
      padding-left: 1.5rem;
    }
  }
  @media (max-width: 760px) {
    .solution-directory-row summary {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: 0.75rem;
      padding-block: 1rem;
    }
    .solution-directory-row summary > p {
      grid-column: 2;
    }
    .solution-directory-row__toggle {
      grid-row: 1 / span 2;
      grid-column: 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-directory-row__toggle,
    .solution-directory-row__detail {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { track } from '@/lib/analytics/client';
  const setupSolutionsDirectory = () => {
    const directory = document.querySelector<HTMLElement>('[data-solutions-directory]');
    if (!directory || directory.dataset.ready === 'true') return;
    directory.dataset.ready = 'true';
    const rows = [...directory.querySelectorAll<HTMLDetailsElement>('[data-solution-detail]')];
    const openRow = (row: HTMLDetailsElement, updateHash = true) => {
      rows.forEach((other) => {
        if (other !== row) other.open = false;
      });
      if (!row.open) return;
      const slug = row.dataset.solutionSlug ?? '';
      if (updateHash) history.replaceState(null, '', `#${slug}`);
      track('service_view', { slug });
    };
    rows.forEach((row) => row.addEventListener('toggle', () => openRow(row)));
    const hash = decodeURIComponent(location.hash.slice(1));
    const target = rows.find((row) => row.id === hash);
    if (target) {
      target.open = true;
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    }
  };
  setupSolutionsDirectory();
  document.addEventListener('astro:page-load', setupSolutionsDirectory);
</script>
