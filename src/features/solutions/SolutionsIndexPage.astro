---
import { getCollection } from 'astro:content';
import PricingAnchor from '@/components/commercial/PricingAnchor.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';

type Props = { locale: Locale };
const { locale } = Astro.props;
const solutions = (await getCollection('solutions'))
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => a.data.order - b.data.order);
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Solusi',
        title: 'Mulai dari kebutuhan bisnisnya.',
        intro:
          'Pilih situasi yang paling dekat. Detailnya terbuka di halaman ini, tanpa membawa Anda ke tujuh halaman berbeda.',
        hint: 'Buka satu untuk melihat detail',
        fit: 'Cocok saat',
        help: 'Yang kami bantu',
        output: 'Yang Anda dapat',
        example: 'Contoh bentuk solusi',
        start: 'Mulai dari sini',
        cta: 'Ceritakan kebutuhan Anda',
        close: 'Tutup detail',
      }
    : {
        eyebrow: 'Solutions',
        title: 'Start with the business need.',
        intro:
          'Choose the closest situation. The detail opens here without sending you through seven separate pages.',
        hint: 'Open one to see the detail',
        fit: 'A good fit when',
        help: 'How we help',
        output: 'What you receive',
        example: 'Possible solution forms',
        start: 'Start here',
        cta: 'Tell us what you need',
        close: 'Close detail',
      };
---

<section class="solutions-directory bg-paper-warm text-ink" data-solutions-directory>
  <div class="shell-wide solutions-directory__inner">
    <header class="solutions-directory__header" data-reveal="up">
      <div>
        <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <div>
        <p>{copy.intro}</p>
        <small>{copy.hint} ↓</small>
      </div>
    </header>

    <div class="solutions-directory__list">
      {
        solutions.map((entry, index) => (
          <details
            class="solution-directory-row"
            id={entry.data.routeSlug}
            data-solution-detail
            data-solution-slug={entry.data.routeSlug}
          >
            <summary>
              <span class="solution-directory-row__number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <small>{entry.data.eyebrow}</small>
                <h2>{entry.data.title}</h2>
              </div>
              <p>{entry.data.summary}</p>
              <span class="solution-directory-row__toggle" aria-hidden="true">
                +
              </span>
            </summary>

            <div class="solution-directory-row__detail">
              <div class="solution-directory-row__lead">
                <p class="eyebrow text-accent">{copy.start}</p>
                <h3>{entry.data.problem}</h3>
                <p>{entry.data.start}</p>
                <a
                  class="button-primary bg-paper! text-ink!"
                  href={getLocalizedPath(locale, '/contact')}
                  data-track-event="cta_click"
                  data-track-label={`solution-${entry.data.routeSlug}`}
                >
                  {copy.cta}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>

              <div class="solution-directory-row__facts">
                <section>
                  <h4>{copy.fit}</h4>
                  <ul>
                    {entry.data.when.slice(0, 3).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
                <section>
                  <h4>{copy.help}</h4>
                  <ul>
                    {entry.data.whatWeDo.slice(0, 3).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
                <section>
                  <h4>{copy.output}</h4>
                  <ul>
                    {entry.data.outputs.slice(0, 4).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
                <section>
                  <h4>{copy.example}</h4>
                  <p>{entry.data.examples.slice(0, 3).join(' / ')}</p>
                </section>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<PricingAnchor locale={locale} />

<style>
  .solutions-directory {
    min-height: calc(100svh - 4.75rem);
  }
  .solutions-directory__inner {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .solutions-directory__header {
    display: grid;
    gap: 1.25rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .solutions-directory__header h1 {
    max-width: 12ch;
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6.2rem);
    font-weight: 620;
    line-height: 0.95;
    letter-spacing: -0.062em;
  }
  .solutions-directory__header > div:last-child > p {
    max-width: 34rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .solutions-directory__header small {
    display: block;
    margin-top: 0.75rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.63rem;
    font-weight: 800;
  }
  .solutions-directory__list {
    border-top: 1px solid rgba(11, 13, 16, 0.17);
  }
  .solution-directory-row {
    border-bottom: 1px solid rgba(11, 13, 16, 0.17);
    scroll-margin-top: 6rem;
  }
  .solution-directory-row summary {
    display: grid;
    grid-template-columns: 2.5rem minmax(12rem, 0.75fr) minmax(0, 1.25fr) 2rem;
    gap: 1.25rem;
    align-items: center;
    min-height: 3.9rem;
    cursor: pointer;
    list-style: none;
  }
  .solution-directory-row summary::-webkit-details-marker {
    display: none;
  }
  .solution-directory-row__number {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.6rem;
    font-weight: 800;
  }
  .solution-directory-row summary small {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .solution-directory-row h2 {
    margin: 0.18rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .solution-directory-row summary > p {
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.77rem;
    line-height: 1.55;
  }
  .solution-directory-row__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(11, 13, 16, 0.18);
    border-radius: 999px;
    transition:
      transform 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }
  .solution-directory-row[open] .solution-directory-row__toggle {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: rotate(45deg);
  }
  .solution-directory-row[open] > summary {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background: var(--color-ink);
    color: var(--color-paper);
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
  }
  .solution-directory-row[open] summary small,
  .solution-directory-row[open] summary > p,
  .solution-directory-row[open] .solution-directory-row__number {
    color: rgba(255, 255, 255, 0.5);
  }
  .solution-directory-row[open] .solution-directory-row__toggle {
    border-color: rgba(255, 255, 255, 0.3);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .solution-directory-row__detail {
    display: grid;
    gap: 3rem;
    margin-inline: calc(50% - 50vw);
    padding: clamp(3rem, 6vw, 5rem) max(calc(50vw - 44rem), clamp(0.75rem, 3vw, 2.5rem));
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .solution-directory-row__lead h3 {
    max-width: 16ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.6vw, 4.8rem);
    font-weight: 620;
    line-height: 0.99;
    letter-spacing: -0.055em;
  }
  .solution-directory-row__lead > p:not(.eyebrow) {
    max-width: 35rem;
    margin: 1.25rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .solution-directory-row__lead a {
    margin-top: 1.5rem;
  }
  .solution-directory-row__facts {
    display: grid;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .solution-directory-row__facts section {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding: 1.25rem 0;
  }
  .solution-directory-row__facts h4 {
    margin: 0 0 0.8rem;
    color: rgba(147, 166, 255, 0.82);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .solution-directory-row__facts ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .solution-directory-row__facts li,
  .solution-directory-row__facts p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  @media (min-width: 900px) {
    .solutions-directory__header {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .solution-directory-row__detail {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .solution-directory-row__facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .solution-directory-row__facts section:nth-child(odd) {
      padding-right: 1.5rem;
      border-right: 1px solid rgba(255, 255, 255, 0.16);
    }
    .solution-directory-row__facts section:nth-child(even) {
      padding-left: 1.5rem;
    }
  }
  @media (max-width: 760px) {
    .solution-directory-row summary {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: 0.75rem;
      padding-block: 1rem;
    }
    .solution-directory-row summary > p {
      grid-column: 2;
    }
    .solution-directory-row__toggle {
      grid-row: 1 / span 2;
      grid-column: 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-directory-row__toggle {
      transition: none;
    }
  }
</style>

<script>
  import { track } from '@/lib/analytics/client';
  const setupSolutionsDirectory = () => {
    const directory = document.querySelector<HTMLElement>('[data-solutions-directory]');
    if (!directory || directory.dataset.ready === 'true') return;
    directory.dataset.ready = 'true';
    const rows = [...directory.querySelectorAll<HTMLDetailsElement>('[data-solution-detail]')];
    const openRow = (row: HTMLDetailsElement, updateHash = true) => {
      rows.forEach((other) => {
        if (other !== row) other.open = false;
      });
      if (!row.open) return;
      const slug = row.dataset.solutionSlug ?? '';
      if (updateHash) history.replaceState(null, '', `#${slug}`);
      track('service_view', { slug });
    };
    rows.forEach((row) => row.addEventListener('toggle', () => openRow(row)));
    const hash = decodeURIComponent(location.hash.slice(1));
    const target = rows.find((row) => row.id === hash);
    if (target) {
      target.open = true;
      openRow(target, false);
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    }
  };
  setupSolutionsDirectory();
  document.addEventListener('astro:page-load', setupSolutionsDirectory);
</script>
