---
import DigitalizeThis from '@/components/sections/DigitalizeThis.astro';
import ClientSection from '@/components/sections/ClientSection.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import FeaturedWork from '@/components/sections/FeaturedWork.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import SolutionAreas from '@/components/sections/SolutionAreas.astro';
import TrustSection from '@/components/sections/TrustSection.astro';
import { homeSectionConfig } from '@/config/home-sections';
import type { Locale } from '@/config/site';
import { homeCopy } from '@/content/home';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy = homeCopy[locale];
---

<HomeHero locale={locale} copy={copy.hero} />
<ClientSection locale={locale} />
<DigitalizeThis locale={locale} copy={copy.digitalize} />
<TrustSection locale={locale} />
<ProcessSection locale={locale} copy={copy.process} />
<SolutionAreas locale={locale} copy={copy.solutions} />
<FeaturedWork locale={locale} />
{homeSectionConfig.faq && <FaqSection locale={locale} />}
<FinalCta locale={locale} copy={copy.finalCta} />
