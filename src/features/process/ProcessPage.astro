---
import ProjectFrame from '@/components/work/ProjectFrame.astro';
import PageClosing from '@/components/ui/PageClosing.astro';
import PageIntro from '@/components/ui/PageIntro.astro';
import type { Locale } from '@/config/site';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Cara Kerja',
        title: 'Sederhana untuk diikuti.',
        intro:
          'Anda membawa konteks bisnis. Kami menjaga keputusan, progres, dan hasilnya tetap jelas.',
        stages: [
          [
            'Pahami',
            'Kami melihat proses, orang, data, dan hambatan yang sebenarnya.',
            'Catatan konteks dan pertanyaan penting',
          ],
          [
            'Bentuk',
            'Kami menentukan solusi yang masuk akal, apa yang diprioritaskan, dan apa yang belum perlu.',
            'Arah solusi, scope, dan alur awal',
          ],
          [
            'Bangun',
            'Desain dan development berjalan bertahap agar keputusan dapat dilihat lebih awal.',
            'Flow, interface, dan versi yang dapat dicoba',
          ],
          [
            'Validasi',
            'Kami menguji solusi dengan skenario yang akan benar-benar dihadapi pengguna.',
            'Review, test state, dan perbaikan',
          ],
          [
            'Jalankan',
            'Kami menyiapkan rilis, deployment, data, dan kebutuhan operasionalnya.',
            'Production release dan panduan penggunaan',
          ],
          [
            'Tingkatkan',
            'Setelah digunakan, kami melihat apa yang perlu dipantau atau dibenahi berikutnya.',
            'Monitoring dan prioritas berikutnya',
          ],
        ],
        artifact: 'Yang terlihat di tahap ini',
        roleEyebrow: 'Pembagian peran',
        roleTitle: 'Anda membawa konteks bisnis. Kami bertanggung jawab pada delivery digital.',
        client: [
          'Menjelaskan proses dan hambatan',
          'Memberi validasi dari sisi bisnis',
          'Mengambil keputusan penting',
        ],
        us: [
          'Menerjemahkan kebutuhan menjadi scope',
          'Menangani desain, development, dan integration',
          'Menguji, merilis, dan mendampingi penggunaan',
        ],
        clientLabel: 'Dari Anda',
        usLabel: 'Dari Digvation',
        continuityEyebrow: 'Setelah launch',
        continuityTitle: 'Solusi mulai membuktikan nilainya ketika digunakan.',
        continuityBody:
          'Kami melihat penggunaan nyata, menemukan bagian yang masih menghambat, lalu menentukan peningkatan berikutnya bersama Anda.',
        continuity: [
          ['Pantau', 'Lihat apa yang benar-benar terjadi setelah digunakan.'],
          ['Benahi', 'Perbaiki friction, risiko, atau kebutuhan operasional yang muncul.'],
          ['Kembangkan', 'Tambah kemampuan ketika bisnis memang membutuhkannya.'],
        ],
        ctaTitle: 'Mulai dari satu proses yang paling terasa berat.',
        ctaBody: 'Kami bantu melihat langkah pertama yang paling masuk akal.',
        cta: 'Mulai percakapan',
      }
    : {
        eyebrow: 'How We Work',
        title: 'Simple to follow.',
        intro: 'You bring the business context. We keep decisions, progress, and outcomes clear.',
        stages: [
          [
            'Understand',
            'We look at the process, people, data, and the actual friction.',
            'Context notes and key questions',
          ],
          [
            'Shape',
            'We define a sensible solution, what to prioritize, and what does not need to be built yet.',
            'Direction, scope, and an initial flow',
          ],
          [
            'Build',
            'Design and development move in clear iterations so decisions are visible early.',
            'Flow, interface, and a version to try',
          ],
          [
            'Validate',
            'We test the solution against the situations users will actually face.',
            'Review, test state, and improvements',
          ],
          [
            'Launch',
            'We prepare the release, deployment, data, and operational needs.',
            'Production release and usage guidance',
          ],
          [
            'Improve',
            'Once in use, we see what should be monitored or improved next.',
            'Monitoring and the next priorities',
          ],
        ],
        artifact: 'What you can see at this stage',
        roleEyebrow: 'Who owns what',
        roleTitle: 'You bring the business context. We own digital delivery.',
        client: [
          'Explain the process and friction',
          'Validate from the business side',
          'Make important decisions',
        ],
        us: [
          'Translate the need into scope',
          'Handle design, development, and integration',
          'Test, launch, and support real use',
        ],
        clientLabel: 'From you',
        usLabel: 'From Digvation',
        continuityEyebrow: 'After launch',
        continuityTitle: 'A solution starts proving its value when people use it.',
        continuityBody:
          'We look at real use, find what still creates friction, and shape the next improvement with you.',
        continuity: [
          ['Monitor', 'See what actually happens after the solution is in use.'],
          ['Refine', 'Fix friction, risk, or operational needs that emerge.'],
          ['Extend', 'Add capability when the business genuinely needs it.'],
        ],
        ctaTitle: 'Start with the process that feels heaviest.',
        ctaBody: 'We will help find the most sensible first move.',
        cta: 'Start a conversation',
      };
---

<PageIntro
  eyebrow={copy.eyebrow}
  title={copy.title}
  intro={copy.intro}
  chapter={locale === 'id' ? 'CARA KERJA / 01' : 'PROCESS / 01'}
/>

<section class="process-stages bg-paper text-ink" data-track-section="process-stages">
  <div class="shell-wide section-pad">
    <ol class="process-stages__list">
      {
        copy.stages.map(([title, body, artifact], index) => (
          <li class="process-stage" data-reveal="line">
            <span class="process-stage__number">{String(index + 1).padStart(2, '0')}</span>
            <h2>{title}</h2>
            <p>{body}</p>
            <div class="process-stage__artifact">
              <>
                <small>{copy.artifact}</small>
                <strong>{artifact}</strong>
              </>
            </div>
            {index === 2 && (
              <div class="process-stage__visual" data-reveal="visual">
                <ProjectFrame
                  image="/work/leaf-lab/product.webp"
                  alt={
                    locale === 'id'
                      ? 'Interface Leaf Lab yang sedang dikembangkan'
                      : 'Leaf Lab interface in development'
                  }
                  width={1348}
                  height={926}
                  imageClass="aspect-[1.46]"
                />
              </div>
            )}
            {index === 4 && (
              <div class="process-stage__visual process-stage__visual--wide" data-reveal="visual">
                <ProjectFrame
                  image="/work/poseidon-filter/cover.webp"
                  alt={
                    locale === 'id'
                      ? 'Website Poseidon Filter setelah dirilis'
                      : 'Poseidon Filter website after launch'
                  }
                  width={1348}
                  height={945}
                  imageClass="aspect-[1.43] object-top"
                />
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="process-roles bg-indigo-deep text-paper" data-track-section="process-roles">
  <div class="shell section-pad">
    <header class="process-roles__header">
      <p class="eyebrow text-accent">{copy.roleEyebrow}</p><h2>{copy.roleTitle}</h2>
    </header>
    <div class="process-roles__columns">
      <section>
        <h3>{copy.clientLabel}</h3><ol>
          {
            copy.client.map((item, index) => (
              <li>
                <span>0{index + 1}</span>
                {item}
              </li>
            ))
          }
        </ol>
      </section>
      <section>
        <h3>{copy.usLabel}</h3><ol>
          {
            copy.us.map((item, index) => (
              <li>
                <span>0{index + 1}</span>
                {item}
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</section>

<section class="process-continuity bg-paper-soft text-ink" data-track-section="process-continuity">
  <div class="shell-wide process-continuity__inner">
    <header data-reveal="mask">
      <p class="eyebrow text-indigo-deep">{copy.continuityEyebrow}</p>
      <h2>{copy.continuityTitle}</h2>
      <p>{copy.continuityBody}</p>
    </header>
    <ol data-reveal-group>
      {
        copy.continuity.map(([title, body], index) => (
          <li data-reveal="line">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<PageClosing
  locale={locale}
  eyebrow={copy.ctaTitle}
  title={copy.ctaBody}
  ctaLabel={copy.cta}
  trackLabel="process-closing"
/>

<style>
  .process-stages__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    list-style: none;
  }
  .process-stage {
    display: grid;
    grid-template-columns: 3rem minmax(9rem, 0.55fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: clamp(2rem, 4vw, 3.25rem) 0;
  }
  .process-stage__number {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .process-stage h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.9rem);
    font-weight: 555;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .process-stage > p {
    max-width: 36rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .process-stage__artifact {
    grid-column: 3;
    display: grid;
    gap: 0.45rem;
    border-top: 1px solid rgba(11, 13, 16, 0.1);
    padding-top: 0.9rem;
  }
  .process-stage__artifact small {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .process-stage__artifact strong {
    font-size: 0.78rem;
    font-weight: 650;
  }
  .process-stage__visual {
    grid-column: 2 / -1;
    width: 72%;
    margin: 1.5rem 0 0 auto;
    color: var(--color-ink);
  }
  .process-stage__visual--wide {
    width: 90%;
    margin-left: 0;
  }
  .process-roles__header {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .process-roles h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 545;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .process-roles__columns {
    display: grid;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .process-roles__columns section {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .process-roles h3 {
    margin: 0 0 1.5rem;
    color: rgba(147, 166, 255, 0.82);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .process-roles ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process-roles li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.9rem 0;
    font-size: 0.86rem;
    font-weight: 650;
  }
  .process-roles li span {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.61rem;
  }
  .process-continuity__inner {
    display: grid;
    gap: clamp(4rem, 8vw, 7rem);
    padding-block: var(--space-section);
  }
  .process-continuity header h2 {
    max-width: 15ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4.7vw, 4.75rem);
    font-weight: 545;
    line-height: 0.99;
    letter-spacing: -0.052em;
  }
  .process-continuity header > p:last-child {
    max-width: 35rem;
    margin: 1.6rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.72;
  }
  .process-continuity ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }
  .process-continuity li {
    display: grid;
    grid-template-columns: 2.5rem minmax(8rem, 0.55fr) minmax(0, 1fr);
    gap: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.6rem 0;
  }
  .process-continuity li span {
    color: var(--text-soft);
    font-size: 0.59rem;
    font-weight: 780;
  }
  .process-continuity li h3,
  .process-continuity li p {
    margin: 0;
  }
  .process-continuity li h3 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.1vw, 1.9rem);
    font-weight: 560;
    letter-spacing: -0.035em;
  }
  .process-continuity li p {
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.65;
  }
  @media (min-width: 900px) {
    .process-roles__header {
      grid-template-columns: 0.55fr 1.45fr;
    }
    .process-roles__columns {
      grid-template-columns: 1fr 1fr;
    }
    .process-roles__columns section:first-child {
      padding-right: 2rem;
      border-right: 1px solid rgba(255, 255, 255, 0.18);
    }
    .process-roles__columns section:last-child {
      padding-left: 2rem;
    }
    .process-continuity__inner {
      grid-template-columns: minmax(18rem, 0.76fr) minmax(0, 1.24fr);
      align-items: start;
    }
  }
  @media (max-width: 760px) {
    .process-stage {
      grid-template-columns: 2.5rem 1fr;
      gap: 1rem;
    }
    .process-stage h2,
    .process-stage > p,
    .process-stage__artifact {
      grid-column: 2;
    }
    .process-stage__visual {
      grid-column: 1 / -1;
      width: 100%;
    }
    .process-continuity li {
      grid-template-columns: 2rem 1fr;
    }
    .process-continuity li h3,
    .process-continuity li p {
      grid-column: 2;
    }
  }
</style>
