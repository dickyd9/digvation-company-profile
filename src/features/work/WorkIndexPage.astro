---
import ProjectFrame from '@/components/work/ProjectFrame.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import { getWorkEntries } from '@/lib/content/catalog';

type Props = { locale: Locale };
const { locale } = Astro.props;
const entries = await getWorkEntries(locale);
const copy =
  locale === 'id'
    ? {
        eyebrow: 'Hasil Kerja',
        title: 'Pekerjaan yang sudah berjalan.',
        intro: 'Lihat kebutuhannya, apa yang kami bangun, dan bagaimana hasilnya digunakan.',
        story: 'Baca cerita project',
        live: 'Buka project live',
        close: 'Ada kebutuhan yang belum terlihat di sini?',
        closeBody:
          'Bentuk project tidak harus sama. Mulai saja dari masalah bisnis yang ingin dibenahi.',
        closeCta: 'Diskusikan dengan Digvation',
      }
    : {
        eyebrow: 'Work',
        title: 'Work that is already live.',
        intro: 'See the need, what we built, and how the result is used.',
        story: 'Read the project story',
        live: 'Open the live project',
        close: 'Have a need you do not see here?',
        closeBody:
          'The project does not have to look the same. Start with the business problem you want to improve.',
        closeCta: 'Discuss it with Digvation',
      };
---

<section class="work-intro bg-paper-warm text-ink">
  <div class="shell work-intro__inner" data-reveal="up">
    <p class="eyebrow text-indigo-deep">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.intro}</p>
  </div>
</section>

<section class="work-collection bg-paper text-ink" data-track-section="work-index">
  <div class="shell-wide section-pad">
    <div class="work-collection__list">
      {
        entries.map((entry, index) => {
          const caseHref =
            entry.data.entryType === 'case-study'
              ? getLocalizedPath(locale, `/work/${entry.data.routeSlug}`)
              : entry.data.liveUrl;
          const imageSize =
            entry.data.routeSlug === 'poseidon-filter'
              ? { width: 1348, height: 945 }
              : { width: 1363, height: 936 };
          return (
            <article
              class:list={[
                'work-entry',
                entry.data.visualVariant === 'paper' ? 'work-entry--paper' : 'work-entry--navy',
              ]}
            >
              <div class="work-entry__meta">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>{entry.data.client}</span>
                <span>{entry.data.projectType}</span>
                <span>{entry.data.year}</span>
              </div>
              <div class="work-entry__visual" data-reveal="visual">
                <div>
                  <ProjectFrame
                    image={entry.data.coverImage ?? ''}
                    alt={`${entry.data.title}. ${entry.data.summary}`}
                    href={caseHref}
                    url={entry.data.liveUrl ? new URL(entry.data.liveUrl).hostname : undefined}
                    width={imageSize.width}
                    height={imageSize.height}
                    imageClass={
                      entry.data.routeSlug === 'poseidon-filter'
                        ? 'aspect-[1.43] object-top'
                        : 'aspect-[1.46]'
                    }
                  />
                </div>
              </div>
              <div class="work-entry__copy">
                <h2>{entry.data.title}</h2>
                <div>
                  <p>{entry.data.summary}</p>
                  <div class="work-entry__links">
                    {entry.data.entryType === 'case-study' && (
                      <a
                        href={caseHref}
                        data-track-event="project_view"
                        data-track-label={entry.data.routeSlug}
                      >
                        {copy.story}
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                    {entry.data.liveUrl && (
                      <a
                        href={entry.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-track-event="outbound_project_click"
                        data-track-label={entry.data.routeSlug}
                      >
                        {copy.live}
                        <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<section class="work-close bg-indigo-deep text-paper">
  <div class="shell work-close__inner">
    <div>
      <p class="eyebrow text-accent">{copy.close}</p>
      <h2>{copy.closeBody}</h2>
    </div>
    <a class="button-primary bg-paper! text-ink!" href={getLocalizedPath(locale, '/contact')}>
      {copy.closeCta}<span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .work-intro__inner {
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .work-intro h1 {
    max-width: 13ch;
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 570;
    line-height: 0.98;
    letter-spacing: -0.054em;
  }
  .work-intro__inner > p:last-child {
    max-width: 41rem;
    margin: 2rem 0 0 auto;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.96rem;
    line-height: 1.75;
  }
  .work-collection__list {
    display: grid;
    gap: clamp(7rem, 13vw, 12rem);
  }
  .work-entry__meta {
    display: grid;
    grid-template-columns: 3rem 1fr auto auto;
    gap: 1rem;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    padding: 1rem 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .work-entry__copy {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.8rem;
  }
  .work-entry__visual {
    display: grid;
    min-height: clamp(25rem, 61vw, 46rem);
    place-items: center;
    overflow: clip;
    padding: clamp(2rem, 6vw, 6rem);
  }
  .work-entry--navy .work-entry__visual {
    background: #08213e;
    color: var(--color-paper);
  }
  .work-entry--paper .work-entry__visual {
    background: #edf2eb;
    color: var(--color-ink);
  }
  .work-entry__visual > div {
    width: min(100%, 68rem);
  }
  .work-entry--paper .work-entry__visual > div {
    width: min(88%, 59rem);
  }
  .work-entry__copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 3.8vw, 3.75rem);
    font-weight: 580;
    line-height: 1;
    letter-spacing: -0.048em;
  }
  .work-entry__copy p {
    max-width: 38rem;
    margin: 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .work-entry__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.35rem;
  }
  .work-entry__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.22rem;
    color: var(--color-ink);
    font-size: 0.77rem;
    font-weight: 800;
    text-decoration: none;
  }
  .work-entry__links a:last-child {
    color: rgba(11, 13, 16, 0.62);
  }
  .work-close__inner {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(4rem, 7vw, 6rem);
  }
  .work-close h2 {
    max-width: 25ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.35rem);
    font-weight: 580;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }
  @media (min-width: 900px) {
    .work-entry__copy {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .work-close__inner {
      grid-template-columns: 1fr auto;
    }
  }
  @media (max-width: 640px) {
    .work-entry__visual {
      min-height: 23rem;
      padding: 1rem;
    }
    .work-entry--paper .work-entry__visual > div {
      width: 96%;
    }
    .work-entry__meta {
      grid-template-columns: 2rem 1fr auto;
    }
    .work-entry__meta span:nth-child(3) {
      display: none;
    }
  }
</style>
