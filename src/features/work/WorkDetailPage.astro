---
import ProjectFrame from '@/components/work/ProjectFrame.astro';
import PageClosing from '@/components/ui/PageClosing.astro';
import { getLocalizedPath } from '@/config/navigation';
import type { Locale } from '@/config/site';
import { getCaseStudyWorkEntries } from '@/lib/content/catalog';

type Props = { locale: Locale; slug: string };
const { locale, slug } = Astro.props;
const all = await getCaseStudyWorkEntries(locale);
const index = all.findIndex((item) => item.data.routeSlug === slug);
const entry = all[index];
if (!entry) throw new Error(`Work entry not found: ${slug}`);
const previous = all[(index - 1 + all.length) % all.length]!;
const next = all[(index + 1) % all.length]!;
const gallery = entry.data.browserScreenshots ?? entry.data.gallery ?? [];
const results = entry.data.results ?? [];
const copy =
  locale === 'id'
    ? {
        back: 'Kembali ke Hasil Kerja',
        context: 'Konteks',
        problem: 'Masalahnya',
        change: 'Yang perlu berubah',
        approach: 'Pendekatan Digvation',
        built: 'Yang kami bangun',
        product: 'Di balik produknya',
        improvements: 'Yang menjadi lebih baik',
        result: 'Hasil',
        technology: 'Teknologi sebagai lapisan implementasi',
        live: 'Buka project live',
        ctaTitle: 'Ada masalah bisnis yang perlu dibuat bekerja lebih baik?',
        ctaBody: 'Bawa konteksnya. Kami bantu menentukan langkah digital yang masuk akal.',
        cta: 'Diskusikan dengan Digvation',
        previous: 'Sebelumnya',
        next: 'Berikutnya',
      }
    : {
        back: 'Back to Work',
        context: 'Context',
        problem: 'The problem',
        change: 'What needed to change',
        approach: "Digvation's approach",
        built: 'What we built',
        product: 'Behind the product',
        improvements: 'What became better',
        result: 'Result',
        technology: 'Technology as the implementation layer',
        live: 'Open the live project',
        ctaTitle: 'A business problem should be working better?',
        ctaBody: 'Bring the context. We will help shape a sensible digital next step.',
        cta: 'Discuss it with Digvation',
        previous: 'Previous',
        next: 'Next',
      };
const coverSize =
  slug === 'poseidon-filter' ? { width: 1348, height: 945 } : { width: 1363, height: 936 };
---

<article
  class:list={[
    'case-study bg-paper text-ink',
    entry.data.visualVariant === 'paper' ? 'case-study--paper' : 'case-study--navy',
  ]}
  data-case-study={slug}
>
  <header class="case-hero">
    <div class="shell-wide case-hero__inner">
      <a class="case-hero__back" href={getLocalizedPath(locale, '/work')}>← {copy.back}</a>
      <div class="case-hero__meta">
        <span>{entry.data.client}</span><span>{entry.data.industry}</span><span
          >{entry.data.year}</span
        >
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </div>
  </header>

  <section class="case-cover" aria-label={entry.data.title}>
    <div class="shell-wide" data-reveal="visual">
      <ProjectFrame
        image={entry.data.coverImage ?? ''}
        alt={`${entry.data.title}. ${entry.data.summary}`}
        url={entry.data.liveUrl ? new URL(entry.data.liveUrl).hostname : undefined}
        href={entry.data.liveUrl}
        loading="eager"
        width={coverSize.width}
        height={coverSize.height}
        imageClass={slug === 'poseidon-filter' ? 'aspect-[1.43] object-top' : 'aspect-[1.46]'}
      />
    </div>
  </section>

  <section class="case-story section-pad bg-paper">
    <div class="shell case-story__grid">
      <div class="case-story__index"><span>01</span><p>{copy.context}</p></div>
      <div class="case-story__lead" data-reveal="mask">
        <h2>{entry.data.context}</h2>
      </div>
      <div class="case-story__blocks">
        <article data-reveal="line">
          <p class="eyebrow text-indigo-deep">{copy.problem}</p>
          <h3>{entry.data.challenge}</h3>
        </article>
        <article data-reveal="line">
          <p class="eyebrow text-indigo-deep">{copy.change}</p>
          <h3>{entry.data.businessRequirement ?? entry.data.insight}</h3>
        </article>
        <article data-reveal="line">
          <p class="eyebrow text-indigo-deep">{copy.approach}</p>
          <h3>{entry.data.approach}</h3>
        </article>
      </div>
    </div>
  </section>

  <section class="case-built bg-indigo-deep text-paper">
    <div class="shell-wide section-pad">
      <div class="case-built__intro" data-reveal="mask">
        <p class="eyebrow text-accent">02 / {copy.built}</p>
        <h2>{entry.data.solution}</h2>
      </div>
      <ol class="case-built__list">
        {
          entry.data.built.map((item, itemIndex) => (
            <li>
              <>
                <span>{String(itemIndex + 1).padStart(2, '0')}</span>
                <strong>{item}</strong>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="case-product section-pad bg-paper-soft text-ink">
        <div class="shell-wide">
          <header class="case-product__header">
            <p class="eyebrow text-indigo-deep">03 / {copy.product}</p>
            <h2>
              {locale === 'id'
                ? 'Lihat bagaimana solusinya bekerja.'
                : 'See how the solution works.'}
            </h2>
          </header>
          <div class="case-product__gallery">
            {gallery.map((image, imageIndex) => {
              const isProduct = image.includes('product');
              return (
                <figure
                  class:list={[imageIndex % 2 === 1 && 'case-product__figure--offset']}
                  data-reveal="visual"
                >
                  <img
                    src={image}
                    alt={`${entry.data.title}, ${locale === 'id' ? 'tampilan produk' : 'product screen'} ${imageIndex + 1}`}
                    width={isProduct ? 1348 : coverSize.width}
                    height={isProduct ? 926 : coverSize.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    {entry.data.projectType} / {String(imageIndex + 1).padStart(2, '0')}
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <section class="case-result section-pad bg-paper text-ink">
    <div class="shell case-result__grid">
      <div>
        <p class="eyebrow text-indigo-deep">04 / {copy.improvements}</p>
        <h2>{entry.data.outcome}</h2>
      </div>
      <div>
        {
          results.length > 0 && (
            <ul>
              {results.map((result) => (
                <li>{result}</li>
              ))}
            </ul>
          )
        }
        <p class="case-result__next">{entry.data.nextStep}</p>
        <div class="case-result__tech">
          <p class="eyebrow">{copy.technology}</p>
          <p>{entry.data.technologies.join(' / ')}</p>
        </div>
        {
          entry.data.liveUrl && (
            <a
              class="text-link"
              href={entry.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-event="outbound_project_click"
              data-track-label={slug}
            >
              {copy.live}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <PageClosing
    locale={locale}
    eyebrow={copy.ctaTitle}
    title={copy.ctaBody}
    ctaLabel={copy.cta}
    trackLabel={`case-study-${slug}`}
  />

  {
    all.length > 1 && (
      <nav
        class="case-nav bg-paper"
        aria-label={locale === 'id' ? 'Navigasi project' : 'Project navigation'}
      >
        <div class="shell case-nav__grid">
          <a href={getLocalizedPath(locale, `/work/${previous.data.routeSlug}`)}>
            <>
              <span>← {copy.previous}</span>
              <strong>{previous.data.title}</strong>
            </>
          </a>
          <a href={getLocalizedPath(locale, `/work/${next.data.routeSlug}`)}>
            <>
              <span>{copy.next} →</span>
              <strong>{next.data.title}</strong>
            </>
          </a>
        </div>
      </nav>
    )
  }
</article>

<style>
  .case-study {
    --case-hero-bg: #0b0d10;
    --case-hero-fg: #ffffff;
    --case-hero-muted: rgba(255, 255, 255, 0.66);
  }
  .case-study--paper {
    --case-hero-bg: #edf2eb;
    --case-hero-fg: #0b0d10;
    --case-hero-muted: rgba(11, 13, 16, 0.6);
  }
  .case-hero,
  .case-cover {
    background: var(--case-hero-bg);
    color: var(--case-hero-fg);
  }
  .case-hero__inner {
    padding-top: 2rem;
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .case-hero__back {
    color: var(--case-hero-muted);
    font-size: 0.72rem;
    font-weight: 750;
    text-decoration: none;
  }
  .case-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(4rem, 8vw, 7rem);
    color: var(--case-hero-muted);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .case-hero h1 {
    max-width: 12ch;
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.7rem, 7vw, 6.8rem);
    font-weight: 545;
    line-height: 0.93;
    letter-spacing: -0.06em;
  }
  .case-hero__inner > p {
    max-width: 44rem;
    margin: 2rem 0 0 auto;
    color: var(--case-hero-muted);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.75;
  }
  .case-cover {
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }
  .case-story__grid {
    display: grid;
    gap: 2rem;
  }
  .case-story__index {
    border-top: 1px solid rgba(11, 13, 16, 0.18);
    padding-top: 1rem;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.66rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .case-story__index p {
    margin: 0.45rem 0 0;
  }
  .case-story__lead h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.8vw, 3.75rem);
    font-weight: 545;
    line-height: 1.04;
    letter-spacing: -0.048em;
  }
  .case-story__blocks {
    display: grid;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
  }
  .case-story__blocks article {
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: 1.5rem 0;
  }
  .case-story__blocks h3 {
    max-width: 42rem;
    margin: 0.8rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-weight: 620;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }
  .case-built__intro {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }
  .case-built__intro h2 {
    max-width: 24ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    font-weight: 545;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .case-built__list {
    display: grid;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    list-style: none;
  }
  .case-built__list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding: 1.25rem 0;
  }
  .case-built__list span {
    color: rgba(147, 166, 255, 0.75);
    font-size: 0.61rem;
    font-weight: 800;
  }
  .case-built__list strong {
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    font-weight: 620;
  }
  .case-product__header {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .case-product__header h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    font-weight: 545;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .case-product__gallery {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }
  .case-product figure {
    margin: 0;
  }
  .case-product figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(11, 13, 16, 0.12);
    box-shadow: 0 2rem 5rem rgba(11, 13, 16, 0.11);
  }
  .case-product figcaption {
    margin-top: 0.8rem;
    color: rgba(11, 13, 16, 0.4);
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .case-result__grid {
    display: grid;
    gap: 3rem;
  }
  .case-result h2 {
    max-width: 16ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    font-weight: 545;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .case-result ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    list-style: none;
  }
  .case-result li {
    border-bottom: 1px solid rgba(11, 13, 16, 0.16);
    padding: 1rem 0;
    font-size: 0.9rem;
    font-weight: 650;
  }
  .case-result__next {
    margin: 1.5rem 0 0;
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .case-result__tech {
    margin: 2rem 0;
    border-top: 1px solid rgba(11, 13, 16, 0.16);
    padding-top: 1rem;
  }
  .case-result__tech p:last-child {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.69rem;
    font-weight: 700;
    line-height: 1.7;
  }
  .case-nav {
    border-top: 1px solid rgba(11, 13, 16, 0.14);
  }
  .case-nav__grid {
    display: grid;
  }
  .case-nav a {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .case-nav a span {
    color: rgba(11, 13, 16, 0.62);
    font-size: 0.65rem;
    font-weight: 750;
  }
  .case-nav a strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 620;
    letter-spacing: -0.04em;
  }
  .case-nav a:last-child {
    text-align: right;
  }
  @media (min-width: 900px) {
    .case-story__grid {
      grid-template-columns: 0.2fr 0.8fr;
    }
    .case-story__lead,
    .case-story__blocks {
      grid-column: 2;
    }
    .case-story__blocks {
      grid-template-columns: repeat(3, 1fr);
    }
    .case-story__blocks article {
      padding-right: 1.5rem;
      border-right: 1px solid rgba(11, 13, 16, 0.16);
    }
    .case-story__blocks article + article {
      padding-left: 1.5rem;
    }
    .case-story__blocks article:last-child {
      border-right: 0;
    }
    .case-built__intro,
    .case-product__header,
    .case-result__grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .case-built__list {
      grid-template-columns: repeat(2, 1fr);
    }
    .case-built__list li:nth-child(odd) {
      padding-right: 1.5rem;
      border-right: 1px solid rgba(255, 255, 255, 0.18);
    }
    .case-built__list li:nth-child(even) {
      padding-left: 1.5rem;
    }
    .case-product__figure--offset {
      width: 76%;
      margin-left: auto !important;
    }
    .case-nav__grid {
      grid-template-columns: 1fr 1fr;
    }
    .case-nav a:first-child {
      padding-right: 2rem;
      border-right: 1px solid rgba(11, 13, 16, 0.14);
    }
    .case-nav a:last-child {
      padding-left: 2rem;
    }
  }
</style>

<script>
  import { track } from '@/lib/analytics/client';
  const setupCaseStudyTracking = () => {
    const page = document.querySelector<HTMLElement>('[data-case-study]');
    if (!page || page.dataset.tracked === 'true') return;
    page.dataset.tracked = 'true';
    track('case_study_view', { slug: page.dataset.caseStudy ?? '' });
  };
  setupCaseStudyTracking();
  document.addEventListener('astro:page-load', setupCaseStudyTracking);
</script>
