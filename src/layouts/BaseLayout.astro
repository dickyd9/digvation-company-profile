---
import { ClientRouter } from 'astro:transitions';
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from 'astro:env/client';
import AnalyticsManager from '@/components/analytics/AnalyticsManager.astro';
import OpeningSequence from '@/components/animations/OpeningSequence.astro';
import ScrollMotion from '@/components/animations/ScrollMotion.astro';
import BackToTop from '@/components/layout/BackToTop.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import StructuredData from '@/components/ui/StructuredData.astro';
import { brandConfig } from '@/config/brand';
import { localeToOpenGraph, resolvePageTitle, seoConfig } from '@/config/seo';
import { siteConfig, type Locale } from '@/config/site';
import { localBusinessSchema, organizationSchema, websiteSchema } from '@/lib/seo/schema';
import '@/styles/global.css';

type Props = {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string | undefined;
  type?: 'website' | 'article';
  noindex?: boolean;
  hasAlternate?: boolean;
  structuredData?: Array<Record<string, unknown> | null>;
};
const {
  locale,
  title,
  description = seoConfig.defaultDescription,
  image = seoConfig.ogImage,
  type = 'website',
  noindex = false,
  hasAlternate = true,
  structuredData = [],
} = Astro.props;
const resolvedTitle = resolvePageTitle(title);
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const idPath = Astro.url.pathname.startsWith('/en')
  ? Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/'
  : Astro.url.pathname;
const enPath = idPath === '/' ? '/en' : `/en${idPath}`;
const absoluteImage = new URL(image, siteConfig.url).toString();
const localSchema = localBusinessSchema();
const schemas = [organizationSchema(), websiteSchema(), localSchema, ...structuredData].filter(
  Boolean,
) as Array<Record<string, unknown>>;
const faviconLight = brandConfig.assets.markIndigo;
const faviconDark = brandConfig.assets.markWhite;
---

<!doctype html>
<html lang={locale} class="bg-paper text-ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : seoConfig.robots} />
    {
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
      )
    }
    <link rel="canonical" href={canonical} />
    {hasAlternate && <link rel="alternate" hreflang="id" href={new URL(idPath, siteConfig.url)} />}
    {hasAlternate && <link rel="alternate" hreflang="en" href={new URL(enPath, siteConfig.url)} />}
    {
      hasAlternate && (
        <link rel="alternate" hreflang="x-default" href={new URL(idPath, siteConfig.url)} />
      )
    }
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={localeToOpenGraph(locale)} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={`${resolvedTitle} | Digvation`} />
    <meta property="og:locale:alternate" content={locale === 'id' ? 'en_US' : 'id_ID'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="theme-color" content="#FAF9F6" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={faviconLight} media="(prefers-color-scheme: light)" />
    <link rel="icon" href={faviconDark} media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        if (!sessionStorage.getItem('digvation:opening-seen')) {
          document.documentElement.classList.add('digvation-opening');
          sessionStorage.setItem('digvation:opening-seen', 'true');
          window.setTimeout(
            () => document.documentElement.classList.remove('digvation-opening'),
            1400,
          );
        }
      } catch {
        document.documentElement.classList.remove('digvation-opening');
      }
    </script>
    <StructuredData value={schemas} />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <AnalyticsManager locale={locale} />
    <ScrollMotion />
    <OpeningSequence />
    <a
      class="bg-ink text-paper fixed top-4 left-4 z-[100] -translate-y-[180%] rounded-full px-4 py-3 transition-transform focus:translate-y-0"
      href="#main-content">{locale === 'id' ? 'Lewati ke konten' : 'Skip to content'}</a
    >
    <SiteHeader locale={locale} showLanguageSwitch={hasAlternate} />
    <main id="main-content"><slot /></main>
    <SiteFooter locale={locale} />
    <BackToTop locale={locale} />
  </body>
</html>
