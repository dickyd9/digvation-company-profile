---
import ContactPage from '@/features/inquiry/ContactPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/config/site';

const locale = 'id' as Locale;
const description =
  'Ceritakan bagian bisnis yang ingin dibuat lebih mudah. Digvation membantu mengurai kebutuhan dan menentukan langkah digital yang masuk akal bersama Anda.';
---

<BaseLayout locale={locale} title="Ngobrol dengan Digvation" description={description}>
  <ContactPage locale={locale} />
</BaseLayout>
