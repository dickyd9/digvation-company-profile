---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/features/home/HomePage.astro';
import { getFaq } from '@/content/faq';
import { faqSchema } from '@/lib/seo/schema';
const locale = 'id' as const;
---

<BaseLayout
  locale={locale}
  description="Partner transformasi digital untuk membenahi proses, menghubungkan data, dan membangun solusi dari masalah nyata sampai siap digunakan."
  structuredData={[faqSchema(getFaq(locale))]}
>
  <HomePage locale={locale} />
</BaseLayout>
