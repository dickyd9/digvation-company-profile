---
import ContactPage from '@/features/inquiry/ContactPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/config/site';

const locale = 'en' as Locale;
const description =
  'Tell us what should work better in the business. Digvation will review the context before deciding what digital approach makes sense.';
---

<BaseLayout locale={locale} title="Start a Conversation" description={description}>
  <ContactPage locale={locale} />
</BaseLayout>
