---
import ContactPage from '@/features/inquiry/ContactPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/config/site';

const locale = 'en' as Locale;
const description =
  'Tell us what should be easier in the business. Digvation helps clarify the need and choose a sensible digital next step with you.';
---

<BaseLayout locale={locale} title="Start a Conversation" description={description}>
  <ContactPage locale={locale} />
</BaseLayout>
