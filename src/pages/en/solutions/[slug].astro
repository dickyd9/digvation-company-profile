---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SolutionDetailPage from '@/features/solutions/SolutionDetailPage.astro';
import { breadcrumbSchema, serviceSchema } from '@/lib/seo/schema';
import { getLocalizedPath } from '@/config/navigation';
const locale = 'en' as const;
export async function getStaticPaths() {
  const entries = (await getCollection('solutions')).filter((entry) => entry.data.locale === 'en');
  return entries.map((entry) => ({ params: { slug: entry.data.routeSlug }, props: { entry } }));
}
const { entry } = Astro.props;
const path = getLocalizedPath(locale, `/solutions/${entry.data.routeSlug}`);
---

<BaseLayout
  locale={locale}
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  structuredData={[
    serviceSchema({ name: entry.data.title, description: entry.data.summary, path }),
    breadcrumbSchema([
      { name: 'Home', path: getLocalizedPath(locale, '/') },
      { name: 'Solutions', path: getLocalizedPath(locale, '/solutions') },
      { name: entry.data.title, path },
    ]),
  ]}
>
  <SolutionDetailPage locale={locale} slug={entry.data.routeSlug} />
</BaseLayout>
