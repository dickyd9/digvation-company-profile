---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/features/home/HomePage.astro';
import { getFaq } from '@/content/faq';
import { faqSchema } from '@/lib/seo/schema';
const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  description="A digital transformation partner that improves processes, connects data, and builds solutions from a real business problem through to daily use."
  structuredData={[faqSchema(getFaq(locale))]}
>
  <HomePage locale={locale} />
</BaseLayout>
