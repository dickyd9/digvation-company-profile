---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  locale="id"
  title="404 | Digvation"
  description="Halaman tidak ditemukan."
  noindex
  hasAlternate={false}
>
  <section class="bg-paper-warm text-ink min-h-[70svh]">
    <div class="shell flex min-h-[70svh] items-center py-16">
      <div class="max-w-4xl">
        <p class="eyebrow text-indigo-deep">404 / Halaman tidak ditemukan</p>
        <h1
          class="font-display mt-5 max-w-[12ch] text-[clamp(3.25rem,6.5vw,6rem)] leading-[.96] font-semibold tracking-[-.058em]"
        >
          Sepertinya Anda sampai di tempat yang tidak ada.
        </h1>
        <p class="text-dark-muted mt-7 max-w-xl text-base leading-8">
          URL mungkin berubah atau halamannya sudah tidak tersedia. Kembali ke beranda atau mulai
          percakapan dengan Digvation.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button-primary" href="/">Kembali ke Beranda</a><a
            class="button-secondary"
            href="/contact">Mulai Percakapan</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
